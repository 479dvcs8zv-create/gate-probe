@@ -0,0 +1,86 @@
+// v252（擁有者 2026-11-03 07:17／07:20「好」）：股災本益比參考價——只當左側交易（逢低承接）的參考，不影響評級。
+// 參考價＝今年 EPS（網站模型中位數）× 這檔股票在「股災日」的本益比 P20／中位／P80。
+// 股災日＝加權指數收盤 ≤ 前 250 個交易日（含當天）最高收盤 × 85%（與第 38 輪回測相同），由 gate-probe 依證交所 MI_5MINS_HIST 每日匯出。
+// 第 38 輪補充回測（2019～2026）：大盤真的在股災時照參考價承接，1 年後約 1/4 虧損；平常時期跌到參考價以下，1 年後約一半仍虧損；
+// 今年獲利遠高於過去常態（景氣高峰）時參考價會被墊高，容易是陷阱。這些提醒照實列出。
+var MARKET_CRASH_URL = 'https://raw.githubusercontent.com/479dvcs8zv-create/gate-probe/main/exports/market-crash/latest.json';
+var MARKET_CRASH_SCHEMA = 'gate-probe/market-crash/v1';
+var MARKET_CRASH_KEY = 'market-crash-export:v1';
+var MARKET_CRASH_FRESH_MS = 12 * 3600000;
+let marketCrashMemory = null, marketCrashMemoryAt = 0;
+
+function marketCrashDate(value) {
+  const t = Date.parse(`${value}T00:00:00Z`);
+  return /^\d{4}-\d{2}-\d{2}$/.test(String(value || '')) && Number.isFinite(t) && new Date(t).toISOString().slice(0, 10) === value;
+}
+
+function validMarketCrashExport(data, now = Date.now()) {
+  if (!data || data.schema !== MARKET_CRASH_SCHEMA || data.rule?.threshold !== 0.85 || data.rule?.window !== 250) return null;
+  const through = data.through, current = data.current || {};
+  if (!marketCrashDate(through) || Date.parse(`${through}T00:00:00Z`) > now + 86400000) return null;
+  const days = Array.isArray(data.crash_days) ? data.crash_days : null;
+  if (!days || days.some((d, i) => !marketCrashDate(d) || d > through || (i && d <= days[i - 1]))) return null;
+  if (current.date !== through || ![current.close, current.max250, current.drawdown].every(Number.isFinite) || current.close <= 0 || current.max250 < current.close || typeof current.in_crash !== 'boolean') return null;
+  if (current.in_crash !== (current.close <= current.max250 * 0.85)) return null;
+  return { schema: data.schema, generatedAt: data.generated_at || null, through, source: data.source || null, rule: data.rule, crashDays: days,
+    periods: Array.isArray(data.periods) ? data.periods.filter(p => marketCrashDate(p?.from) && marketCrashDate(p?.to)).slice(-40) : [],
+    current: { date: current.date, close: current.close, max250: current.max250, max250Date: marketCrashDate(current.max250_date) ? current.max250_date : null, drawdown: current.drawdown, inCrash: current.in_crash } };
+}
+
+async function readMarketCrashExport(env = {}) {
+  if (marketCrashMemory && Date.now() - marketCrashMemoryAt < 30 * 60000) return marketCrashMemory;
+  const saved = await readRuntimeCache(env, MARKET_CRASH_KEY).catch(() => null);
+  const savedAge = Date.now() - Date.parse(saved?.updatedAt || '');
+  if (saved?.payload && savedAge >= 0 && savedAge < MARKET_CRASH_FRESH_MS) { marketCrashMemory = { ...saved.payload, stale: false }; marketCrashMemoryAt = Date.now(); return marketCrashMemory; }
+  const controller = new AbortController(), timer = setTimeout(() => controller.abort(), 6000);
+  try {
+    const response = await fetch(MARKET_CRASH_URL, { cache: 'no-store', signal: controller.signal });
+    const data = response.ok ? validMarketCrashExport(await response.json()) : null;
+    if (data) {
+      await writeRuntimeCache(env, MARKET_CRASH_KEY, data, 30 * 86400000);
+      marketCrashMemory = { ...data, stale: false }; marketCrashMemoryAt = Date.now();
+      return marketCrashMemory;
+    }
+  } catch {} finally { clearTimeout(timer); }
+  // 讀不到新的就用上次存好的（照實標「舊」）；從來沒讀到就沒有參考價。
+  return saved?.payload ? { ...saved.payload, stale: true } : null;
+}
+
+function crashPeBand(perHistory, crashDays) {
+  if (!Array.isArray(perHistory) || !Array.isArray(crashDays) || !crashDays.length) return null;
+  const days = new Set(crashDays);
+  const rows = perHistory.filter(r => days.has(r?.date) && Number.isFinite(Number(r.PER)) && Number(r.PER) > 0).sort((a, b) => a.date.localeCompare(b.date));
+  if (rows.length < 20) return { status: 'insufficient', observations: rows.length, reason: `這檔股票在股災日的本益比只有 ${rows.length} 天（至少 20 天）` };
+  const values = rows.map(r => Number(r.PER)).sort((a, b) => a - b);
+  const q = p => { const at = (values.length - 1) * p, lo = Math.floor(at), hi = Math.ceil(at); return values[lo] + (values[hi] - values[lo]) * (at - lo); };
+  const years = [...new Set(rows.map(r => r.date.slice(0, 7)))];
+  return { status: 'ok', p20: q(.2), median: q(.5), p80: q(.8), observations: rows.length, from: rows[0].date, through: rows.at(-1).date, months: years };
+}
+
+function buildCrashReference(stock, crash, taiwanMarket = null) {
+  const out = { note: '只作左側交易（逢低承接）參考，不影響評級；參考價＝今年 EPS × 這檔股票在股災時的本益比。', policy: 'reference_only', decidedAt: '2026-11-03' };
+  if (!crash) return { ...out, status: 'unavailable', reason: '讀不到大盤股災日資料（gate-probe 匯出）；不自行推算。' };
+  const year = Number(String(stock?.price?.date || '').slice(0, 4));
+  const forecast = stock?.forecastEps || stock?.valuation?.forecastEps;
+  const eps = forecast?.year === year && ['estimate', 'actual'].includes(forecast?.status) && Number.isFinite(forecast?.median) ? forecast.median : null;
+  const perHistory = stock?.panelInputs?.perHistory;
+  const band = Array.isArray(perHistory) ? crashPeBand(perHistory, crash.crashDays) : null;
+  // 大盤現況：匯出檔當天的回檔幅度；網站有更新的加權指數就用匯出的「前一年最高」重算，不自行補歷史。
+  let market = { date: crash.current.date, close: crash.current.close, max250: crash.current.max250, drawdown: crash.current.drawdown, inCrash: crash.current.inCrash, basis: 'gate-probe 匯出', stale: crash.stale === true };
+  const tw = taiwanMarket?.rows ? taiwanMarket.rows.find(r => r.id === 'TWSE_TAIEX' && ['ok', 'snapshot'].includes(r.status) && Number.isFinite(r.value) && r.value > 0) : null;
+  if (tw && marketCrashDate(tw.date) && tw.date > crash.current.date) {
+    const max250 = Math.max(crash.current.max250, tw.value);
+    market = { date: tw.date, close: tw.value, max250, drawdown: tw.value / max250 - 1, inCrash: tw.value <= max250 * 0.85, basis: '網站最新加權指數 ÷ 匯出的前一年最高', stale: crash.stale === true };
+  }
+  const normal = stock?.financialQuality?.cycleValuation?.eps?.median;
+  const cyclePeak = eps > 0 && normal > 0 && eps / normal > 2 ? { ratio: eps / normal, normal, text: `今年 EPS 是過去常態（${stock.financialQuality.cycleValuation.eps.from}–${stock.financialQuality.cycleValuation.eps.through} 中位數 ${normal.toFixed(2)} 元）的 ${(eps / normal).toFixed(1)} 倍，屬景氣高峰；參考價可能被墊高，「便宜」容易是陷阱。` } : null;
+  const base = { ...out, market, cyclePeak, crashSource: { url: MARKET_CRASH_URL, through: crash.through, generatedAt: crash.generatedAt, rule: '加權指數 ≤ 前 250 個交易日最高收盤 × 85%' } };
+  if (!Array.isArray(perHistory)) return { ...base, status: 'pending', reason: '個股快照還沒有本益比歷史（下次個股更新後出現）。' };
+  if (!band || band.status !== 'ok') return { ...base, status: 'insufficient', band, reason: band?.reason || '近 5 年本益比歷史裡沒有股災日。' };
+  if (!(eps > 0)) return { ...base, status: 'insufficient', band, reason: forecast?.reason || '今年 EPS 估計不足或不是正數，不算參考價。' };
+  const prices = { low: eps * band.p20, mid: eps * band.median, high: eps * band.p80 };
+  const price = Number(stock?.price?.value);
+  const position = !(price > 0) ? null : price <= prices.low ? 'below_low' : price <= prices.mid ? 'low_to_mid' : price <= prices.high ? 'mid_to_high' : 'above_high';
+  return { ...base, status: 'ok', eps, epsYear: year, epsBasis: forecast.basis || null, band, prices, price: price > 0 ? price : null, priceDate: stock?.price?.date || null, position,
+    backtest: '第 38 輪補充回測（2019～2026）：大盤正在股災時跌到低標以下承接，1 年後約 1/4 虧損；平常時期跌到低標以下，1 年後約一半仍虧損。' };
+}
