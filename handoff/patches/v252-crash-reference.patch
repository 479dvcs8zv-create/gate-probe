+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import vm from 'node:vm';
+
+// 擁有者 2026-11-03 07:17／07:20「好」：股災時的本益比 × 今年獲利＝參考價，當左側交易依據；只作參考，不影響評級。
+const source=readFileSync(new URL('../dist/server/index.js',import.meta.url),'utf8');
+const html=readFileSync(new URL('../dist/index.html',import.meta.url),'utf8');
+let serial=0;
+const load=()=>import('data:text/javascript;base64,'+Buffer.from(source+`\nexport {validMarketCrashExport,crashPeBand,buildCrashReference,readMarketCrashExport,evaluateMasterModel,MARKET_CRASH_URL};\n// v252-${serial++}`).toString('base64'));
+const site=await load();
+const today=new Date(Date.now()+8*3600000).toISOString().slice(0,10),year=Number(today.slice(0,4));
+const crashDays=Array.from({length:30},(_,i)=>`2025-04-${String(i+1).padStart(2,'0')}`).filter(d=>!['2025-04-31'].includes(d)).slice(0,25);
+const exportData=(patch={})=>({schema:'gate-probe/market-crash/v1',generated_at:'2026-11-03T07:00:00+00:00',rule:{threshold:0.85,window:250,since:'2015-01-01'},source:'TWSE MI_5MINS_HIST',
+  through:'2026-10-30',crash_days:crashDays,periods:[{from:'2025-04-01',to:'2025-04-25',low_date:'2025-04-09',low_drawdown:-0.2869}],
+  current:{date:'2026-10-30',close:45211.83,max250:49822.55,max250_date:'2026-10-06',drawdown:-0.0925,in_crash:false},...patch});
+const perHistory=[...crashDays.map((date,i)=>({date,PER:8+i*0.5})),{date:'2026-10-30',PER:30},{date:'2025-03-31',PER:25}];
+const stock=(patch={})=>({id:'2404',price:{value:500,date:today},forecastEps:{status:'estimate',year,median:50,basis:'test'},panelInputs:{perHistory},
+  financialQuality:{cycleValuation:{eps:{median:30,from:2019,through:2025}}},...patch});
+
+test('股災日匯出：規則、日期、排序、當天回檔要一致才收',()=>{
+  const ok=site.validMarketCrashExport(exportData(),Date.parse('2026-11-03T00:00:00Z'));
+  assert.equal(ok.crashDays.length,25);assert.equal(ok.current.inCrash,false);assert.equal(ok.current.max250Date,'2026-10-06');
+  const bad=patch=>site.validMarketCrashExport(exportData(patch),Date.parse('2026-11-03T00:00:00Z'));
+  assert.equal(bad({rule:{threshold:0.8,window:250}}),null,'規則不同不收');
+  assert.equal(bad({crash_days:[...crashDays].reverse()}),null,'日期要由舊到新');
+  assert.equal(bad({crash_days:[...crashDays,'2026-11-01']}),null,'不得晚於最後收盤日');
+  assert.equal(bad({current:{...exportData().current,in_crash:true}}),null,'是否股災要和收盤／前一年最高一致');
+  assert.equal(bad({through:'2026-12-31',current:{...exportData().current,date:'2026-12-31'}}),null,'未來日期不收');
+});
+
+test('股災本益比：只用股災日、本益比 > 0；少於 20 天不算',()=>{
+  const band=site.crashPeBand(perHistory,crashDays);
+  assert.equal(band.status,'ok');assert.equal(band.observations,25);assert.equal(band.from,'2025-04-01');
+  assert.equal(band.median,8+12*0.5,'中位數＝第 13 個股災日的本益比');
+  assert.ok(band.p20<band.median&&band.median<band.p80);
+  assert.equal(site.crashPeBand(perHistory.slice(0,10),crashDays).status,'insufficient');
+  assert.equal(site.crashPeBand(perHistory.map(r=>({...r,PER:-1})),crashDays).status,'insufficient','負本益比不算');
+});
+
+test('參考價＝今年 EPS × 股災本益比；標出現價位置、大盤現況、景氣高峰提醒',()=>{
+  const crash=site.validMarketCrashExport(exportData());
+  const ref=site.buildCrashReference(stock(),crash,null);
+  assert.equal(ref.status,'ok');assert.equal(ref.policy,'reference_only');assert.equal(ref.eps,50);
+  assert.equal(ref.prices.mid,50*14);assert.equal(ref.prices.low,50*ref.band.p20);assert.equal(ref.prices.high,50*ref.band.p80);
+  assert.equal(ref.prices.low,520);assert.equal(ref.position,'below_low','現價 500 低於低標 520');
+  assert.equal(site.buildCrashReference(stock({price:{value:600,date:today}}),crash,null).position,'low_to_mid');
+  assert.equal(ref.market.inCrash,false);assert.equal(ref.market.drawdown,-0.0925);
+  assert.equal(ref.cyclePeak,null,'今年 EPS 50 是常態 30 的 1.7 倍，不算高峰');
+  const peak=site.buildCrashReference(stock({forecastEps:{status:'estimate',year,median:90}}),crash,null);
+  assert.ok(peak.cyclePeak.ratio>2);assert.match(peak.cyclePeak.text,/景氣高峰/);
+  // 網站有比匯出更新的加權指數：用匯出的前一年最高重算回檔
+  const newer=site.buildCrashReference(stock(),crash,{rows:[{id:'TWSE_TAIEX',status:'ok',value:41000,date:'2026-11-02'}]});
+  assert.equal(newer.market.date,'2026-11-02');assert.equal(newer.market.inCrash,true);assert.ok(Math.abs(newer.market.drawdown-(41000/49822.55-1))<1e-12);
+});
+
+test('缺資料照實說，不自行補：沒有匯出、還沒有本益比歷史、股災日太少、今年 EPS 不足',()=>{
+  const crash=site.validMarketCrashExport(exportData());
+  assert.equal(site.buildCrashReference(stock(),null).status,'unavailable');
+  assert.equal(site.buildCrashReference(stock({panelInputs:{}}),crash).status,'pending');
+  assert.equal(site.buildCrashReference(stock({panelInputs:{perHistory:perHistory.slice(0,5)}}),crash).status,'insufficient');
+  const noEps=site.buildCrashReference(stock({forecastEps:{status:'insufficient',year,reason:'樣本不足'}}),crash);
+  assert.equal(noEps.status,'insufficient');assert.equal(noEps.prices,undefined);assert.match(noEps.reason,/樣本不足/);
+  assert.equal(site.buildCrashReference(stock({forecastEps:{status:'estimate',year:year-1,median:50}}),crash).status,'insufficient','不是今年的 EPS 不算');
+});
+
+test('讀匯出：成功就存 D1；之後讀不到就用上次存的並標「舊」；從沒讀到就沒有',async()=>{
+  const rows=new Map();
+  const DB={prepare(sql){return {run:async()=>({success:true}),bind:(...args)=>({all:async()=>({results:rows.has(args[0])?[{payload:rows.get(args[0]).payload,updated_at:rows.get(args[0]).updated_at,expires_at:rows.get(args[0]).expires_at}]:[]}),run:async()=>{rows.set(args[0],{payload:args[1],updated_at:args[2],expires_at:args[3]});return {success:true};}})};}};
+  const oldFetch=globalThis.fetch;
+  try{
+    globalThis.fetch=async url=>{assert.equal(String(url),site.MARKET_CRASH_URL);return Response.json(exportData());};
+    const first=await (await load()).readMarketCrashExport({DB});
+    assert.equal(first.stale,false);assert.equal(first.through,'2026-10-30');assert.ok(rows.has('market-crash-export:v1'));
+    const entry=rows.get('market-crash-export:v1');entry.updated_at='2026-01-01T00:00:00Z';
+    globalThis.fetch=async()=>new Response('nope',{status:503});
+    const second=await (await load()).readMarketCrashExport({DB});
+    assert.equal(second.stale,true);assert.equal(second.through,'2026-10-30');
+    globalThis.fetch=async()=>{throw Error('offline');};
+    assert.equal(await (await load()).readMarketCrashExport({DB:{prepare(){return {run:async()=>({success:true}),bind:()=>({all:async()=>({results:[]}),run:async()=>({success:true})})};}}}),null);
+  }finally{globalThis.fetch=oldFetch;}
+});
+
+test('個股模型：附上參考價，但評級完全不受影響',()=>{
