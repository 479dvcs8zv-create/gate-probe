+            carried.append(note)
+        else:
+            carry_note = note
     errors = collector_errors(src, exits or {}) + errors
     manifest = {
         "schema_version": 1,
@@ -120,6 +179,10 @@ def build(src, out, window=None, keep_sessions=5, now=None, collector=None, exit
