+async function call(db){
+  const {default:worker}=await load(`v240-dollar-${Math.random()}`);
+  const previous=globalThis.fetch;globalThis.fetch=async()=>new Response('offline',{status:503});
+  try{const r=await worker.fetch(new Request('https://site.test/api/dollar-index'),{DB:db},{waitUntil(){}});return {status:r.status,body:await r.json()};}
