+  assert.equal(expanded.usable,12,'摘要記的是落地後的 12/12，和巡檢後直接讀回一致');assert.equal(expanded.status,'ok');
+  assert.equal(expanded.finalizeWaits,2);assert.equal(expanded.summaryScope,'final_readback');
+  assert.equal(globalThis.__v245calls.expandedMacro,4,'模組步驟 1 次＋結束讀回 3 次');
+  const us=result.modules.usIndices;
+  assert.equal(us.finalizeWaits,6,'最多等 6 次');assert.equal(us.refreshState,'background_refreshing','等不到就照實記錄背景更新未落地');assert.equal(us.usable,3);
+  assert.equal(globalThis.__v245calls.usIndices,1+1+6,'模組步驟 1 次＋結束讀回 7 次（6 次等待＋最後一次）');
+  assert.equal(result.modules.macro.finalizeWaits,undefined,'已是最新的模組不等待');
+});
+
+function memoryDb(){
+  const rows=new Map();
+  return {rows,prepare(sql){return {run:async()=>({success:true}),bind:(...args)=>({run:async()=>{if(sql.startsWith('INSERT INTO site_runtime_cache'))rows.set(args[0],{payload:args[1],updated_at:args[2],expires_at:args[3]});return {success:true};},all:async()=>({results:rows.has(args[0])?[rows.get(args[0])]:[]}),first:async()=>null})};}};
+}
+test('結束讀回時在請求內等背景更新（最多 4.5 秒）：更新落地就直接回新快照；一般網頁請求不等',async()=>{
+  const previous=globalThis.fetch;globalThis.fetch=async()=>new Response('unavailable in test',{status:503});
+  const seed=db=>{const old=Date.now()-40*60000;for(const [key,payload] of [['macro-expanded:v1',{checkedAt:new Date(old).toISOString(),rows:[{id:'TW_NDC_SIGNAL',status:'ok',value:31,date:'2026-08-01'}],derived:[]}],['us-indices:v1',{checkedAt:new Date(old).toISOString(),rows:[{id:'SP500',status:'ok',value:6900,date:'2026-10-27'}]}]])db.rows.set(key,{payload:JSON.stringify(payload),updated_at:new Date(old).toISOString(),expires_at:new Date(old+15*60000).toISOString()});};
+  try{
+    for(const name of ['expandedMacroResponse','usIndicesResponse']){
+      const plain=await load(`export {${name}};`),dbA=memoryDb();seed(dbA);
+      const a=await (await plain[name]({DB:dbA},{waitUntil(){}})).json();
+      assert.equal(a.refreshing,true,`${name}：一般請求先回上次快照並在背景更新`);
+      const waiting=await load(`export {${name}};`),dbB=memoryDb();seed(dbB);
+      const startedAt=Date.now(),b=await (await waiting[name]({DB:dbB},{waitUntil(){}},{awaitRefreshMs:4500})).json();
+      assert.notEqual(b.refreshing,true,`${name}：等到更新落地，回新快照`);assert.ok(Date.parse(b.checkedAt)>=startedAt,'新快照的取得時間在這次請求之後');
+      assert.ok(Date.now()-startedAt<4500);
+    }
+  }finally{globalThis.fetch=previous;}
+});
