+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+
+// v259（擁有者 2026-11-13「都處理吧」）：晚上櫃買公告抓不到時，24 小時內成功收過的那份照原擷取時間沿用（標 recent）；超過 24 小時照舊記錯誤。
+const source=readFileSync(new URL('../dist/server/index.js',import.meta.url),'utf8');
+let serial=0;
+const load=()=>import('data:text/javascript;base64,'+Buffer.from(source+`\nexport {fetchSourceFeed};\n// v259-${serial++}`).toString('base64'));
+const db=(rows)=>({prepare(sql){const exec=a=>({async all(){if(/^SELECT/.test(sql)&&rows.has(a[0]))return {results:[rows.get(a[0])]};return {results:[]};},async run(){if(/^INSERT INTO site_runtime_cache/.test(sql))rows.set(a[0],{payload:a[1],updated_at:a[2],expires_at:a[3]});return {success:true,meta:{changes:1}};}});return {...exec([]),bind:(...a)=>exec(a)};}});
+const saved=(hoursAgo)=>{const fetchedAt=new Date(Date.now()-hoursAgo*3600000).toISOString();return new Map([['source-feed:v1:tpex',{payload:JSON.stringify({key:'tpex',source:'https://www.tpex.org.tw/openapi/v1/mopsfin_t187ap04_O',fetchedAt,records:[{id:'a',symbol:'8299'}],status:'ok',error:null,content_version:2,captureMode:'external_collector'}),updated_at:fetchedAt,expires_at:new Date(Date.parse(fetchedAt)+6*3600000).toISOString()}]]);};
+
+test('抓不到時：13 小時前成功收的那份照原時間沿用、標 stale＋recent，錯誤照記',async()=>{
+  const old=globalThis.fetch;globalThis.fetch=async()=>{throw Error('The operation was aborted due to timeout');};
+  try{
+    const site=await load(),feed=await site.fetchSourceFeed('tpex',{DB:db(saved(13))});
+    assert.equal(feed.status,'stale');assert.equal(feed.recent,true);assert.match(feed.error,/timeout/);
+    assert.equal(feed.records.length,1);assert.ok(Date.now()-Date.parse(feed.fetchedAt)>12*3600000,'擷取時間保留原值');
+  }finally{globalThis.fetch=old;}
+});
+
+test('超過 24 小時就照舊記錯誤；從沒收過也照舊',async()=>{
+  const old=globalThis.fetch;globalThis.fetch=async()=>new Response('busy',{status:503});
+  try{
+    const stale=await (await load()).fetchSourceFeed('tpex',{DB:db(saved(30))});
+    assert.equal(stale.status,'stale');assert.ok(stale.error);assert.equal(stale.recent,undefined,'超過 24 小時不算 recent');
+    const none=await (await load()).fetchSourceFeed('tpex',{DB:db(new Map())});
+    assert.equal(none.status,'source_error');assert.ok(none.error);
+  }finally{globalThis.fetch=old;}
+});
+
+test('巡檢覆蓋列：只有 recent 的錯誤算正常但有限；其他錯誤照算來源錯誤',()=>{
+  const src=readFileSync(new URL('../worker/macro.js',import.meta.url),'utf8');
+  assert.match(src,/run\.research\.every\(row=>row\.status!=='source_error'&&!\(row\.errors\|\|\[\]\)\.some\(e=>!\(e&&e\.recent\)\)\)\?'automatic_limited':'source_error'/);
+});
