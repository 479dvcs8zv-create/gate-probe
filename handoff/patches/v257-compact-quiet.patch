index 0000000..26ec76b
--- /dev/null
+++ b/tests/v257-compact-quiet.test.mjs
@@ -0,0 +1,17 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+
+// v257（擁有者 2026-11-12 08:08）：精簡巡檢的 problems 不再把正常狀態（全市場掃描 history_ready、產業來源 automatic_limited）列成異常。
+const source=readFileSync(new URL('../dist/server/index.js',import.meta.url),'utf8');
+const site=await import('data:text/javascript;base64,'+Buffer.from(source+'\nexport {compactSiteRefresh};').toString('base64'));
+const run=coverage=>({runId:'r1',status:'partial',startedAt:'2026-11-12T00:00:00Z',completedAt:'2026-11-12T00:10:00Z',checkpoint:{version:1,stage:'done',index:0},coverage,gateAudits:[],stockBatch:[]});
+
+test('正常狀態不列進 problems；真的有問題的照列',()=>{
+  const ok=site.compactSiteRefresh(run([{id:'macro',status:'automatic'},{id:'sourceResearch',status:'automatic_limited'},{id:'fullMarketScanner',status:'history_ready'},{id:'guidance',status:'not_used'}]));
+  assert.deepEqual(ok.problems,[]);
+  const bad=site.compactSiteRefresh(run([{id:'sourceResearch',status:'source_error'},{id:'fullMarketScanner',status:'source_error'},{id:'officialImport',status:'source_error'}]));
+  assert.deepEqual(bad.problems,['sourceResearch:source_error','fullMarketScanner:source_error','officialImport:source_error']);
+  const building=site.compactSiteRefresh(run([{id:'fullMarketScanner',status:'collecting_history'}]));
+  assert.deepEqual(building.problems,['fullMarketScanner:collecting_history'],'歷史還在累積照列，提醒還沒完整');
+});
