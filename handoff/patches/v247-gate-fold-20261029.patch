diff --git a/tests/v247-gate-fold.test.mjs b/tests/v247-gate-fold.test.mjs
new file mode 100644
index 0000000..5ca5615
--- /dev/null
+++ b/tests/v247-gate-fold.test.mjs
@@ -0,0 +1,20 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {threeQuestions} from '../worker/panel-calculations.mjs';
+
+// 擁有者 2026-10-29 14:41「收起來好了」：每個數字只在它主要的卡片完整出現一次。
+// 三問的技術題不再重抄收盤價（收盤價在追蹤清單卡），只寫收盤在 60 日線上或下；60 日線本身只在這裡出現，保留數值。
+function stockWith(closes){
+  const start=Date.UTC(2026,5,1),rows=closes.map((close,i)=>({date:new Date(start+i*86400000).toISOString().slice(0,10),close}));
+  return {id:'9999',price:{date:rows.at(-1).date,value:closes.at(-1)},priceHistory:rows,technical:{historyState:'ok'}};
+}
+test('三問技術題：寫收盤在 60 日線上／下與 60 日線數值，不重抄收盤價；過／不過判斷不變',()=>{
+  const falling=Array.from({length:80},(_,i)=>200-i*0.9);   // 一路下跌：連續收在 60 日線下且 60 日線下彎 → 不過
+  const tq=threeQuestions(stockWith(falling)).questions.technical;
+  assert.equal(tq.result,'fail');assert.ok(tq.daysBelowMa60>5);
+  assert.match(tq.basis,/^收盤在60日線下；60日線 \d+\.\d{2}（前一日 \d+\.\d{2}，下彎）；連續 \d+\+? 個交易日收在60日線下｜\d{4}-\d{2}-\d{2}$/);
+  assert.ok(!tq.basis.includes(falling.at(-1).toFixed(2)),'收盤價不在這裡重複');
+  const rising=Array.from({length:80},(_,i)=>100+i*0.9);
+  const up=threeQuestions(stockWith(rising)).questions.technical;
+  assert.equal(up.result,'pass');assert.match(up.basis,/^收盤在60日線上；60日線 .*未下彎/);
+});
