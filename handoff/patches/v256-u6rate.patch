index 0000000..f9c33f0
--- /dev/null
+++ b/tests/v256-u6rate.test.mjs
@@ -0,0 +1,38 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+
+// v256（擁有者 2026-11-10 21:01「好」）：擴展總經加 U-6 廣義失業率（中繼 U6RATE）；只顯示，不進任何評分或門檻。
+const source=readFileSync(new URL('../dist/server/index.js',import.meta.url),'utf8');
+let serial=0;
+const load=()=>import('data:text/javascript;base64,'+Buffer.from(source+`\nexport {SERIES,EXPANDED_SERIES_IDS,loadExpandedSeries,buildExpandedMacroSnapshot,backendMarketScoreModels,RELAY_URL};\n// v256-${serial++}`).toString('base64'));
+// 日期跟著現在走（上個月與前兩個月的 1 號），測試不會因為時間過去而失效。
+const month=back=>{const d=new Date();d.setUTCDate(1);d.setUTCMonth(d.getUTCMonth()-back);return d.toISOString().slice(0,10);};
+const relay=series=>({schema_version:1,generated_at:new Date().toISOString(),series});
+const u6={status:'ok',fetched_at:new Date().toISOString(),max_age_days:85,provider:'FRED 官方公開 CSV｜U6RATE',source:'https://fred.stlouisfed.org/graph/fredgraph.csv?id=U6RATE',
+  history:[{date:month(3),value:7.7},{date:month(2),value:7.6},{date:month(1),value:7.9}]};
+async function withFetch(handler,fn){const old=globalThis.fetch;globalThis.fetch=handler;try{return await fn();}finally{globalThis.fetch=old;}}
+
+test('目錄：U-6 在擴展總經、需求／就業、單位 %，不算進核心 55 項',async()=>{
+  const site=await load();
+  assert.deepEqual(site.SERIES.U6RATE,['美國 U-6 廣義失業率','需求／就業','%',85]);
+  assert.ok(site.EXPANDED_SERIES_IDS.has('U6RATE'));
+});
+
+test('讀中繼：有 U6RATE 就照原值顯示；中繼沒有、FRED 也抓不到就是缺值，不補',async()=>{
+  const site=await load();
+  const row=await withFetch(async url=>String(url)===site.RELAY_URL?Response.json(relay({U6RATE:u6})):new Response('no',{status:503}),()=>site.loadExpandedSeries('U6RATE',{}));
+  assert.equal(row.status,'ok');assert.equal(row.value,7.9);assert.equal(row.date,month(1));assert.equal(row.unit,'%');assert.match(row.provider,/U6RATE/);
+  const fresh=await load();
+  const none=await withFetch(async url=>String(url)===fresh.RELAY_URL?Response.json(relay({})):new Response('no',{status:503}),()=>fresh.loadExpandedSeries('U6RATE',{}));
+  assert.notEqual(none.status,'ok');assert.equal(none.value??null,null,'沒有來源就不給數字');
+});
+
+test('擴展總經快照多一列 U-6；總經分數完全不受影響',async()=>{
+  const site=await load();
+  const snap=await withFetch(async url=>String(url)===site.RELAY_URL?Response.json(relay({U6RATE:u6})):new Response('no',{status:503}),()=>site.buildExpandedMacroSnapshot({}));
+  const row=snap.rows.find(r=>r.id==='U6RATE');
+  assert.ok(row);assert.equal(row.value,7.9);assert.equal(snap.rows.length,13);
+  const withU6=site.backendMarketScoreModels({rows:[],derived:[]},{rows:[row],derived:[]}),without=site.backendMarketScoreModels({rows:[],derived:[]},{rows:[],derived:[]});
+  assert.deepEqual(withU6,without,'U-6 不進任何評分');
+});
