+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { pathToFileURL } from 'node:url';
+import {refreshLeaseStatement} from './helpers/refresh-lease.mjs';
+
+const workerUrl = pathToFileURL(new URL('../dist/server/index.js', import.meta.url).pathname).href;
+const { default: worker } = await import(workerUrl);
+
+class MemoryD1 {
+  rows = new Map();
+  prepare(sql) {
+    const lease=refreshLeaseStatement(this,sql);if(lease)return lease;
+    return {
+      bind: (...args) => ({
+        run: async () => {
+          if (sql.includes('INSERT INTO site_runtime_cache')) {
+            if (this.failCacheWrites > 0) { this.failCacheWrites--; return { success: false }; }
+            if (String(args[0]).startsWith('site-auto-refresh-run:v1:') && this.failRunWriteAfter != null) {
+              if (this.failRunWriteAfter === 0) { this.failRunWriteAfter = null; return { success: false }; }
+              this.failRunWriteAfter--;
+            }
+            this.rows.set(args[0], { payload: args[1], updated_at: args[2], expires_at: args[3] });
+          }
+          return { success: true };
+        },
+        all: async () => {
+          if (sql.includes('SELECT payload, updated_at, expires_at FROM site_runtime_cache')) {
+            const row = this.rows.get(args[0]);
+            return { results: row ? [row] : [] };
+          }
+          if (sql.includes('WHERE cache_key LIKE')) {
+            return { results: [...this.rows.entries()].filter(([key]) => key.startsWith(String(args[0]).replace('%', ''))).slice(-Number(args[1])).map(([cache_key, row]) => ({ cache_key, ...row })) };
+          }
+          return { results: [] };
+        },
+      }),
+      run: async () => ({ success: true }),
+    };
+  }
+}
+
+// v260（擁有者 2026-11-25「沒額度 為何用那麼快？」）：?batch=1 時一次輪詢連做幾步；不帶參數時行為不變。
+const db = new MemoryD1();
+const originalFetch = globalThis.fetch;
+const universeRows = [
+  ...Array.from({ length: 300 }, (_, i) => ({ stock_id: String(1000 + i), stock_name: `上市測試${i}`, type: 'twse', industry_category: i % 2 ? '半導體業' : '電子零組件業' })),
+  ...Array.from({ length: 300 }, (_, i) => ({ stock_id: String(2000 + i), stock_name: `上櫃測試${i}`, type: 'tpex', industry_category: i % 2 ? '半導體業' : '電子零組件業' })),
+];
+const twseRows = universeRows.filter(x => x.type === 'twse').map((x, i) => ({ Date: '1151007', Code: x.stock_id, Name: x.stock_name, ClosingPrice: '100.00', Change: i % 2 ? '+1.00' : '-1.00', TradeVolume: '10000', TradeValue: '1000000' }));
+const tpexRows = universeRows.filter(x => x.type === 'tpex').map((x, i) => ({ Date: '1151007', SecuritiesCompanyCode: x.stock_id, CompanyName: x.stock_name, Close: '100.00', Change: i % 2 ? '+1.00' : '-1.00', TradingShares: '10000', TransactionAmount: '1000000' }));
+globalThis.fetch = async (input, init) => {
+  const url = String(input);
+  if (url.includes('dataset=TaiwanStockInfo')) return Response.json({ status: 200, data: universeRows });
+  if (url.includes('/exchangeReport/STOCK_DAY_ALL')) return Response.json(twseRows);
+  if (url.includes('/tpex_mainboard_daily_close_quotes')) return Response.json(tpexRows);
+  return new Response('No upstream test fixture configured', {status:503});
+};
+const now = new Date().toISOString(), future = new Date(Date.now() + 86400000).toISOString(), currentDate=now.slice(0,10);
+const seed = (key, payload, updatedAt = now, expiresAt = future) => db.rows.set(key, {
+  payload: JSON.stringify(payload), updated_at: updatedAt, expires_at: expiresAt,
+});
+seed('macro:v1', { checkedAt: now, rows: [{ id: 'SOFR', name: 'SOFR', value: 4.1, date: '2026-10-06', status: 'ok', source: 'https://fred.stlouisfed.org/series/SOFR' }], coverage: { usable: 1, total: 1 }, light: '灰燈', fiveLines: ['風險預算不增加。'] });
+seed('macro-expanded:v1', { checkedAt: now, rows: [{ id: 'UNRATE', name: '失業率', value: 4.1, date: '2026-09-01', status: 'ok' }], derived: [] });
+seed('macro-market:v7', { checkedAt: now, rows: [
+  { id: 'XAU', name: '金價', value: 4100, unit: 'USD/oz', date: currentDate, status: 'ok', source: 'https://api.gold-api.com/price/XAU' },
+  { id: 'XAG', name: '銀價', value: 60, unit: 'USD/oz', date: currentDate, status: 'ok', source: 'https://api.gold-api.com/price/XAG' },
+  { id: 'XAU_XAG', name: '金銀比', value: 68.33, unit: '倍', date: currentDate, status: 'ok', historyObservations: 1 },
+ ] });
+seed('us-indices:v1', { checkedAt: now, rows: [{ id: 'SP500', value: 7000, date: '2026-10-06', status: 'ok' }] });
+seed('macro-news:v1', { checkedAt: now, feeds: [
+  { topic: '政策', source: 'Fed', items: [{ title: '公告', date: '2026-10-07', url: 'https://www.federalreserve.gov/news' }] },
+  { topic: '能源', source: 'EIA', items: [{ title: '公告', date: '2026-10-07', url: 'https://www.eia.gov/news' }] },
+  { topic: '就業', source: 'BLS', items: [{ title: '公告', date: '2026-10-07', url: 'https://www.bls.gov/news' }] },
+ ] });
+for (const [id, name] of [['8299', '群聯'], ['5289', '宜鼎'], ['2404', '漢唐'], ['5009', '榮剛']]) {
+  seed(`stock:v5:${id}`, { id, checkedAt: now, price: { value: 100, date: '2026-10-06' }, revenue: { month: '2026-09' }, datasetStatus: {}, exRightsEvents: [] });
+}
+
+const env = { DB: db };
+let background;
+const ctx = { waitUntil(promise) { background = promise; } };
+const call=(path,init)=>worker.fetch(new Request('https://site.test'+path,init),env,ctx);
+async function settle(){if(background){await background;background=null;}}
+
+
+async function patrol(query,{onPoll}={}){
+  const started=await (await call(`/api/automation/refresh-all?compact=1`,{method:'POST'})).json();
+  let last,polls=0;const batches=[];
+  for(let i=0;i<120&&!last?.completedAt;i++){
+    const response=await call(`/api/automation/status?compact=1${query}`);const text=await response.text();
+    assert.equal(response.status,200,text);last=JSON.parse(text);polls++;await settle();
+    assert.equal(last.runId,started.runId);
+    if(last.batch)batches.push(last.batch);
+    if(onPoll)await onPoll(last,polls);
+  }
+  return {started,last,polls,batches};
+}
+
+test('batch=1：同一個 run 跑完，查詢次數至少少一半，結果和逐步一樣',async()=>{
+  const single=await patrol('');
+  assert.ok(single.last.completedAt);assert.equal(single.batches.length,0,'不帶 batch：回應沒有 batch 欄（行為不變）');
+  const batched=await patrol('&batch=1');
+  assert.ok(batched.last.completedAt,'同一個 run 跑完');
+  assert.ok(batched.polls*2<=single.polls,`查詢次數 ${batched.polls} 次，逐步 ${single.polls} 次`);
+  assert.equal(batched.last.checkpoint.stage,'done');
+  assert.equal(batched.last.summary.gateAuditCount,4);assert.equal(batched.last.summary.gateAuditTotal,4);
+  assert.deepEqual(batched.last.summary.stockBatch,['8299','5289','2404','5009']);
+  assert.deepEqual(batched.last.problems,single.last.problems,'覆蓋列問題和逐步相同');
+  for(const b of batched.batches){
+    assert.ok(b.steps>=1&&b.steps<=8,`每次 1～8 步（${b.steps}）`);
+    assert.ok(['completed','waiting','max_steps','time_budget','lease_not_renewed'].includes(b.stop),b.stop);
+  }
+  assert.equal(batched.batches.at(-1).stop,'completed');
+  const history=(await (await call('/api/automation/history')).json()).runs[0];
+  const {gateAuditTotal,stockBatch,...summary}=batched.last.summary;
+  assert.deepEqual(summary,history,'摘要和 history 一致');
+});
+
+test('batch=1：租約續不到就只做一步，照樣能接續跑完',async()=>{
+  db.refuseLeaseRenewal=true;
+  try{
+    const run=await patrol('&batch=1');
+    assert.ok(run.last.completedAt);
+    assert.ok(run.batches.every(b=>b.steps===1),'每次只做一步');
+    assert.ok(run.batches.slice(0,-1).every(b=>['lease_not_renewed','waiting'].includes(b.stop)));
+  }finally{db.refuseLeaseRenewal=false;}
+});
+
+test('batch=1：第二步以後寫入失敗，回上一個已保存的狀態（HTTP 200），下一次輪詢從那裡重試',async()=>{
+  let failed=false;
+  const run=await patrol('&batch=1',{onPoll:async(last,polls)=>{
+    if(polls===1){db.failRunWriteAfter=1;failed=true;return;}   // 下一次輪詢：第一步的巡檢紀錄寫入成功、第二步失敗
+  }});
+  assert.ok(failed&&run.last.completedAt,'失敗之後照樣跑完');
+  const errored=run.batches.find(b=>String(b.stop).startsWith('error:'));
+  assert.ok(errored,'有一次在第二步以後停下並照實寫原因');
+  assert.match(errored.stop,/storage_error/);
+  assert.ok(errored.steps>=1);
+});
+
+test('batch=1：第一步就失敗時照舊回 503，不假裝成功',async()=>{
+  await call('/api/automation/refresh-all?compact=1',{method:'POST'});
+  db.failCacheWrites=1;
+  const response=await call('/api/automation/status?compact=1&batch=1');
+  assert.equal(response.status,503);
+  const body=await response.json();assert.equal(body.status,'storage_error');assert.equal(body.persisted,false);
+  db.failCacheWrites=0;
+  for(let i=0;i<120;i++){const r=await (await call('/api/automation/status?compact=1&batch=1')).json();await settle();if(r.completedAt)break;}
+});
+
+test('globalThis.fetch 還原',()=>{globalThis.fetch=originalFetch;});
