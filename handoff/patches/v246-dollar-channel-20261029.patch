+  assert.match(text,/不含當天（同 StockCharts Price Channels 預設）/);assert.match(text,/只顯示、不計分/);
+});
+
+test('通道圖：紅線＝前20日最高、綠線＝前20日最低、中線、淡色底；突破日標記與零軸 > 0／< −100 完全一致；兩張圖日期對齊',async()=>{
+  const body=await dollarBody(),host=await render(body),cls=c=>host.findAll(n=>n.attributes?.class===c);
+  for(const c of ['db-fill','db-high','db-low','db-mid','db-line','db-pending'])assert.equal(cls(c).length,1,c);
+  const shown=body.history.filter(r=>[r.axis,r.priorHigh,r.priorLow].every(Number.isFinite));
+  const up=shown.filter(r=>r.usable&&r.axis>0),down=shown.filter(r=>r.usable&&r.axis<-100);
+  assert.ok(up.length>0&&down.length>0,'這段期間兩種都有');
+  for(const r of up)assert.ok(r.value>r.priorHigh,'突破前高＝藍線高於紅線');for(const r of down)assert.ok(r.value<r.priorLow,'跌破前低＝藍線低於綠線');
+  assert.equal(cls('dm-up').length,up.length*2,'上下兩張圖各標一次');assert.equal(cls('dm-down').length,down.length*2);
+  const dots=cls('dc-dot').map(n=>n.attributes.cx);assert.equal(dots.length,2);assert.equal(dots[0],dots[1],'最新已採用那一點在兩張圖同一個水平位置');
+  const ticks=host.findAll(n=>n.attributes?.class==='dc-tick'&&/^\d{2}-\d{2}$/.test(n.textContent)).map(n=>`${n.textContent}@${n.attributes.x}`);
+  assert.equal(ticks.length,4);assert.equal(ticks[0],ticks[2]);assert.equal(ticks[1],ticks[3],'起訖日期在兩張圖同一位置');
+  const legend=host.findAll(n=>n.className==='dollar-legend')[0].textContent;
+  assert.match(legend,/前20日最高（＝下圖 0 軸）/);assert.match(legend,/前20日最低（＝下圖 −100）/);assert.match(legend,/▲ 突破前高/);assert.match(legend,/▼ 跌破前低/);
+  // 通道圖游標：指數、0 軸、−100、距最高
+  const hit=host.findAll(n=>n.attributes?.['aria-label']==='左右鍵逐筆查看指數與前20日高低')[0];
+  hit.listeners.focus();
+  const tip=host.findAll(n=>n.className==='dollar-tip')[0];
+  assert.equal(tip.hidden,false);assert.match(tip.textContent,/指數 114\.44 .*｜0 軸 115\.75｜−100 113\.49｜距最高 −1\.13%｜已採用/);
+});
+
+test('數字表：每一筆的前20日最高、最低、高低差、距最高都列出來；表格可橫向捲動（手機不撐破版面）',async()=>{
+  const body=await dollarBody(),host=await render(body);
