+async function dollarBody(){
+  const {default:worker}=await import('data:text/javascript;base64,'+Buffer.from(source+`\n// v246-${Math.random()}`).toString('base64'));
+  const previous=globalThis.fetch;globalThis.fetch=async()=>new Response('offline',{status:503});
