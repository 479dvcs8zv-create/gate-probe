diff --git a/tests/v238-dollar.test.mjs b/tests/v238-dollar.test.mjs
new file mode 100644
index 0000000..0ca9971
--- /dev/null
+++ b/tests/v238-dollar.test.mjs
@@ -0,0 +1,40 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {dollarAxis} from '../worker/panel-calculations.mjs';
+
+// 擁有者 2026-10-27 04:49：「美元圖片也沒有出來」。美元零軸原本只吃外部匯入（36 小時內），匯入沒跑就消失。
+// 改為匯入過期時讀中繼（GitHub 排程抓 FRED DTWEXAFEGS 官方 CSV、40 筆）。
+const source=readFileSync(new URL('../dist/server/index.js',import.meta.url),'utf8');
+const api=await import('data:text/javascript;base64,'+Buffer.from(source+'\n// v238-dollar\nexport {attachPanelSources};').toString('base64'));
+function fakeDb(){const rows=new Map();return {prepare(sql){let args=[];const stmt={bind(...a){args=a;return stmt;},async run(){if(/^INSERT INTO site_runtime_cache/.test(sql))rows.set(args[0],{payload:args[1],updated_at:args[2],expires_at:args[3]});return {success:true,meta:{changes:1}};},async all(){const r=/FROM site_runtime_cache/.test(sql)?rows.get(args[0]):null;return {results:r?[r]:[]};}};return stmt;},rows};}
+
+test('外部匯入沒有或過期 → 美元零軸改讀中繼的 FRED DTWEXAFEGS，圖表照常出現並註明代抓',async()=>{
+  const day=n=>new Date(Date.now()-n*86400000).toISOString().slice(0,10);
+  const history=Array.from({length:40},(_,i)=>({date:day(42-i),value:120+Math.sin(i/3)*2+i*0.05}));  // 最新觀測 3 天前（H.10 每週一更新）
+  const relay={schema_version:1,generated_at:new Date().toISOString(),series:{DTWEXAFEGS:{history,date:history.at(-1).date,value:history.at(-1).value,source:'https://fred.stlouisfed.org/graph/fredgraph.csv?id=DTWEXAFEGS',provider:'FRED 官方公開 CSV｜DTWEXAFEGS',status:'ok',fetched_at:new Date().toISOString(),max_age_days:12}}};
+  const previous=globalThis.fetch;
+  globalThis.fetch=async url=>String(url).includes('keyless_snapshot.json')?new Response(JSON.stringify(relay),{status:200}):new Response('not found',{status:404});
+  try{
+    const stock={id:'8299',price:{date:day(0),value:1880},priceHistory:[],panelInputs:{}};
+    const out=await api.attachPanelSources(stock,{DB:fakeDb()});
+    const input=out.panelInputs.dollarIndex;
+    assert.equal(input?.capturePath,'github_relay');assert.equal(input.history.length,40);
+    const axis=dollarAxis(input,{asOf:day(0)});
+    assert.equal(axis.status,'ok',axis.reason);assert.equal(axis.capturePath,'github_relay');
+  }finally{globalThis.fetch=previous;}
+});
+
+test('中繼也過期（例如 FRED 很久沒更新）就不用，維持「待補」',async()=>{
+  const day=n=>new Date(Date.now()-n*86400000).toISOString().slice(0,10);
+  const history=Array.from({length:40},(_,i)=>({date:day(90-i),value:120+i*0.1}));
+  const relay={schema_version:1,generated_at:new Date().toISOString(),series:{DTWEXAFEGS:{history,source:'https://fred.stlouisfed.org/graph/fredgraph.csv?id=DTWEXAFEGS',status:'ok',fetched_at:new Date().toISOString(),max_age_days:12}}};
+  const previous=globalThis.fetch;
+  globalThis.fetch=async url=>String(url).includes('keyless_snapshot.json')?new Response(JSON.stringify(relay),{status:200}):new Response('not found',{status:404});
+  try{
+    // 中繼快取 15 分鐘是模組層級：用另一個模組實例，避免讀到上一個測試的快取。
+    const api2=await import('data:text/javascript;base64,'+Buffer.from(source+'\n// v238-dollar-stale\nexport {attachPanelSources};').toString('base64'));
+    const out=await api2.attachPanelSources({id:'2330',price:{date:day(0),value:1000},priceHistory:[],panelInputs:{}},{DB:fakeDb()});
+    assert.equal(out.panelInputs.dollarIndex,null);
+  }finally{globalThis.fetch=previous;}
+});
