+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+// 獨立模組實例：避免和其他測試共用「進行中任務」快取。
+const source=readFileSync(new URL('../dist/server/index.js',import.meta.url),'utf8');
+const api=await import('data:text/javascript;base64,'+Buffer.from(source+'\n// v236 keep-alive test instance\nexport {attachPanelSources};').toString('base64'));
+function fakeDb(){const rows=new Map();return {prepare(sql){let args=[];const stmt={bind(...a){args=a;return stmt;},async run(){if(/^INSERT INTO site_runtime_cache/.test(sql))rows.set(args[0],{payload:args[1],updated_at:args[2],expires_at:args[3]});return {success:true,meta:{changes:1}};},async all(){const r=/FROM site_runtime_cache/.test(sql)?rows.get(args[0]):null;return {results:r?[r]:[]};}};return stmt;},rows};}
+// v236 讀回② 仍「讀取中」：背景任務在回應送出後被取消、櫃買對無 User-Agent 的請求變慢或中斷。
+test('v236 修補：沒趕上的來源交給 waitUntil 跑完並寫入快取；請求帶瀏覽器式 User-Agent',async()=>{
+  const previous=globalThis.fetch,uaSeen=[];
+  const rows=[{Date:'20261025',IssuerCode:'8299',IssuerName:'群聯',BondCode:'82993',ShortName:'群聯三',IssueDate:'20260206',MaturityDate:'20310206',IssueAmount:'6000000000',OutstandingAmount:'6000000000',Currency:'1',PutOptionDate:'20290206',PutOptionPrice:'100.0000','Conversion/ExchangePriceAtIssuance':'2488.0000','Conversion/ExchangePeriodStartDate':'20260507','Conversion/ExchangePeriodEndDate':'20310206'}];
+  globalThis.fetch=async(url,init)=>{
+    const u=String(url);
+    if(/tpex\.org\.tw\/openapi\/v1\/bond_ISSBD[56]_data/.test(u)){uaSeen.push(new Headers(init?.headers).get('user-agent'));await new Promise(r=>setTimeout(r,8500));return new Response(JSON.stringify(u.includes('ISSBD5')?rows:[]),{status:200});}
+    return new Response('not found',{status:404});
+  };
+  try{
+    const db=fakeDb(),kept=[],stock={id:'8299',price:{date:'2026-10-22',value:1880},priceHistory:[],panelInputs:{}};
+    const out=await api.attachPanelSources(stock,{DB:db},{waitUntil:p=>kept.push(p)});
+    assert.equal(out.panelInputs.cbRegistry.status,'pending');assert.ok(kept.length>=1,'unfinished sources were handed to waitUntil');
+    await Promise.all(kept);
+    assert.ok([...db.rows.keys()].some(k=>/^panel:cb-registry:v1:\d{4}-\d\d-\d\d$/.test(k)),'the registry was cached after the response');
+    assert.ok(uaSeen.length===2&&uaSeen.every(ua=>/Mozilla\/5\.0/.test(ua||'')),'TPEx requests carry a browser-like User-Agent');
+    const again=await api.attachPanelSources(stock,{DB:db},{waitUntil:p=>kept.push(p)});
+    assert.equal(again.panelInputs.cbRegistry.status,'partial');assert.equal(again.panelInputs.cbRegistry.bonds[0].id,'82993');
+  }finally{globalThis.fetch=previous;}
+});
