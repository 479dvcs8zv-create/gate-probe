+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {refreshLeaseStatement} from './helpers/refresh-lease.mjs';
+
+// GPT 2026-10-28 22:30 夜間巡檢讀回（擁有者 2026-10-29 00:08「好」同意修正）：
+// 1. 巡檢摘要 4 檔個股寫 pending，直接讀回其實都在巡檢途中更新完成 → 結束時讀回個股快照。
+// 2. 擴展總經 11/12、市場／貴金屬 36/36、美股指數 3/3 資料能用，摘要卻寫 pending → 依可用數給狀態，另標背景更新未落地；
+//    並修正「記憶體舊快照蓋住 D1 新快照」與「背景更新卡住後永遠不再更新」。
+// 3. 貴金屬判讀同時寫「通過」和「0/2 可用」→ 來源數只寫核對紀錄裡真的有的數字。
+const source=readFileSync(new URL('../dist/server/index.js',import.meta.url),'utf8');
+let serial=0;
+const load=(extra='')=>import('data:text/javascript;base64,'+Buffer.from(source+`\n${extra}\n// v244-${serial++}`).toString('base64'));
+
+test('貴金屬判讀：來源數只寫核對紀錄裡有的數字，「通過」不會和「0/2 可用」同時出現',async()=>{
+  const {summarizeSiteModule}=await load('export {summarizeSiteModule};');
+  const gold={passed:true,channelsAttempted:3,channelsAvailable:3,differencePercent:0.0213,timeGapMinutes:1.5};
+  const silver={passed:true,channelsAttempted:3,channelsAvailable:2,differencePercent:0.11,timeGapMinutes:4};
+  const rows=[
+    {id:'XAU',name:'黃金現貨參考價（XAU/USD）',status:'ok',value:4012.5,unit:'美元/金衡盎司',date:'2026-10-28',sourceVerification:gold},
+    {id:'XAG',name:'白銀現貨參考價（XAG/USD）',status:'ok',value:48.2,unit:'美元/金衡盎司',date:'2026-10-28',sourceVerification:silver},
+    {id:'XAU_XAG',name:'黃金／白銀比（XAU/XAG）',status:'ok',value:83.25,unit:'倍',date:'2026-10-28',historyObservations:5,sourceVerification:{passed:true,rule:'金、銀各自須取得三個通道中的兩個一致來源'},goldVerification:gold,silverVerification:silver},
+  ];
+  const lines=summarizeSiteModule('marketAndPreciousMetals',{checkedAt:new Date().toISOString(),rows}).judgment;
+  assert.equal(lines.length,3);
+  for(const line of lines){assert.doesNotMatch(line,/0\/2|未通過/,line);assert.match(line,/核對通過/);}
+  assert.match(lines[0],/3\/3 來源可用，核對通過（價差 0\.0213%、時間差 1\.5 分鐘）/);
+  assert.match(lines[1],/2\/3 來源可用，核對通過/);
+  assert.match(lines[2],/金價 3\/3 來源可用、銀價 2\/3 來源可用，核對通過/,'金銀比寫金、銀各自的來源數');
+  // 沒有任何來源數欄位、而且未通過：只寫「核對未通過」，不補 0/2 之類的預設數字
+  const failed=summarizeSiteModule('marketAndPreciousMetals',{checkedAt:new Date().toISOString(),rows:[{id:'XAU_XAG',name:'黃金／白銀比（XAU/XAG）',status:'missing',value:null,date:null,sourceVerification:{passed:false,rule:'須同時有 XAU/USD、XAG/USD 有效值'}}]}).judgment[0];
+  assert.match(failed,/；核對未通過/);assert.doesNotMatch(failed,/\d\/\d|核對通過/);
+  // 來源數為 null 也不當成 0
+  const nulls=summarizeSiteModule('marketAndPreciousMetals',{checkedAt:new Date().toISOString(),rows:[{id:'XAU',name:'黃金',status:'missing',value:null,sourceVerification:{passed:false,channelsAttempted:null,channelsAvailable:null}}]}).judgment[0];
+  assert.doesNotMatch(nulls,/\d\/\d/);
+});
+
+test('模組摘要：手上快照早於本輪、背景更新未落地 → 依觀測日判斷後的可用數給狀態；過期項目照樣不算可用',async()=>{
+  const {summarizeSiteModule}=await load('export {summarizeSiteModule};');
+  const since='2026-10-28T14:42:48.000Z',checkedAt='2026-10-28T14:20:00.000Z';
+  const rows=Array.from({length:36},(_,i)=>({id:'R'+i,status:'ok',value:1,date:'2026-10-28'}));
+  const ok=summarizeSiteModule('marketAndPreciousMetals',{checkedAt,refreshing:true,rows},{since});
+  assert.equal(ok.status,'ok');assert.equal(ok.usable,36);assert.equal(ok.refreshState,'background_refreshing');assert.equal(ok.snapshotCheckedAt,checkedAt);
+  assert.match(ok.note,/本次巡檢開始前.*可用 36\/36.*背景更新未在巡檢結束前落地/);
+  const twoStale=rows.map((row,i)=>i<2?{...row,status:'stale',is_stale:true}:row);
+  const partial=summarizeSiteModule('marketAndPreciousMetals',{checkedAt,refreshing:true,rows:twoStale},{since});
+  assert.equal(partial.status,'partial');assert.equal(partial.usable,34,'過期的項目不算可用');
+  // 擴展總經 11/12（國發會景氣燈號還停在 8 月）→ partial，不是 pending
+  const expanded=summarizeSiteModule('expandedMacro',{checkedAt,refreshing:true,rows:rows.slice(0,12).map((row,i)=>i===11?{...row,id:'TW_NDC_SIGNAL',status:'stale',is_stale:true,date:'2026-08-01'}:row)},{since});
+  assert.equal(expanded.status,'partial');assert.equal(expanded.usable,11);assert.equal(expanded.total,12);
+  // 美股指數 3/3
+  const us=summarizeSiteModule('usIndices',{checkedAt,refreshing:true,rows:rows.slice(0,3)},{since});
+  assert.equal(us.status,'ok');assert.equal(us.usable,3);
+  // 巡檢期間更新的快照仍標 refreshedThisRun
+  const fresh=summarizeSiteModule('usIndices',{checkedAt:'2026-10-28T14:45:00.000Z',refreshing:true,rows:rows.slice(0,3)},{since});
+  assert.equal(fresh.refreshedThisRun,true);assert.equal(fresh.refreshState,'refreshed_this_run');
+});
+
+function memoryDb(){
+  const rows=new Map();
+  return {rows,prepare(sql){return {run:async()=>({success:true}),bind:(...args)=>({run:async()=>{if(sql.startsWith('INSERT INTO site_runtime_cache'))rows.set(args[0],{payload:args[1],updated_at:args[2],expires_at:args[3]});return {success:true};},all:async()=>({results:rows.has(args[0])?[rows.get(args[0])]:[]}),first:async()=>null})};}};
+}
+
+test('美股指數：本機記憶體的舊快照不會蓋住 D1 裡別的執行個體存好的新快照；背景更新卡住超過 3 分鐘會重新開始',async()=>{
+  const api=await load('export {usIndicesResponse};export {usIndicesPendingAt};');
+  const db=memoryDb(),realNow=Date.now,start=realNow(),previous=globalThis.fetch,waiting=[];
+  globalThis.fetch=()=>new Promise(resolve=>waiting.push(resolve));   // 來源一直不回（模擬背景更新被平台取消）
+  const put=(payload,updatedMs,ttlMs)=>db.rows.set('us-indices:v1',{payload:JSON.stringify(payload),updated_at:new Date(updatedMs).toISOString(),expires_at:new Date(updatedMs+ttlMs).toISOString()});
+  const row=(value,date)=>({id:'SP500',name:'標普 500',status:'ok',value,percent:0.5,date});
+  try{
+    put({checkedAt:new Date(start-40*60000).toISOString(),rows:[row(6900,'2026-10-27')]},start-40*60000,15*60000);   // 過期快照
+    const first=await (await api.usIndicesResponse({DB:db},{waitUntil(){}})).json();
+    assert.equal(first.refreshing,true);assert.equal(first.rows[0].value,6900);
+    const startedAt=api.usIndicesPendingAt;assert.ok(startedAt>=start);
+    // 別的執行個體完成更新、存進 D1
+    put({checkedAt:new Date(start+1000).toISOString(),rows:[row(7000,'2026-10-28')]},start+1000,15*60000);
+    const second=await (await api.usIndicesResponse({DB:db},{waitUntil(){}})).json();
+    assert.equal(second.rows[0].value,7000,'讀到 D1 的新快照');assert.notEqual(second.refreshing,true,'新快照有效期內不再標更新中');
+    // 16 分鐘後：快照又過期，而第一次的背景更新還卡著 → 重新開始一次
+    Date.now=()=>start+16*60000;
+    await api.usIndicesResponse({DB:db},{waitUntil(){}});
+    assert.ok(api.usIndicesPendingAt>startedAt+3*60000,'卡住超過 3 分鐘的背景更新會被取代');
+  }finally{Date.now=realNow;globalThis.fetch=previous;for(const resolve of waiting)resolve(new Response('closed',{status:503}));}
+});
+
+// 巡檢整體流程（與 refresh-resume 相同的替身）：個股步驟時快照還在背景更新，結束前完成 → 摘要記為本輪已更新。
+class DB{
+  rows=new Map();leases=new Map();
+  prepare(sql){const lease=refreshLeaseStatement(this,sql);if(lease)return lease;return {run:async()=>({success:true}),bind:(...args)=>({all:async()=>({results:this.rows.has(args[0])?[this.rows.get(args[0])]:[]}),run:async()=>{this.rows.set(args[0],{payload:args[1],updated_at:args[2],expires_at:args[3]});return {success:true};}})};}
+}
+const hooks=`
+ captureFullMarketSnapshot=async()=>({status:'collecting_history',date:'2026-10-28',sessions:71,captured:{total:600},universe:{total:600}});
+ runSiteModule=async id=>({id,status:'ok',observations:[]});
+ refreshSiteStock=async(row,env)=>{
+   // 背景更新在個股步驟之後才完成：5009 沒完成（快照仍是巡檢前的），2404 完成但有一組資料失敗
+   const at=row.id==='5009'?'2026-10-27T10:00:00.000Z':new Date().toISOString();
+   env.DB.rows.set('stock:v5:'+row.id,{payload:JSON.stringify({id:row.id,checkedAt:at,price:{date:'2026-10-28',value:100},revenue:{month:'2026-09'},datasetStatus:row.id==='2404'?{margin:{status:'error'}}:{price:{status:'ok'}},errors:{}}),updated_at:at,expires_at:new Date(Date.now()+3600000).toISOString()});
+   return {id:row.id,name:row.name,status:'pending',checkedAt:'2026-10-27T10:00:00.000Z'};
+ };
+ stockSourceResearchResponse=async request=>Response.json({status:'ok',records:[{symbol:new URL(request.url).searchParams.get('id')}]});
+ masterModelResponse=async request=>Response.json({status:'partial',symbol:new URL(request.url).searchParams.get('id'),gates:[]});
+`;
+test('巡檢結束時讀回個股快照：本輪期間更新完成的記為已更新；沒完成的維持 pending 並註明；歷史摘要一致',async()=>{
+  const env={DB:new DB()},request=(path='status')=>new Request('https://site.test/api/automation/'+path,{method:path==='refresh-all'?'POST':'GET'});
+  const started=await (await (await load(hooks)).default.fetch(request('refresh-all'),env,{})).json();
+  let result;
+  for(let i=0;i<80&&!result?.completedAt;i++)result=await (await (await load(hooks)).default.fetch(request(),env,{})).json();
+  assert.ok(result.completedAt,'巡檢完成');assert.equal(result.runId,started.runId);
+  const by=Object.fromEntries(result.stocks.map(row=>[row.id,row]));
+  for(const id of ['8299','5289']){
+    assert.equal(by[id].status,'ok',id);assert.equal(by[id].refreshedThisRun,true);assert.equal(by[id].stepStatus,'pending');
+    assert.equal(by[id].summaryScope,'final_readback');assert.equal(by[id].dataAsOf,'2026-10-28');
+  }
+  assert.equal(by['2404'].status,'partial');assert.equal(by['2404'].datasetErrors,1);
+  assert.equal(by['5009'].status,'pending','快照早於本輪 → 不冒充已更新');assert.match(by['5009'].note,/背景更新仍未完成/);
+  const history=JSON.parse(env.DB.rows.get('site-auto-refresh-history:v1').payload).runs.at(-1);
+  assert.equal(history.completedAt,result.completedAt);assert.equal(history.stockCount,4);
+});
