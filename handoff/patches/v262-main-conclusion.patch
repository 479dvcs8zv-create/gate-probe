+const businessDays=(start,count)=>{const out=[];const d=new Date(start+'T00:00:00Z');while(out.length<count){if(d.getUTCDay()%6)out.push(d.toISOString().slice(0,10));d.setUTCDate(d.getUTCDate()+1);}return out;};
