+
+test('收盤在 20 與 60 日線下 → 避開（就算符合進場條件也一樣）',()=>{
+  const {stock,asOf}=stockOf(Array.from({length:70},(_,i)=>200-i));
+  const r=mainConclusion(stock,{status:'enter'},{asOf});
+  assert.equal(r.status,'avoid');assert.equal(r.label,'避開');assert.match(r.reason,/20 日線.*60 日線/);
+  assert.equal(r.scoreContribution,0);assert.match(r.backtest,/第 49 輪/);assert.match(r.valuationNote,/只當參考/);
+});
+
+test('只跌破 20 日線、仍在 60 日線上 → 觀望',()=>{
+  const {stock,asOf}=stockOf([...Array.from({length:69},(_,i)=>100+i),150]);
+  const r=mainConclusion(stock,{status:'enter'},{asOf});
+  assert.equal(r.status,'watch');assert.match(r.reason,/跌破 20 日線/);
+});
+
+test('在 20 日線上且符合進場三條件 → 可進場；離 20 日線超過 10% 加風險提示',()=>{
+  let {stock,asOf}=stockOf(Array.from({length:70},(_,i)=>100+i));
+  let r=mainConclusion(stock,{status:'enter'},{asOf});
+  assert.equal(r.status,'enter');assert.equal(r.label,'可進場');assert.equal(r.warning,null);assert.ok(r.bias20Pct<10);
+  ({stock,asOf}=stockOf(Array.from({length:70},(_,i)=>100*1.02**i)));
+  r=mainConclusion(stock,{status:'enter'},{asOf});
+  assert.equal(r.status,'enter');assert.ok(r.bias20Pct>10);assert.match(r.warning,/第 50 輪/);
+});
+
+test('在 20 日線上但不符合或資料不足 → 觀望；股價不足 60 筆 → 資料不足',()=>{
+  const {stock,asOf}=stockOf(Array.from({length:70},(_,i)=>100+i));
+  assert.equal(mainConclusion(stock,{status:'avoid'},{asOf}).label,'觀望');
+  const r=mainConclusion(stock,{status:'insufficient',reason:'營收缺值'},{asOf});
+  assert.equal(r.label,'觀望');assert.match(r.reason,/營收缺值/);
+  const short=stockOf(Array.from({length:59},(_,i)=>100+i));
+  assert.equal(mainConclusion(short.stock,{status:'enter'},{asOf:short.asOf}).status,'insufficient');
+});
+
+test('後台：否決改剔除、市場資料不齊不再壓評級；網頁：主結論蓋在評級卡最上面',()=>{
+  const server=readFileSync(new URL('../dist/server/index.js',import.meta.url),'utf8'),html=readFileSync(new URL('../dist/index.html',import.meta.url),'utf8');
+  for(const s of ['mainConclusion:mainConclusion(stock,ec,{asOf})',"status:'excluded',label:'剔除'",'coreReady:[7,9,10].every','不再壓低個股評級（v262）'])assert.ok(server.includes(s),s);
+  assert.ok(html.includes('function renderMainConclusion(model)'));
+  const a=html.indexOf('renderAdaptiveRating(model.adaptiveRating,model);'),b=html.indexOf('renderMainConclusion(model);');
+  assert.ok(a>0&&b>a,'主結論在評級卡之後套上，不會被蓋掉');
+  assert.ok(html.includes("主結論｜回測有效的訊號"));
+});
