+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+
+// v254（GPT 11/05 hotfix10 讀回）：自動匯入的信用七列（巡檢從 GitHub 收集套件匯入時走這條路）缺 previousDate／capturedAt／captureDeferred，
+// v249 只修了網站自己晚上直接抓的那條路。補上同一套欄位；前一筆只取官方成交日表裡早於信用日的最近一天，查不到就留空。
+const source=readFileSync(new URL('../dist/server/index.js',import.meta.url),'utf8');
+const api=await import('data:text/javascript;base64,'+Buffer.from(source+'\nexport {validateTaiwanStatistics};\n// v254').toString('base64'));
+const originalNow=Date.now;
+const now='2026-10-10T03:00:00Z';Date.now=()=>Date.parse(now);
+const year=2026,calendar={stat:'ok',fields:['日期','名稱','說明'],queryYear:year,data:[...Array.from({length:10},(_,i)=>[`2026-01-${String(i+1).padStart(2,'0')}`,'官方表項','']),['2026-10-09','國慶日','補假'],['2026-10-10','國慶日','放假']]};
+const date='2026-10-08',dateKey='20261008',base='https://www.twse.com.tw/rwd/zh/marginTrading/';
+const statistics={date,capturedAt:now,calendar,tradingDates:[{Date:'1151008',TradeValue:'924509097873'}],sourceUrls:{calendar:'https://www.twse.com.tw/holidaySchedule/holidaySchedule?response=json',tradingDates:'https://openapi.twse.com.tw/v1/exchangeReport/FMTQIK',margin:base+'MI_MARGN?response=json&date='+dateKey+'&selectType=MS',marginTrend:base+'MI_MARGN_TREND?response=json&date='+dateKey+'&days=30',creditSummary:base+'BFIJ3U?response=json&date='+dateKey},margin:{stat:'OK',date:dateKey,tables:[{fields:['項目','買進','賣出','現金(券)償還','前日餘額','今日餘額'],data:[['融資(交易單位)',0,0,0,'9,358,244','9,406,720'],['融券(交易單位)',0,0,0,'215,104','211,949'],['融資金額(仟元)',0,0,0,'640,000,774','646,405,767']]}]},marginTrend:{stat:'OK',date:dateKey,data:[{date:dateKey,marginAmt:646405767,marginShr:9406720,shortShr:211949,marketValue:1613576.55}]},creditSummary:{stat:'OK',date:dateKey,crdAmt:136915226630}};
+const credit=['TWSE_MARGIN_BALANCE_NTD','TWSE_MARGIN_CHANGE_NTD','TWSE_MARGIN_BALANCE_UNITS','TWSE_SHORT_BALANCE','TWSE_SHORT_CHANGE','TWSE_MARGIN_MARKET_CAP_RATIO','TWSE_CREDIT_TRADE_VALUE'];
+
+test('匯入的信用列：previousDate＝成交日表裡前一個交易日，並標 capturedAt 與未延後',()=>{
+  try{
+    const rows=api.validateTaiwanStatistics({...statistics,tradingDates:[{Date:'1151006',TradeValue:'900000000000'},{Date:'1151007',TradeValue:'910000000000'},{Date:'1151008',TradeValue:'924509097873'}]});
+    for(const id of credit){
+      const row=rows.find(r=>r.id===id);
+      assert.equal(row.date,'2026-10-08');assert.equal(row.previousDate,'2026-10-07',id);assert.equal(row.previousDateBasis,'official_trading_calendar');
+      assert.equal(row.capturedAt,now);assert.equal(row.capturedAtBasis,'external_collector_capture');assert.equal(row.captureDeferred,false);
+      assert.notEqual(row.previousDate,row.date);
+    }
+  }finally{Date.now=originalNow;}
+});
+
+test('成交日表只有當天（例如月初第一個交易日）：previousDate 留空、標 unknown，不自己推算',()=>{
+  Date.now=()=>Date.parse(now);
+  try{
+    const row=api.validateTaiwanStatistics(statistics).find(r=>r.id==='TWSE_MARGIN_BALANCE_NTD');
+    assert.equal(row.previousDate,null);assert.equal(row.previousDateBasis,'unknown');assert.equal(row.capturedAt,now);
+  }finally{Date.now=originalNow;}
+});
