diff --git a/scripts/wait_night_capture.py b/scripts/wait_night_capture.py
new file mode 100644
index 0000000..82c3d82
--- /dev/null
+++ b/scripts/wait_night_capture.py
@@ -0,0 +1,50 @@
+#!/usr/bin/env python3
+"""夜間信用統計：先排隊、等到台北 22:31 再收集。
+
+GitHub 排程在這個 repo 常延後 1.5～6 小時（實際紀錄：11/06 晚上之後的執行在 23:59、04:33、04:49、05:01、09:19 才開始），
+結果一次都沒收到夜間（22:30～23:59）的信用統計。改成 18:05、20:05 先排隊：
+跑到這一步時若還沒到 22:31，就在這裡等到 22:31，再讓後面的收集工作照常跑（網站規則：22:30 前不抓信用統計）。
+
+- 最多等 330 分鐘（GitHub 單一工作上限 360 分鐘）；離 22:31 更久就不等，這次照常收集但不含信用統計。
+- 已過 22:31 就不等；23:59 前收到的信用統計才會發布（publish_official_import.py 再核對一次）。
+- 不連任何網站、不需要金鑰；只算時間、睡覺、印出原因。
+
+用法：python3 scripts/wait_night_capture.py [現在時間 ISO，測試用]
+"""
+import datetime as dt
+import sys
+import time
+
+TPE = dt.timezone(dt.timedelta(hours=8))
+TARGET = (22, 31)
+MAX_WAIT_MINUTES = 330
+
+
+def plan(now):
+    """回傳 (要等幾秒, 說明)。"""
+    local = now.astimezone(TPE)
+    target = local.replace(hour=TARGET[0], minute=TARGET[1], second=0, microsecond=0)
+    wait = (target - local).total_seconds()
+    if wait <= 0:
+        return 0, f"台北 {local:%m/%d %H:%M}，已過 22:31，直接收集"
+    if wait > MAX_WAIT_MINUTES * 60:
+        return 0, f"台北 {local:%m/%d %H:%M}，離 22:31 還有 {wait / 60:.0f} 分鐘，超過 {MAX_WAIT_MINUTES} 分鐘不等；這次不含信用統計"
+    return int(wait), f"台北 {local:%m/%d %H:%M}，等 {wait / 60:.0f} 分鐘到 22:31 再收集信用統計"
+
+
+def main(argv):
+    now = dt.datetime.fromisoformat(argv[0].replace("Z", "+00:00")) if argv else dt.datetime.now(dt.timezone.utc)
+    seconds, reason = plan(now)
+    print(reason, flush=True)
+    if argv:
+        return 0
+    end = time.monotonic() + seconds
+    while (left := end - time.monotonic()) > 0:
+        time.sleep(min(left, 1800))
+        if end - time.monotonic() > 0:
+            print(f"還要等 {(end - time.monotonic()) / 60:.0f} 分鐘", flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
diff --git a/tests/test_night_wait.py b/tests/test_night_wait.py
new file mode 100644
index 0000000..45537c2
--- /dev/null
+++ b/tests/test_night_wait.py
@@ -0,0 +1,54 @@
+import datetime as dt
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+import wait_night_capture as night
+
+UTC = dt.timezone.utc
+
+
+class NightWaitTests(unittest.TestCase):
+    """2026-11-07：GitHub 排程延後 1.5～6 小時，夜間排程一次都沒在 22:30～23:59 跑到；改成提早排隊、等到 22:31。"""
+
+    def at(self, hhmm, day=7):
+        return dt.datetime(2026, 11, day, int(hhmm[:2]), int(hhmm[2:]), tzinfo=UTC) - dt.timedelta(hours=8)
+
+    def test_waits_until_2231_taipei(self):
+        self.assertEqual(night.plan(self.at("1805"))[0], 266 * 60)
+        self.assertEqual(night.plan(self.at("2005"))[0], 146 * 60)
+        self.assertEqual(night.plan(self.at("1701"))[0], 330 * 60, "最多等 330 分鐘")
+        self.assertEqual(night.plan(self.at("2230"))[0], 60)
+
+    def test_no_wait_inside_window_or_when_too_early(self):
+        for hhmm in ("2231", "2300", "2359"):
+            seconds, reason = night.plan(self.at(hhmm))
+            self.assertEqual(seconds, 0)
+            self.assertIn("直接收集", reason)
+        for hhmm in ("1600", "0005", "0933"):
+            seconds, reason = night.plan(self.at(hhmm))
+            self.assertEqual(seconds, 0, hhmm)
+            self.assertIn("不含信用統計", reason)
+
+    def test_dry_run_with_explicit_time_does_not_sleep(self):
+        self.assertEqual(night.main(["2026-11-07T10:05:00Z"]), 0)
+
+    def test_workflow_queues_early_and_waits_outside_the_collector_queue(self):
+        text = (ROOT / ".github" / "workflows" / "official_collector.yml").read_text(encoding="utf-8")
+        for cron in ("'5 10 * * *'", "'5 12 * * *'", "'40 14 * * 1-5'", "'55 21 * * *'"):
+            self.assertIn("- cron: " + cron, text)
+        wait = text.split("  wait-night:", 1)[1].split("  collect-publish:", 1)[0]
+        collect = text.split("  collect-publish:", 1)[1]
+        self.assertIn("timeout-minutes: 345", wait)
+        self.assertIn("python3 scripts/wait_night_capture.py", wait)
+        self.assertEqual(wait.count("github.event.schedule == '5 10 * * *' || github.event.schedule == '5 12 * * *' || inputs.night == 'true'"), 2)
+        self.assertNotIn("concurrency", wait, "等待時不佔收集的排隊位置")
+        self.assertIn("needs: wait-night", collect)
+        self.assertIn("group: official-collector", collect)
+        self.assertNotIn("\nconcurrency:", text.split("jobs:", 1)[0], "排隊改在收集工作上")
+
+
+if __name__ == "__main__":
+    unittest.main()
