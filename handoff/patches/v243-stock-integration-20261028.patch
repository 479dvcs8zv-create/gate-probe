+++ b/tests/v243-stock-dedup.test.mjs
@@ -0,0 +1,27 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+
+// 擁有者 2026-10-28 03:39「我是說個股那邊 要做整合 同一只做一次計算 還有不要重複顯示」。
+const html=readFileSync(new URL('../dist/index.html',import.meta.url),'utf8');
+const at=marker=>{const i=html.indexOf(marker);assert.ok(i>0,marker);return i;};
+
+test('個股區順序：搜尋 → 追蹤清單 → Master Model（結論、Gate）→ 估值 → 財報品質 → 財報解讀 → 資料來源',()=>{
+  const order=['class="panel stock-search"','id="stockGrid"','class="panel pipeline"','id="valuationCalculator"','class="workspace"','id="financialAnalysisPanel"','class="panel source-panel"'].map(at);
+  assert.deepEqual([...order].sort((a,b)=>a-b),order);
+  const inside=['id="qualifiedReport"','id="advisoryPanels"','id="gateList"','id="overallReport"','2026／2027 EPS｜自動連結個股資料池與總經'].map(at);
+  assert.deepEqual([...inside].sort((a,b)=>a-b),inside,'結論在前、Gate 其次、人工補登工具最後');
+});
+
+test('同一筆資料只顯示一處：重複的格子拿掉或隱藏，瀏覽器不另算 Gate／趨勢',()=>{
+  assert.match(html,/\.source-panel \.source-grid\{display:none!important\}/,'個股資料區的收盤／月營收／估值摘要三格不再顯示');
+  assert.match(html,/#fourQuadrants\{display:none!important\}/,'四象限（重述）不再顯示');
+  const metrics=html.slice(html.indexOf('const metricItems=['),html.indexOf('for(const [label,value,date] of metricItems)'));
+  for(const gone of ['最新收盤價','20 日均線','ROIC｜近四季','CFO／淨利｜近三年','自由現金流｜近三年','今年 EPS 折現股價情境','歷史 P/E 區間','今年模型預估 EPS'])assert.ok(!metrics.includes(gone),gone);
+  for(const kept of ['月營收｜年增','歷史 EPS 中位數','TTM EPS'])assert.ok(metrics.includes(kept),kept);
+  assert.ok(!html.includes("['趨勢判斷',price!=null&&ma20!=null"),'不再用未還原的 20 日線另判趨勢（以後台的出場訊號為準）');
+  assert.ok(!html.includes("['1 總經門檻／風險預算'"),'瀏覽器不另算 10 個 Gate');
+  const sources=html.slice(html.indexOf('function renderFinancialSourceOutput'),html.indexOf('function renderFinancialReportOutput'));
+  assert.ok(!sources.includes("['收盤行情'")&&!sources.includes("['ROIC｜近四季／常態'"),'財報資料來源區只列三張財報的筆數與期別');
+  assert.match(html,/財報品質與估值輸入/);assert.match(html,/資料來源與自動資料池/);
+});
