+/** 出場訊號（擁有者 2026-10-26 23:18 核准；第 34 輪回測）：收盤跌破 20 日線 → 若持有就出場。
+ *  20 日線用還原除權息的收盤（除權息日之前的價格乘上 (前一日收盤 − 現金股利)／前一日收盤，股票股利再除以 1＋配股／10）。 */
+export function exitSignal(stock,{asOf}={}){
+  const rule='收盤跌破 20 日線 → 若持有就出場（擁有者 2026-10-26 23:18 核准）';
+  const backtest='第 34 輪：每筆平均 +1.25%（已扣成本）、平均抱 13 天、最差 5% 交易 −9.7%；固定抱 20 天最差 5% 為 −17.6%';
+  const rows=(stock?.priceHistory||[]).filter(r=>day(r.date)&&r.date<=asOf&&Number.isFinite(r.close)&&r.close>0).sort((a,b)=>a.date.localeCompare(b.date));
+  if(rows.length<21||rows.at(-1).date!==asOf)return {status:'insufficient',label:'資料不足',rule,backtest,reason:rows.length<21?`股價 ${rows.length}/21 筆`:'股價日期與基準日不一致'};
+  const w=rows.slice(-21),adj=w.map(r=>r.close),events=Array.isArray(stock?.exRightsEvents)?stock.exRightsEvents:null,applied=[];
+  for(const e of events||[]){
+    for(const [date,kind] of [[e.cashDate,'cash'],[e.stockDate,'stock']]){
+      const k=date?w.findIndex(r=>r.date===date):-1;if(k<1)continue;
+      const f=kind==='cash'?(e.cash>0&&e.cash<w[k-1].close?(w[k-1].close-e.cash)/w[k-1].close:null):(e.stockBonus>0?1/(1+e.stockBonus/10):null);
+      if(!f)continue;for(let i=0;i<k;i++)adj[i]*=f;applied.push({date,kind,amount:kind==='cash'?e.cash:e.stockBonus});
+    }
+  }
+  const ma20=mean(adj.slice(-20)),close=adj.at(-1),below=close<ma20;
+  return {status:below?'exit':'hold',label:below?'出場訊號':'續抱',rule,backtest,asOf,close,ma20,adjustedFor:applied,
+    reason:below?`收盤 ${close.toFixed(2)} 跌破 20 日線 ${ma20.toFixed(2)} → 若持有，出場`:`收盤 ${close.toFixed(2)} 在 20 日線 ${ma20.toFixed(2)} 之上 → 續抱`,
+    note:events===null?'除權息資料未接入（舊快取）；除權息後 20 天內可能誤判':applied.length?`已還原 ${applied.map(a=>`${a.date} ${a.kind==='cash'?'現金股利 '+a.amount+' 元':'配股 '+a.amount+' 元'}`).join('、')}`:null,scoreContribution:0};
+}
 export function entryCondition(stock,ma,tq,{asOf}={}){
