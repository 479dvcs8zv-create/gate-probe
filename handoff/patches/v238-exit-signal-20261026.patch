@@ -138,10 +138,49 @@ function entryHints(stock,ma,asOf){
   if(trend==='向下')hints.push({kind:'warning',text:'趨勢向下：收盤在 20 日線下且 20 日線下彎'});
   return {hints,chips,shortTerm,trend,financial:{cfoToNetIncome:fq.cfoToNetIncome?.value??null,freeCashFlow:fq.freeCashFlow?.value??null}};
 }
+/** 出場訊號（擁有者 2026-10-26 23:18 核准；第 34 輪回測）：收盤跌破 20 日線 → 若持有就出場。
+ *  20 日線用還原除權息的收盤（除權息日之前的價格乘上 (前一日收盤 − 現金股利)／前一日收盤，股票股利再除以 1＋配股／10）。 */
+/** 最近 n 筆收盤，還原除權息：除權息日之前的價格乘上 (前一日收盤 − 現金股利)／前一日收盤，股票股利再除以 1＋配股／10。 */
+function adjustedCloses(stock,asOf,n){
+  const rows=(stock?.priceHistory||[]).filter(r=>day(r.date)&&r.date<=asOf&&Number.isFinite(r.close)&&r.close>0).sort((a,b)=>a.date.localeCompare(b.date));
+  if(rows.length<n||rows.at(-1).date!==asOf)return {ok:false,count:rows.length,aligned:rows.at(-1)?.date===asOf};
+  const w=rows.slice(-n),adj=w.map(r=>r.close),events=Array.isArray(stock?.exRightsEvents)?stock.exRightsEvents:null,applied=[];
+  for(const e of events||[]){
+    for(const [date,kind] of [[e.cashDate,'cash'],[e.stockDate,'stock']]){
+      const k=date?w.findIndex(r=>r.date===date):-1;if(k<1)continue;
+      const f=kind==='cash'?(e.cash>0&&e.cash<w[k-1].close?(w[k-1].close-e.cash)/w[k-1].close:null):(e.stockBonus>0?1/(1+e.stockBonus/10):null);
+      if(!f)continue;for(let i=0;i<k;i++)adj[i]*=f;applied.push({date,kind,amount:kind==='cash'?e.cash:e.stockBonus});
+    }
+  }
+  return {ok:true,adj,applied,events};
+}
+/** 均線排列（擁有者 2026-10-26 23:24／23:28 核准；第 35 輪）：強＝5、10 日線都在 20 日線與半年線（120 日）之上；
+ *  弱＝都在 20 日線下，或都在半年線下；中＝其餘。用還原除權息的收盤。 */
+export function maAlignment(stock,{asOf}={}){
+  const a=adjustedCloses(stock,asOf,120);
+  if(!a.ok)return {status:'insufficient',level:null,reason:a.aligned===false?'股價日期與基準日不一致':`股價 ${a.count}/120 筆，半年線不足`};
+  const m=k=>mean(a.adj.slice(-k)),m5=m(5),m10=m(10),m20=m(20),m120=m(120);
+  const level=m5>m20&&m10>m20&&m5>m120&&m10>m120?'強':(m5<m20&&m10<m20)||(m5<m120&&m10<m120)?'弱':'中';
+  return {status:'ok',level,ma5:m5,ma10:m10,ma20:m20,ma120:m120,
+    reason:level==='強'?'5、10 日線都在 20 日線與半年線之上':level==='弱'?(m5<m20&&m10<m20?'5、10 日線都在 20 日線之下':'5、10 日線都在半年線之下'):'5、10 日線與 20 日線、半年線位置不一致',
+    backtest:'第 35 輪：排列強之後 20 日超額 +0.64%、弱 −0.42%；弱勢 60 日內跌 30% 以上 8.4%（強 6.4%）'};
+}
+export function exitSignal(stock,{asOf}={}){
+  const rule='收盤跌破 20 日線 → 若持有就出場（擁有者 2026-10-26 23:18 核准）';
+  const backtest='第 34 輪：每筆平均 +1.25%（已扣成本）、平均抱 13 天、最差 5% 交易 −9.7%；固定抱 20 天最差 5% 為 −17.6%';
+  const a=adjustedCloses(stock,asOf,21);
+  if(!a.ok)return {status:'insufficient',label:'資料不足',rule,backtest,reason:a.aligned===false?'股價日期與基準日不一致':`股價 ${a.count}/21 筆`};
+  const {adj,applied,events}=a;
+  const ma20=mean(adj.slice(-20)),close=adj.at(-1),below=close<ma20;
