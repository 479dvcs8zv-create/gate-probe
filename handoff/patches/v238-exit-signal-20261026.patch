   const rule='技術強（三問技術過且均線強弱 ≥ +3）＋近 3 月營收年增率平均 > 10% 才進場；技術不過避開（擁有者 2026-10-26 21:51 核准）';
   const backtest='第 33 輪：技術強＋營收成長之後 20 日超額 +1.18%（扣一買一賣約 0.585% 後約 +0.6%）；技術不過 60 日內跌 30% 以上機率約 10～11%';
   const tech=tq?.questions?.technical,score=Number.isFinite(ma?.score)&&ma?.status==='ok'?ma.score:null;
