new file mode 100644
index 0000000..5573c7b
--- /dev/null
+++ b/tests/v238-exit.test.mjs
@@ -0,0 +1,33 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {exitSignal,entryCondition} from '../worker/panel-calculations.mjs';
+
+// 擁有者 2026-10-26 23:18 核准：收盤跌破 20 日線 → 若持有就出場（第 34 輪）。
+const asOf='2026-10-22';
+const history=closes=>closes.map((close,i)=>({date:new Date(Date.parse(asOf)-(closes.length-1-i)*86400000).toISOString().slice(0,10),close,Trading_money:1e8}));
+
+test('收盤在 20 日線上續抱、跌破就出場訊號；資料不足不判斷',()=>{
+  const up=exitSignal({priceHistory:history(Array.from({length:21},(_,i)=>100+i)),exRightsEvents:[]},{asOf});
+  assert.equal(up.status,'hold');assert.equal(up.label,'續抱');
+  const down=exitSignal({priceHistory:history([...Array(20).fill(100),97]),exRightsEvents:[]},{asOf});
+  assert.equal(down.status,'exit');assert.match(down.reason,/跌破 20 日線/);
+  assert.equal(exitSignal({priceHistory:history(Array(20).fill(100)),exRightsEvents:[]},{asOf}).status,'insufficient');
+  assert.equal(exitSignal({priceHistory:history(Array(21).fill(100))},{asOf:'2026-10-23'}).status,'insufficient','基準日沒有收盤');
+});
+
+test('除息當天的價差不算跌破：20 日線用還原除權息的價格',()=>{
+  const h=history([...Array(20).fill(100),95]);
+  // 未還原：20 日平均 99.75，收盤 95 會被當成跌破
+  const naive=exitSignal({priceHistory:h,exRightsEvents:[]},{asOf});
+  assert.equal(naive.status,'exit');
+  const adj=exitSignal({priceHistory:h,exRightsEvents:[{cashDate:asOf,cash:5,stockDate:null,stockBonus:0}]},{asOf});
+  assert.equal(adj.status,'hold','除息 5 元後參考價 95，收盤 95 不算跌破');assert.ok(Math.abs(adj.ma20-95)<1e-9);
+  assert.match(adj.note,/已還原 2026-10-22 現金股利 5 元/);
+  const old=exitSignal({priceHistory:h},{asOf});
+  assert.match(old.note,/除權息資料未接入/);
+});
+
+test('進場卡帶出場訊號；不改可進場／避開／觀望',()=>{
+  const ec=entryCondition({priceHistory:history([...Array(20).fill(100),97]),exRightsEvents:[]},{status:'ok',score:4,averages:[]},{questions:{technical:{result:'pass'}}},{asOf});
+  assert.equal(ec.exitSignal.status,'exit');assert.equal(ec.status,'insufficient','營收資料不足時進場判斷仍是資料不足');
+});
