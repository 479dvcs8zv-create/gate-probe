+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import {refreshLeaseStatement} from './helpers/refresh-lease.mjs';
+
+// GPT 10/30～10/31 讀回的兩個新問題：
+// 1. 晚上直接抓的信用統計，previousDate 標成當天（10/30），歷史前一筆其實是 10/29。
+// 2. 10/31 晨間巡檢 8299 Gate 審計單步逾時，只存 4/5；後台多半已算完，下一次輪詢再試一次即可。
+const source=fs.readFileSync(new URL('../dist/server/index.js',import.meta.url),'utf8');
+let serial=0;
+
+function upstream(fmtqik){return async input=>{
+  const url=new URL(input);
+  if(url.pathname.endsWith('/FMTQIK'))return Response.json(fmtqik.map(d=>({Date:d,TradeValue:'900000000000'})));
+  if(url.pathname.endsWith('/MI_MARGN'))return Response.json({stat:'OK',date:'20261021',tables:[{fields:['項目','買進','賣出','償還','前日餘額','今日餘額'],data:[['融資(交易單位)',0,0,0,100,110],['融券(交易單位)',0,0,0,200,210],['融資金額(仟元)',0,0,0,300000000,310000000]]}]});
+  if(url.pathname.endsWith('/MI_MARGN_TREND'))return Response.json({stat:'OK',date:'20261021',data:[{date:'20261021',marginAmt:310000000,marketValue:1000000}]});
+  if(url.pathname.endsWith('/BFIJ3U'))return Response.json({stat:'OK',date:'20261021',crdAmt:12000000000});
+  throw Error('Unexpected test request: '+url.pathname);
+};}
+const emptyDb={prepare(){return {run:async()=>({success:true}),bind(){return {all:async()=>({results:[]}),run:async()=>({success:true})};}};}};
+async function nightCapture(fmtqik){
+  const oldNow=Date.now,oldFetch=globalThis.fetch;
+  Date.now=()=>Date.parse('2026-10-21T14:35:00Z');globalThis.fetch=upstream(fmtqik);
+  try{
+    const api=await import('data:text/javascript;base64,'+Buffer.from(source+`\nrelaySeries=async()=>null;\nexport {loadTaiwanDashboard};\n// v249-${serial++}`).toString('base64'));
+    return await api.loadTaiwanDashboard({DB:emptyDb});
+  }finally{Date.now=oldNow;globalThis.fetch=oldFetch;}
+}
+
+test('晚上直接抓的信用：previousDate＝官方交易日中前一個交易日，不再標成當天；查不到就留空',async()=>{
+  const rows=await nightCapture(['1151016','1151020','1151021']);
+  const margin=rows.find(r=>r.id==='TWSE_MARGIN_BALANCE_NTD');
+  assert.equal(margin.date,'2026-10-21');assert.equal(margin.previousDate,'2026-10-20');assert.equal(margin.previousDateBasis,'official_trading_calendar');
+  assert.ok(margin.capturedAt,'晚上直接抓取也標抓取時間');
+  const single=(await nightCapture(['1151021'])).find(r=>r.id==='TWSE_MARGIN_BALANCE_NTD');
+  assert.equal(single.previousDate,null,'交易日曆只有當天時不自己推算前一天');assert.equal(single.previousDateBasis,'unknown');
+  assert.notEqual(single.previousDate,single.date);
+});
+
+class DB{
+  rows=new Map();leases=new Map();
+  prepare(sql){const lease=refreshLeaseStatement(this,sql);if(lease)return lease;return {run:async()=>({success:true}),bind:(...args)=>({all:async()=>({results:this.rows.has(args[0])?[this.rows.get(args[0])]:[]}),run:async()=>{this.rows.set(args[0],{payload:args[1],updated_at:args[2],expires_at:args[3]});return {success:true};}})};}
+}
+const hooks=`
+ captureFullMarketSnapshot=async()=>({status:'collecting_history',date:'2026-10-30',sessions:76,captured:{total:600},universe:{total:600}});
+ runSiteModule=async id=>({id,status:'ok',usable:1,total:1,observations:[]});
+ refreshSiteStock=async row=>({id:row.id,name:row.name,status:'fresh'});
+ stockSourceResearchResponse=async request=>Response.json({status:'ok',records:[]});
+ masterModelResponse=async request=>{const id=new URL(request.url).searchParams.get('id');globalThis.__v249gate[id]=(globalThis.__v249gate[id]||0)+1;
+   if(id==='8299'&&globalThis.__v249gate[id]===1)throw Error('step_timeout: 本步驟逾時；保存缺項並繼續其他項目');
+   if(id==='5289')throw Error('step_timeout: 本步驟逾時；保存缺項並繼續其他項目');
+   return Response.json({status:'valuation_divergence',auditStatus:'blocked',symbol:id,gates:[]});};
+`;
+test('Gate 審計單步逾時：下一次輪詢再試一次；成功就照常保存並註明重試，兩次都逾時就照實記錄缺項',async()=>{
+  globalThis.__v249gate={};
+  const env={DB:new DB()},request=(path='status')=>new Request('https://site.test/api/automation/'+path,{method:path==='refresh-all'?'POST':'GET'});
+  await (await import('data:text/javascript;base64,'+Buffer.from(source+hooks+`\n// v249-run-${serial++}`).toString('base64'))).default.fetch(request('refresh-all'),env,{});
+  let result;
+  for(let i=0;i<80&&!result?.completedAt;i++)result=await (await (await import('data:text/javascript;base64,'+Buffer.from(source+hooks+`\n// v249-poll-${serial++}`).toString('base64'))).default.fetch(request(),env,{})).json();
+  assert.ok(result.completedAt);
+  const by=Object.fromEntries(result.gateAudits.map(a=>[a.symbol,a]));
+  assert.equal(by['8299'].recorded,true,'第二次成功保存');assert.equal(by['8299'].retried,1);assert.equal(globalThis.__v249gate['8299'],2);
+  assert.equal(by['5289'].recorded,false,'兩次都逾時：照實記錄，不補');assert.match(by['5289'].error,/step_timeout/);assert.equal(globalThis.__v249gate['5289'],2,'只重試一次');
+  assert.equal(globalThis.__v249gate['2404'],1,'沒逾時的不重跑');
+  assert.equal(result.gateAudits.filter(a=>a.recorded).length,result.gateAudits.length-1);
+});
