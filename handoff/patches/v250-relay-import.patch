+      }
+    }catch(error){result.status='error';result.error=String(error?.message||error).slice(0,240);}
+  }
+  run.relayImport.groups=[...(run.relayImport.groups||[]).filter(g=>g.id!==group.id),result];
+  if(index>=RELAY_IMPORT_GROUPS.length){run.relayImport.status=run.relayImport.groups.some(g=>g.status==='error')?'partial':'ok';return null;}
+  return index+1;
+}
