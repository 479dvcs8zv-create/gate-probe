+  if(!relay.manifest)return `讀不到中繼清單（${relay.error||'未知'}）；本輪照舊由網站自己抓。`;
+  const groups=(relay.groups||[]).map(g=>`${RELAY_GROUP_NAMES[g.id]||g.id}${RELAY_STATUS_NAMES[g.status]||g.status}${g.error?`（${g.error}）`:''}`).join('、');
+  return `中繼收集時間 ${relay.manifest.generatedAt}；${groups||'未匯入'}${relay.manifest.collectorErrors?.length?`；收集端回報 ${relay.manifest.collectorErrors.length} 項失敗`:''}。`;
+}
+const RELAY_IMPORT_GROUPS=[{id:'market',kinds:['universe','market']},{id:'series',kinds:['series']},{id:'statistics',kinds:['statistics']},{id:'cpi',kinds:['cpi']},{id:'sources',kinds:['sources']},{id:'news',kinds:['news']}];
+async function fetchRelayOfficialText(name,timeoutMs=8000){
+  const controller=new AbortController(),timer=setTimeout(()=>controller.abort(),timeoutMs);
+  try{const response=await fetch(RELAY_OFFICIAL_IMPORT_BASE+name,{signal:controller.signal,headers:{Accept:'application/json'}});if(!response.ok)throw Error(`中繼 ${name} HTTP ${response.status}`);return await response.text();}
