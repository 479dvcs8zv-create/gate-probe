+const RELAY_OFFICIAL_IMPORT_BASE='https://raw.githubusercontent.com/wcr0936531039-png/macro-relay-service/official-import/';
+const RELAY_OFFICIAL_IMPORT_KEY='relay-official-import:v1';
+const RELAY_IMPORT_KINDS=['universe','market','series','statistics','cpi','sources','news'];
+// 預設關閉；網站環境變數 RELAY_OFFICIAL_IMPORT_ENABLED=true 才在巡檢開頭匯入（可隨時關掉，網站照舊自己抓＋人工匯入）。
