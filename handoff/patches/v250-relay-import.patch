+function validRelayOfficialManifest(manifest,now=Date.now()){
+  const generated=Date.parse(manifest?.generatedAt||'');
+  if(manifest?.schema_version!==1||!Number.isFinite(generated)||generated>now+300000||now-generated>36*3600000||!Array.isArray(manifest.parts))return null;
