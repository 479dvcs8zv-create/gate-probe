+        const calls=relayImportBodies(group.id,parts,bodies),responses=[];
+        for(const body of calls){
+          const response=await officialDataImport(new Request('https://site.internal/api/official-data-import',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}),env),json=await response.json().catch(()=>({}));
+          responses.push({http:response.status,ok:json.ok===true});
+          if(!response.ok||json.ok!==true)throw Error(`匯入被拒 HTTP ${response.status}：${json.error||'未知'}`);
+        }
+        await writeRuntimeCache(env,RELAY_OFFICIAL_IMPORT_KEY,{parts:{...(saved.parts||{}),...Object.fromEntries(parts.map(p=>[p.name,p.sha256]))},updatedAt:new Date().toISOString(),generatedAt:manifest.generatedAt},30*86400000);
