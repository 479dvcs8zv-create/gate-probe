+const source=fs.readFileSync(new URL('../dist/server/index.js',import.meta.url),'utf8');
+const RELAY='https://raw.githubusercontent.com/wcr0936531039-png/macro-relay-service/official-import/';
+const sha=text=>crypto.createHash('sha256').update(text).digest('hex');
+let serial=0;
+
+function bundle(parts,{generatedAt=new Date(Date.now()-3600000).toISOString(),tamper}={}){
+  const files={},manifest={schema_version:1,generatedAt,window:'test',collector:{repo:'macro-relay-service'},parts:[],errors:[{source:'BLS-core-CPI',error:'HTTP 403'}]};
+  for(const p of parts){const text=JSON.stringify(p.body);files[p.name]=tamper===p.name?text.replace('}',',"x":1}'):text;manifest.parts.push({name:p.name,kind:p.kind,sha256:sha(text),bytes:text.length});}
+  files['manifest.json']=JSON.stringify(manifest);return files;
+}
+const snapshot=date=>({name:`${date}.json`,kind:'market',body:{schema_version:1,marketSnapshots:[{date,rows:[{id:'2330'}]}]}});
+const fullParts=()=>[
+  {name:'universe.json',kind:'universe',body:{schema_version:1,issuerUniverse:{asOf:'2026-11-02',rows:[{id:'2330'}]}}},
+  ...['2026-10-22','2026-10-23','2026-10-26','2026-10-27','2026-10-28','2026-10-29','2026-10-30'].map(snapshot),
+  {name:'series.json',kind:'series',body:{schema_version:1,series:['DCOILBRENTEU','DHHNGSP','DEXJPUS','DCOILWTICO','IORB','US3M','US10Y','US30Y','DTWEXAFEGS'].map(id=>({id,history:[]}))}},
+  {name:'cpi.json',kind:'cpi',body:{schema_version:1,coreCpiSources:[],coreCpiFailures:[{source:'BLS-core-CPI',error:'HTTP 403'}]}},
+  {name:'news.json',kind:'news',body:{schema_version:1,officialNewsCapture:{capturedAt:new Date().toISOString(),feeds:[]}}},
+];
+
+class DB{
+  rows=new Map();leases=new Map();
+  prepare(sql){const lease=refreshLeaseStatement(this,sql);if(lease)return lease;return {run:async()=>({success:true}),bind:(...args)=>({all:async()=>({results:this.rows.has(args[0])?[this.rows.get(args[0])]:[]}),run:async()=>{this.rows.set(args[0],{payload:args[1],updated_at:args[2],expires_at:args[3]});return {success:true};}})};}
+}
+const hooks=`
+ captureFullMarketSnapshot=async()=>{globalThis.__v250.order.push('scanner');return {status:'collecting_history',date:'2026-10-30',sessions:76,captured:{total:600},universe:{total:600}};};
+ runSiteModule=async id=>({id,status:'ok',usable:1,total:1,observations:[]});
+ refreshSiteStock=async row=>({id:row.id,name:row.name,status:'fresh'});
+ stockSourceResearchResponse=async request=>Response.json({status:'ok',records:[]});
+ masterModelResponse=async request=>Response.json({status:'valuation_divergence',auditStatus:'blocked',symbol:new URL(request.url).searchParams.get('id'),gates:[]});
+ officialDataImport=async(request,env)=>{const body=await request.json();globalThis.__v250.imports.push(body);globalThis.__v250.order.push('import');
+   const reason=globalThis.__v250.reject?.(body);return reason?Response.json({error:reason},{status:422}):Response.json({ok:true});};
+`;
+async function patrol(env,files,reject){
+  globalThis.__v250={imports:[],order:[],fetched:[],reject};
+  const oldFetch=globalThis.fetch;
+  globalThis.fetch=async(input,init)=>{const url=String(input?.url||input);if(!url.startsWith(RELAY))return oldFetch(input,init);
+    const name=url.slice(RELAY.length);globalThis.__v250.fetched.push(name);
+    return files&&Object.hasOwn(files,name)?new Response(files[name],{headers:{'Content-Type':'text/plain'}}):new Response('404: Not Found',{status:404});};
+  try{
+    const request=(path='status')=>new Request('https://site.test/api/automation/'+path,{method:path==='refresh-all'?'POST':'GET'});
+    const load=()=>import('data:text/javascript;base64,'+Buffer.from(source+hooks+`\n// v250-${serial++}`).toString('base64'));
+    await (await load()).default.fetch(request('refresh-all'),env,{});
+    let result;for(let i=0;i<80&&!result?.completedAt;i++)result=await (await (await load()).default.fetch(request(),env,{})).json();
+    assert.ok(result.completedAt,'巡檢跑完');return result;
+  }finally{globalThis.fetch=oldFetch;}
+}
+const coverage=result=>result.coverage.find(row=>row.id==='officialImport');
+
+test('中繼清單驗證：格式、36 小時、檔名、雜湊、重複、行情檔名必須是日期',async()=>{
+  const api=await import('data:text/javascript;base64,'+Buffer.from(source+`\nexport {validRelayOfficialManifest,relayOfficialImportEnabled};\n// v250-m`).toString('base64'));
+  const now=Date.parse('2026-11-03T00:00:00Z'),good={schema_version:1,generatedAt:'2026-11-02T08:30:00Z',parts:[{name:'2026-11-02.json',kind:'market',sha256:'a'.repeat(64),bytes:10},{name:'series.json',kind:'series',sha256:'b'.repeat(64)}],errors:[]};
+  assert.equal(api.validRelayOfficialManifest(good,now).parts.length,2);
+  const bad=patch=>api.validRelayOfficialManifest({...good,...patch},now);
+  assert.equal(bad({schema_version:2}),null);
+  assert.equal(bad({generatedAt:'2026-11-01T11:00:00Z'}),null,'超過 36 小時不匯入');
+  assert.equal(bad({generatedAt:'2026-11-03T01:00:00Z'}),null,'未來時間不匯入');
+  assert.equal(bad({parts:[{name:'../x.json',kind:'series',sha256:'a'.repeat(64)}]}),null);
+  assert.equal(bad({parts:[{name:'series.json',kind:'series',sha256:'xyz'}]}),null);
+  assert.equal(bad({parts:[{name:'series.json',kind:'companies',sha256:'a'.repeat(64)}]}),null,'只收固定幾類');
+  assert.equal(bad({parts:[{name:'latest.json',kind:'market',sha256:'a'.repeat(64)}]}),null);
+  assert.equal(bad({parts:[good.parts[1],good.parts[1]]}),null);
+  assert.equal(bad({parts:[]}),null);
+  assert.equal(api.relayOfficialImportEnabled({}),false,'預設關閉');
+  assert.equal(api.relayOfficialImportEnabled({RELAY_OFFICIAL_IMPORT_ENABLED:'true'}),true);
+});
+
+test('未啟用：巡檢不碰中繼、沒有匯入紀錄，與 v249 相同',async()=>{
+  const result=await patrol({DB:new DB()},bundle(fullParts()));
+  assert.deepEqual(globalThis.__v250.fetched,[]);assert.deepEqual(globalThis.__v250.imports,[]);
+  assert.equal(result.relayImport,undefined);assert.equal(coverage(result),undefined);
+});
+
+test('啟用：掃描前先匯入；行情每次最多 5 天、名冊只送一次；總經 9 條分兩批；沒收到的類別照實標示；第二次清單沒變就不重匯',async()=>{
+  const env={DB:new DB(),RELAY_OFFICIAL_IMPORT_ENABLED:'true'},files=bundle(fullParts());
+  const result=await patrol(env,files),imports=globalThis.__v250.imports;
+  assert.equal(globalThis.__v250.order.indexOf('scanner'),globalThis.__v250.order.lastIndexOf('import')+1,'全部匯入完才掃描');
+  const market=imports.filter(b=>b.marketSnapshots);
+  assert.deepEqual(market.map(b=>b.marketSnapshots.map(s=>s.date)),[['2026-10-22','2026-10-23','2026-10-26','2026-10-27','2026-10-28'],['2026-10-29','2026-10-30']]);
+  assert.ok(market[0].issuerUniverse);assert.equal(market[1].issuerUniverse,undefined,'名冊只送一次');
+  assert.deepEqual(imports.filter(b=>b.series).map(b=>b.series.length),[5,4]);
+  assert.equal(imports.filter(b=>b.coreCpiSources).length,1);assert.equal(imports.filter(b=>b.officialNewsCapture).length,1);
+  assert.ok(imports.every(b=>b.schema_version===1));
+  const groups=Object.fromEntries(result.relayImport.groups.map(g=>[g.id,g.status]));
+  assert.deepEqual(groups,{market:'imported',series:'imported',statistics:'not_in_bundle',cpi:'imported',sources:'not_in_bundle',news:'imported'});
+  assert.equal(result.relayImport.status,'ok');assert.equal(coverage(result).status,'automatic');
+  assert.match(coverage(result).detail,/信用統計這次沒收到/);assert.match(coverage(result).detail,/收集端回報 1 項失敗/);
+  const history=JSON.parse(env.DB.rows.get('site-auto-refresh-history:v1').payload);
+  assert.equal(history.runs.at(-1).relayImport.groups.market,'imported');
+  const again=await patrol(env,files);
+  assert.deepEqual(globalThis.__v250.imports,[],'同一份清單不重匯');assert.deepEqual(globalThis.__v250.fetched,['manifest.json'],'只讀清單');
+  assert.ok(again.relayImport.groups.filter(g=>g.status!=='not_in_bundle').every(g=>g.status==='unchanged'));
+  assert.equal(again.relayImport.status,'ok');
+});
+
+test('雜湊不符或匯入被拒：只有那一組記失敗、不記雜湊，其他組照常；下一次巡檢會重試',async()=>{
+  const env={DB:new DB(),RELAY_OFFICIAL_IMPORT_ENABLED:'true'};
+  const parts=fullParts();
