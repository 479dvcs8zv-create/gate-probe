diff --git a/tests/v235-hotfix.test.mjs b/tests/v235-hotfix.test.mjs
new file mode 100644
index 0000000..48143ce
--- /dev/null
+++ b/tests/v235-hotfix.test.mjs
@@ -0,0 +1,55 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {deflateRawSync,crc32} from 'node:zlib';
+const source=readFileSync(new URL('../dist/server/index.js',import.meta.url),'utf8');
+const api=await import('data:text/javascript;base64,'+Buffer.from(source+'\nexport {attachPanelSources,loadExpandedSeries};').toString('base64'));
+
+function fakeDb(){const rows=new Map();return {prepare(sql){let args=[];const stmt={bind(...a){args=a;return stmt;},async run(){if(/^INSERT INTO site_runtime_cache/.test(sql))rows.set(args[0],{payload:args[1],updated_at:args[2],expires_at:args[3]});return {success:true,meta:{changes:1}};},async all(){const r=/FROM site_runtime_cache/.test(sql)?rows.get(args[0]):null;return {results:r?[r]:[]};}};return stmt;},rows};}
+const hang=(init)=>new Promise((_,reject)=>init?.signal?.addEventListener('abort',()=>reject(init.signal.reason||Error('aborted'))));
+
+test('v235 巡檢逾時修正：面板來源同時抓，整體 7 秒內回來；慢的項目顯示讀取中，不拖住 Gate 審計',async()=>{
+  const previous=globalThis.fetch;
+  globalThis.fetch=async(url,init)=>{
+    const u=String(url);
+    if(/t187ap03|tpex_mainboard|TWT93U|SBL|sbl|margin_sbl/i.test(u))return new Response('[]',{status:404});
+    return hang(init); // 櫃買、觀測站、集保、證交所行情全部卡住
+  };
+  try{
+    const stock={id:'8299',price:{date:'2026-10-22',value:1880},priceHistory:[],panelInputs:{}};
+    const started=Date.now(),out=await api.attachPanelSources(stock,{DB:fakeDb()}),elapsed=Date.now()-started;
+    assert.ok(elapsed<9000,`returned in ${elapsed} ms`);
+    const p=out.panelInputs;
+    assert.equal(p.cbRegistry.status,'pending');assert.equal(p.cbRegistry.monthly.status,'pending');
+    assert.equal(p.holders.reason,'TDCC_STILL_LOADING');assert.equal(p.marginMaintenance.reason,'MARGIN_MAINTENANCE_STILL_LOADING');
+    assert.equal(p.marginMaintenance.scoreContribution,0);
+  }finally{globalThis.fetch=previous;}
+});
+
+// Header and rows copied from the NDC open-data ZIP (景氣指標及燈號, 領先指標構成項目.csv) fetched 2026-10-25.
+const HEADER='"Date","外銷訂單動向指數(以家數計)","貨幣總計數M1B(百萬元)","股價指數(Index1966=100)","工業及服務業受僱員工淨進入率(%)","建築物開工樓地板面積(住宅類住宅、商業辦公、工業倉儲)(千平方公尺)","名目半導體設備進口(新臺幣百萬元)"';
+const CSV='﻿'+[HEADER,'202607,48.8,30530948,44366.29,0.49,1696.495,149586','202608,49.68,30750789,45124.96143,,1569.338,132457'].join('\r\n')+'\r\n';
+function zip(name,text){
+  const nameBytes=Buffer.from(name,'utf8'),raw=Buffer.from(text,'utf8'),data=deflateRawSync(raw),crc=crc32(raw);
+  const local=Buffer.alloc(30);local.writeUInt32LE(0x04034b50,0);local.writeUInt16LE(20,4);local.writeUInt16LE(0x0808,6);local.writeUInt16LE(8,8);local.writeUInt16LE(nameBytes.length,26);
+  const desc=Buffer.alloc(16);desc.writeUInt32LE(0x08074b50,0);desc.writeUInt32LE(crc>>>0,4);desc.writeUInt32LE(data.length,8);desc.writeUInt32LE(raw.length,12);
+  const central=Buffer.alloc(46);central.writeUInt32LE(0x02014b50,0);central.writeUInt16LE(20,4);central.writeUInt16LE(20,6);central.writeUInt16LE(0x0808,8);central.writeUInt16LE(8,10);central.writeUInt32LE(crc>>>0,16);central.writeUInt32LE(data.length,20);central.writeUInt32LE(raw.length,24);central.writeUInt16LE(nameBytes.length,28);
+  const cd=Buffer.concat([central,nameBytes]),end=Buffer.alloc(22),offset=30+nameBytes.length+data.length+16;end.writeUInt32LE(0x06054b50,0);end.writeUInt16LE(1,8);end.writeUInt16LE(1,10);end.writeUInt32LE(cd.length,12);end.writeUInt32LE(offset,16);
+  return Buffer.concat([local,nameBytes,data,desc,cd,end]);
+}
+
+test('v235 讀回④修正：外部排程快照裡的經濟部舊值（62.36%、403 過期）不能蓋過國發會擴散指數',async()=>{
+  const previous=globalThis.fetch,previousNow=Date.now;
+  // The relay entry exactly as published in macro-relay-service data/keyless_snapshot.json on 2026-10-26.
+  const relay={schema_version:1,generated_at:'2026-10-25T20:58:00Z',series:{TW_EXPORT_ORDERS:{value:62.36,date:'2026-09-01',unit:'%',status:'stale',provider:'經濟部統計處｜外銷訂單統計',source:'https://service.moea.gov.tw/EE521/common/Common.aspx?code=B&no=1',history:[{date:'2026-09-01',value:62.36}],fetched_at:'2026-10-21T21:49:35.183199+00:00',max_age_days:85,error:'HTTP Error 403: Forbidden'}}};
+  try{
+    Date.now=()=>Date.parse('2026-10-26T00:00:00Z');
+    globalThis.fetch=async url=>{const u=String(url);
+      if(u.includes('keyless_snapshot.json'))return new Response(JSON.stringify(relay),{status:200});
+      if(u.startsWith('https://ws.ndc.gov.tw/Download.ashx?'))return new Response(zip('領先指標構成項目.csv',CSV),{status:200});
+      return new Response('not found',{status:404});};
+    const row=await api.loadExpandedSeries('TW_EXPORT_ORDERS');
+    assert.equal(row.value,49.68);assert.equal(row.date,'2026-08-01');assert.equal(row.unit,'指數（50＝持平）');
+    assert.equal(row.scoring,'pending_threshold_approval');assert.doesNotMatch(String(row.provider||''),/經濟部/);
+  }finally{globalThis.fetch=previous;Date.now=previousNow;}
+});
