+// 面板資料來源同時抓、整體最多等 PANEL_SOURCE_BUDGET_MS；沒趕上的項目顯示「讀取中」，背景任務完成後寫入快取，下次直接用。
+// （v235 巡檢：逐項依序等待＋櫃買逾時，讓每檔 Gate 審計超過 16 秒步驟上限。）
+const PANEL_SOURCE_BUDGET_MS=7000;
+function panelWithin(task,fallback,ms=PANEL_SOURCE_BUDGET_MS){
+  let timer;
+  const guarded=Promise.resolve().then(task).catch(()=>fallback('failed'));
+  return Promise.race([guarded,new Promise(resolve=>{timer=setTimeout(()=>resolve(fallback('loading')),ms);})]).finally(()=>clearTimeout(timer));
