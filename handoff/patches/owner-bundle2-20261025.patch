+/** 上市大盤融資維持率（估算）＝Σ個股融資今日餘額(張)×1000×同日收盤價 ÷ 融資金額。兩份官方報表必須同一交易日。 */
+export const TWSE_STOCK_DAY_ALL_URL='https://openapi.twse.com.tw/v1/exchangeReport/STOCK_DAY_ALL';
+export function computeMarginMaintenance(prices,margin){
+  if(!Array.isArray(prices)||!prices.length)throw Error('PRICE_SCHEMA');
