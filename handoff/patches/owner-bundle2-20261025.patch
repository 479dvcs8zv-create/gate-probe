+export const TPEX_CB_MONTHLY_INDEX_URL='https://www.tpex.org.tw/www/zh-tw/bond/cbnote?response=json';
+const CBTRN_URL=/^https:\/\/mopsov\.twse\.com\.tw\/nas\/t120\/CBTRN(\d{4})(\d{2})\.htm$/;
+export function latestCbMonthlyFile(json){
+  const rows=json?.stat==='ok'?json.tables?.[0]?.data:null;
+  if(!Array.isArray(rows))throw Error('CB_MONTHLY_INDEX_SCHEMA');
+  const files=rows.map(r=>{const url=String(r?.[1]||'').trim(),m=url.match(CBTRN_URL);return m?{url,month:`${m[1]}-${m[2]}`}:null;}).filter(Boolean).sort((a,b)=>b.month.localeCompare(a.month));
