diff --git a/tests/v248-sources.test.mjs b/tests/v248-sources.test.mjs
new file mode 100644
index 0000000..7074cbb
--- /dev/null
+++ b/tests/v248-sources.test.mjs
@@ -0,0 +1,82 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+
+// 擁有者 2026-10-29 15:35「好」：修 GPT 10/29 讀回的三個問題。
+// 1. 貴金屬第三來源 GoldPriceZone 10/29 起 HTTP 404 → 改 Swissquote 公開報價（回應取自 GitHub 實抓，gate-probe url-probe 40836485164）。
+// 2. 信用七欄只看得到 verifiedAt → 直接讀回與巡檢摘要都列出原始抓取時間與是否延後抓取。
+// 3. 6898、6938 於 10/23 上櫃，官方名冊 10/28 才收錄，前兩天行情沒收進來 → 列出缺的交易日；補抓後即算新股暖機。
+const source=readFileSync(new URL('../dist/server/index.js',import.meta.url),'utf8');
+let n=0;
+const load=names=>import('data:text/javascript;base64,'+Buffer.from(source+`\n// v248-${n++}\nexport {${names}};`).toString('base64'));
+const XAU=JSON.parse(readFileSync(new URL('./fixtures/swissquote-xau-20261029.json',import.meta.url),'utf8'));
+const XAG=JSON.parse(readFileSync(new URL('./fixtures/swissquote-xag-20261029.json',import.meta.url),'utf8'));
+
+function metalsFetch({swissquote='ok',standard='ok'}={}){
+  const calls=[];const at=XAU[0].ts;
+  globalThis.fetch=async url=>{const u=new URL(String(url));calls.push(u.hostname);
+    if(u.hostname==='api.gold-api.com'){const symbol=u.pathname.split('/').at(-1);return Response.json({currency:'USD',symbol,price:symbol==='XAU'?4030.1:52.83,updatedAt:new Date(at-60000).toISOString()});}
+    if(u.hostname==='standardbullion.com'){if(standard!=='ok')return new Response('down',{status:503});return Response.json({unit:'USD per troy ounce',updated:new Date(at-120000).toISOString(),metals:[{symbol:'XAU',bid:4029.5,ask:4031.5},{symbol:'XAG',bid:52.80,ask:52.86}]});}
+    if(u.hostname==='forex-data-feed.swissquote.com'){if(swissquote==='404')return new Response('not found',{status:404});return Response.json(u.pathname.includes('/XAU/')?XAU:XAG);}
+    if(u.hostname==='goldpricezone.com')throw Error('the retired GoldPriceZone source must not be called');
+    return new Response('unexpected',{status:500});
+  };
+  return calls;
+}
+const realFetch=globalThis.fetch,realNow=Date.now;
+test.afterEach(()=>{globalThis.fetch=realFetch;Date.now=realNow;});
+
+test('貴金屬第三來源改 Swissquote：用實抓格式取買賣價中間價（點差最小的一檔）；三來源核對照舊',async()=>{
+  const api=await load('loadPreciousMetal');Date.now=()=>XAU[0].ts+30000;
+  const calls=metalsFetch();
+  const gold=await api.loadPreciousMetal('XAU','黃金現貨參考價（XAU/USD）');
+  assert.ok(calls.includes('forex-data-feed.swissquote.com'));assert.ok(!calls.includes('goldpricezone.com'));
+  const sq=gold.sourceVerification.readings.find(r=>r.sourceId==='swissquote');
+  const tightest=XAU[0].spreadProfilePrices.map(q=>({bid:q.bid,ask:q.ask})).sort((a,b)=>(a.ask-a.bid)-(b.ask-b.bid))[0];
+  assert.equal(sq.value,(tightest.bid+tightest.ask)/2);assert.equal(sq.observedAt,new Date(XAU[0].ts).toISOString());
+  assert.equal(gold.status,'ok');assert.equal(gold.sourceVerification.channelsAvailable,3);assert.match(gold.provider,/Swissquote/);
+  // 兩來源（Gold API＋Swissquote）在 Standard Bullion 掛掉時仍可核對通過
+  metalsFetch({standard:'down'});
+  const silver=await api.loadPreciousMetal('XAG','白銀現貨參考價（XAG/USD）');
+  assert.equal(silver.status,'ok');assert.deepEqual(silver.sourceVerification.winningPair.sourceIds.sort(),['gold-api','swissquote']);
+  // 來源壞掉時，錯誤訊息寫 Swissquote，不再寫 GoldPriceZone
+  metalsFetch({swissquote:'404'});
+  const fallback=await api.loadPreciousMetal('XAU','黃金現貨參考價（XAU/USD）');
+  assert.ok(fallback.sourceVerification.errors.some(e=>/^Swissquote：Swissquote HTTP 404$/.test(e)),JSON.stringify(fallback.sourceVerification.errors));
+});
+
+function fakeDb(rows){return {prepare(sql){let args=[];const stmt={bind(...a){args=a;return stmt;},async run(){return {success:true,meta:{changes:1}};},async all(){const r=rows.get(args[0]);return {results:r?[r]:[]};}};return stmt;}};}
+test('信用欄位：延後抓取時也列出原始抓取時間（capturedAt）與依據；巡檢摘要逐列保存同樣的時間',async()=>{
+  const api=await load('retainedTaiwanCreditRows,summarizeSiteModule');
+  const captured='2026-10-28T14:43:41.618Z',now=Date.parse('2026-10-28T23:30:00Z');
+  const row={id:'TWSE_MARGIN_BALANCE_NTD',name:'融資餘額',unit:'億元',group:'台股市場',value:6322.99,date:'2026-10-28',status:'ok',source:'https://www.twse.com.tw/rwd/zh/marginTrading/MI_MARGN?date=20261028&selectType=MS&response=json',fetchedAt:captured,verifiedAt:captured};
+  const rows=new Map([['macro-market:v7',{payload:JSON.stringify({checkedAt:captured,rows:[row]}),updated_at:captured,expires_at:new Date(now+3600000).toISOString()}]]);
+  const out=await api.retainedTaiwanCreditRows({DB:fakeDb(rows)},now);
+  const margin=out.find(r=>r.id==='TWSE_MARGIN_BALANCE_NTD');
+  assert.equal(margin.capturedAt,captured);assert.equal(margin.capturedAtBasis,'fetchedAt');assert.equal(margin.verifiedAt,captured);assert.equal(margin.captureDeferred,true);
+  const summary=api.summarizeSiteModule('marketAndPreciousMetals',{checkedAt:new Date(now).toISOString(),rows:out});
+  const obs=summary.observations.find(r=>r.id==='TWSE_MARGIN_BALANCE_NTD');
+  assert.equal(obs.capturedAt,captured);assert.equal(obs.verifiedAt,captured);assert.equal(obs.captureDeferred,true,'摘要可與直接讀回逐欄比對');
+});
+
+test('新股（官方名冊晚收錄）：列出掛牌後缺的交易日；補抓後即算新股暖機，不影響產業覆蓋',async()=>{
+  const api=await load('summarizeMarketSnapshotHistory,verifiedScannerWarmups');
+  const dates=Array.from({length:25},(_,i)=>new Date(Date.UTC(2026,8,20)+i*86400000).toISOString().slice(0,10));
+  const base=Array.from({length:30},(_,i)=>({id:String(6100+i),name:'既有'+i,industry:'資訊服務業',market:'tpex'}));
+  const listing=dates[22],newbie={id:'6898',name:'程曦資訊',industry:'資訊服務業',market:'tpex'};
+  const snap=(date,{withNewbie})=>({date,quoteBasis:'exchange-openapi-v1',universeAsOf:date,rows:[...base,...(withNewbie?[newbie]:[])].map((r,k)=>({...r,close:50+k,change:0.1,volume:100000+k*10,amount:5e6}))});
+  const roster=[...base.map(r=>({...r})),{...newbie,listingDate:listing,listingSource:'https://www.tpex.org.tw/openapi/v1/mopsfin_t187ap03_O'}];
+  // 名冊 10/28（最後一天）才收錄：掛牌後前兩個交易日沒有這檔
+  const lagged=dates.map((d,i)=>snap(d,{withNewbie:i===24}));
+  const before=api.summarizeMarketSnapshotHistory(lagged,dates[24],roster);
+  const gap=before.historyGaps.find(g=>g.id==='6898');
+  assert.equal(gap.reason,'new_listing_warmup');assert.equal(gap.sessionsSinceListing,3);assert.equal(gap.observations,1);assert.equal(gap.missingObservations,2);
+  assert.deepEqual(gap.missingDates,[dates[22],dates[23]]);
+  assert.equal(api.verifiedScannerWarmups(before).length,0,'缺日沒補，不能當暖機');
+  // 收集器以目前名冊重抓最近幾個交易日（--sessions 5）後
+  const backfilled=dates.map((d,i)=>snap(d,{withNewbie:i>=22}));
