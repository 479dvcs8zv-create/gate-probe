+  return {id:'9999',price:{date:asOf,value:closes.at(-1)},technical:{historyState:'DATED_HISTORY'},
+    priceHistory:dates.map((date,i)=>({date,close:closes[i]})),
+    marketActivity:{institutionalHistory:(flows||[]).map((f,i,a)=>({date:dates[dates.length-a.length+i],foreign:f[0],trust:f[1],dealer:0,net:f[0]+f[1]}))},
+    panelInputs:{lending:lending?{history:lending.map((b,i,a)=>({date:dates[dates.length-a.length+i],balanceShares:b}))}:{status:'insufficient',history:[]},
+      revenueHistory:revenue||[]}};
+}
+const rising=n=>Array.from({length:n},(_,i)=>100+i);
+const rev=(rows)=>rows.map(([y,m,v,c])=>({revenue_year:y,revenue_month:m,revenue:v,create_time:c||null}));
+
+test('technical: six sessions under a falling 60-day line fails; above the line passes; short history is insufficient',()=>{
+  const down=[...rising(70),...Array.from({length:8},(_,i)=>120-i*3)];
+  const t=threeQuestions(makeStock({closes:down})).questions.technical;
+  assert.equal(t.result,'fail');assert.ok(t.daysBelowMa60>5);assert.equal(t.ma60Falling,true);
+  assert.equal(threeQuestions(makeStock({closes:rising(80)})).questions.technical.result,'pass');
+  const short=threeQuestions(makeStock({closes:rising(65)})).questions.technical;
+  assert.equal(short.result,'insufficient');assert.equal(short.reason,'REQUIRE_66_OBSERVED_SESSIONS');
+});
+
+test('technical: five sessions under the line is not yet a fail (rule says more than five)',()=>{
+  const closes=[...rising(75),...Array.from({length:5},()=>100)];
+  const t=threeQuestions(makeStock({closes})).questions.technical;
+  assert.equal(t.daysBelowMa60,5);assert.equal(t.result,'pass');
+});
+
+test('chips: zero buying by foreign plus trust over 5 and 10 sessions fails even without lending history',()=>{
+  const flows=Array.from({length:20},()=>[-1000,200]);
+  const c=threeQuestions(makeStock({closes:rising(80),flows})).questions.chips;
+  assert.equal(c.result,'fail');assert.equal(c.zeroBuy,true);assert.equal(c.lendingHigh20,null);
+  assert.equal(c.windows.d5.combinedShares,-4000);assert.equal(c.windows.d20.combinedShares,-16000);
+  assert.ok(c.basis.includes('-4張'));
+});
+
+test('chips: buying plus 21 aligned lending days without a new high passes; lending at a 20-day high fails',()=>{
+  const flows=Array.from({length:20},()=>[3000,500]);
+  const flat=Array.from({length:21},(_,i)=>i===5?9000:5000);
+  assert.equal(threeQuestions(makeStock({closes:rising(80),flows,lending:flat})).questions.chips.result,'pass');
+  const high=Array.from({length:21},(_,i)=>5000+i);
+  const c=threeQuestions(makeStock({closes:rising(80),flows,lending:high})).questions.chips;
+  assert.equal(c.result,'fail');assert.equal(c.lendingHigh20,true);
+});
+
+test('chips: buying but short lending history stays insufficient, never assumed safe',()=>{
+  const flows=Array.from({length:20},()=>[3000,500]);
+  const c=threeQuestions(makeStock({closes:rising(80),flows,lending:[5000,5100,5200]})).questions.chips;
+  assert.equal(c.result,'insufficient');assert.equal(c.lendingObservations,3);
+});
+
+test('chips: institutional dates that do not match price dates are not used',()=>{
+  const s=makeStock({closes:rising(80),flows:Array.from({length:12},()=>[-1000,0])});
+  s.marketActivity.institutionalHistory=s.marketActivity.institutionalHistory.map(r=>({...r,date:'2026-01-0'+(1+Number(r.date.slice(-1))%9)}));
+  const c=threeQuestions(s).questions.chips;
+  assert.equal(c.windows.d5,null);assert.equal(c.result,'insufficient');
+});
+
+test('fundamental: negative YoY fails, positive passes, missing base month or future publication is excluded',()=>{
+  const closes=rising(80),asOf=sessions(80).at(-1);
+  const base=[[2025,7,100],[2026,7,90]];
+  assert.equal(threeQuestions(makeStock({closes,revenue:rev(base)})).questions.fundamental.result,'fail');
+  assert.equal(threeQuestions(makeStock({closes,revenue:rev([[2025,7,100],[2026,7,130]])})).questions.fundamental.result,'pass');
+  assert.equal(threeQuestions(makeStock({closes,revenue:rev([[2026,7,130]])})).questions.fundamental.result,'insufficient');
+  const future=rev([[2025,7,100],[2026,7,130],[2025,8,100],[2026,8,50,'2099-01-01']]);
+  const f=threeQuestions(makeStock({closes,revenue:future})).questions.fundamental;
+  assert.equal(f.period,'2026-07');assert.equal(f.result,'pass');assert.equal(f.guidanceChecked,false);
+  assert.ok(asOf>='2026-08-01');
+});
+
+test('panels carry the three questions with zero score contribution and the page shows them',()=>{
+  const stock=makeStock({closes:[...rising(70),...Array.from({length:8},(_,i)=>120-i*3)],flows:Array.from({length:20},()=>[-1000,0]),revenue:rev([[2025,7,100],[2026,7,130]])});
+  const panels=buildStockPanels(stock);
