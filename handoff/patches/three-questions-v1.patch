+  assert.equal(panels.threeQuestions.summary,'技術不過｜籌碼不過｜基本過');
+  class Element{constructor(){this.children=[];this.style={};this.attributes={};this.hidden=false;}append(...x){this.children.push(...x);}replaceChildren(...x){this.children=x;this.text='';}set textContent(v){this.text=String(v);this.children=[];}get textContent(){return (this.text||'')+this.children.map(x=>x.textContent||String(x)).join(' ');}setAttribute(k,v){this.attributes[k]=v;}}
+  const host=new Element(),context=vm.createContext({document:{getElementById:()=>host,createElement:()=>new Element()},console});
+  vm.runInContext(readFileSync(new URL('../worker/panel-display.js',import.meta.url),'utf8'),context);
+  context.model={symbol:'9999',report:{advisoryPanels:panels}};vm.runInContext('renderAdvisoryPanels(model)',context);
+  for(const label of ['汰弱留強三問','技術：不過','籌碼：不過','基本：過','只顯示，不改評級','資料不足不當成過'])assert.ok(host.textContent.includes(label),label);
+});
