+++ b/tests/dollar-axis.test.mjs
@@ -0,0 +1,43 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {dollarAxis,buildStockPanels} from '../worker/panel-calculations.mjs';
+import {buildAdvisoryDecision} from '../worker/advisory-decision.mjs';
+
+const days=(n,start='2026-08-03')=>Array.from({length:n},(_,i)=>new Date(Date.parse(start)+i*86400000).toISOString().slice(0,10));
+const input=(values,start)=>({id:'DTWEXAFEGS',history:days(values.length,start).map((date,i)=>({date,value:values[i]})),source:'https://fred.stlouisfed.org/graph/fredgraph.csv?id=DTWEXAFEGS',fetchedAt:'2026-10-24T14:00:00Z'});
+
+test('uses only observations at least 8 days old (same rule as the backtest)',()=>{
+  const flat=Array.from({length:60},(_,i)=>110+(i%5)*0.1);
+  const series=input([...flat,500],'2026-08-01'),last=series.history.at(-1).date;
+  const asOfSameWeek=new Date(Date.parse(last)+3*86400000).toISOString().slice(0,10);
+  const a=dollarAxis(series,{asOf:asOfSameWeek});
+  assert.equal(a.status,'ok');assert.notEqual(a.date,last);assert.ok(a.value<=0,'the spike is not yet known');
+  const later=new Date(Date.parse(last)+8*86400000).toISOString().slice(0,10);
+  const b=dollarAxis(series,{asOf:later});assert.equal(b.date,last);assert.ok(b.value>0);assert.equal(b.draftPoints,-1);
+});
+
+test('a weak dollar below the prior 20-day low gets 0, never a plus',()=>{
+  const values=[...Array.from({length:40},(_,i)=>120+(i%3)),90];
+  const s=input(values,'2026-08-01'),asOf=new Date(Date.parse(s.history.at(-1).date)+8*86400000).toISOString().slice(0,10);
+  const a=dollarAxis(s,{asOf});assert.ok(a.value<-100);assert.equal(a.draftPoints,0);assert.equal(a.scoreContribution,0);
+});
+
+test('missing, wrong series or stale observations stay insufficient',()=>{
+  assert.equal(dollarAxis(null,{asOf:'2026-10-22'}).status,'insufficient');
+  assert.equal(dollarAxis({id:'DTWEXBGS',history:[]},{asOf:'2026-10-22'}).reason,'DOLLAR_INDEX_NOT_IMPORTED');
+  const old=input(Array.from({length:40},(_,i)=>100+i),'2026-06-01');
+  assert.equal(dollarAxis(old,{asOf:'2026-10-22'}).reason,'DOLLAR_INDEX_OBSERVATION_STALE');
+  const short=input([100,101,102],'2026-10-01');
+  assert.equal(dollarAxis(short,{asOf:'2026-10-22'}).status,'insufficient');
+});
+
+test('panels use the imported series; the decision factor never adds a point for a weak dollar',()=>{
+  const values=[...Array.from({length:40},(_,i)=>120+(i%3)),90];
+  const di=input(values,'2026-08-20'),asOf=new Date(Date.parse(di.history.at(-1).date)+8*86400000).toISOString().slice(0,10);
+  const stock={id:'7788',price:{date:asOf},priceHistory:[],panelInputs:{dollarIndex:di},financialQuality:{}};
+  const panels=buildStockPanels(stock);
+  assert.equal(panels.dollarZeroAxis.status,'ok');assert.match(panels.dollarZeroAxis.label,/非 ICE DXY/);
+  const decision=buildAdvisoryDecision({stock,panels,existingRating:{available:true,grade:'C'},veto:{status:'unknown'},gates:[]});
+  const f=decision.globalFactors.find(x=>x.id==='dxy');
+  assert.equal(f.draftPoints,0);assert.equal(f.activeContribution,0);assert.match(f.rule,/走弱不加分/);
+});
