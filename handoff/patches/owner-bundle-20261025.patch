@@ -0,0 +1,42 @@
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {deflateRawSync,crc32} from 'node:zlib';
+const source=readFileSync(new URL('../dist/server/index.js',import.meta.url),'utf8');
+const api=await import('data:text/javascript;base64,'+Buffer.from(source+'\nexport {loadNdcExportOrderIndex,parseNdcExportOrderCsv,zipEntryText,SERIES};').toString('base64'));
+
+// Header and rows copied from the NDC open-data ZIP (景氣指標及燈號, 領先指標構成項目.csv) fetched 2026-10-25.
+const HEADER='"Date","外銷訂單動向指數(以家數計)","貨幣總計數M1B(百萬元)","股價指數(Index1966=100)","工業及服務業受僱員工淨進入率(%)","建築物開工樓地板面積(住宅類住宅、商業辦公、工業倉儲)(千平方公尺)","名目半導體設備進口(新臺幣百萬元)"';
+const CSV='﻿'+[HEADER,'202605,50.08,30618881,41932.916,0.09,1258.803,129635','202606,50.34,30748857,45392.44762,0.12,1266.127,192581','202607,48.8,30530948,44366.29,0.49,1696.495,149586','202608,49.68,30750789,45124.96143,,1569.338,132457'].join('\r\n')+'\r\n';
+
+function zip(files){
+  const locals=[],centrals=[];let offset=0;
+  for(const [name,text] of files){
+    const nameBytes=Buffer.from(name,'utf8'),raw=Buffer.from(text,'utf8'),data=deflateRawSync(raw),crc=crc32(raw);
+    const local=Buffer.alloc(30);local.writeUInt32LE(0x04034b50,0);local.writeUInt16LE(20,4);local.writeUInt16LE(0x0808,6);local.writeUInt16LE(8,8);local.writeUInt16LE(nameBytes.length,26);
+    const desc=Buffer.alloc(16);desc.writeUInt32LE(0x08074b50,0);desc.writeUInt32LE(crc>>>0,4);desc.writeUInt32LE(data.length,8);desc.writeUInt32LE(raw.length,12);
+    const central=Buffer.alloc(46);central.writeUInt32LE(0x02014b50,0);central.writeUInt16LE(20,4);central.writeUInt16LE(20,6);central.writeUInt16LE(0x0808,8);central.writeUInt16LE(8,10);central.writeUInt32LE(crc>>>0,16);central.writeUInt32LE(data.length,20);central.writeUInt32LE(raw.length,24);central.writeUInt16LE(nameBytes.length,28);central.writeUInt32LE(offset,42);
+    locals.push(local,nameBytes,data,desc);centrals.push(central,nameBytes);offset+=30+nameBytes.length+data.length+16;
+  }
+  const cd=Buffer.concat(centrals),end=Buffer.alloc(22);end.writeUInt32LE(0x06054b50,0);end.writeUInt16LE(files.length,8);end.writeUInt16LE(files.length,10);end.writeUInt32LE(cd.length,12);end.writeUInt32LE(offset,16);
+  return Buffer.concat([...locals,cd,end]);
+}
+
+assert.equal(api.SERIES.TW_EXPORT_ORDERS[2],'指數（50＝持平）');
+const history=api.parseNdcExportOrderCsv(CSV);
+assert.deepEqual(history.at(-1),{date:'2026-08-01',value:49.68});assert.equal(history.length,4);
+assert.throws(()=>api.parseNdcExportOrderCsv('"Date","其他"\n202608,1'),/欄位不符/);
+
+const archive=zip([['schema-領先指標構成項目.csv','"name","title"\n'],['領先指標構成項目.csv',CSV],['景氣指標與燈號.csv','"Date","景氣對策信號綜合分數"\n202608,41\n']]);
+assert.equal((await api.zipEntryText(new Uint8Array(archive),n=>n.includes('領先指標構成項目')&&!n.startsWith('schema'))).replace(/^﻿/,'').split(/\r?\n/)[0],HEADER);
+
+const previousFetch=globalThis.fetch,previousNow=Date.now;
+try{
+  Date.now=()=>Date.parse('2026-10-25T06:00:00Z');
+  globalThis.fetch=async url=>{assert.match(String(url),/^https:\/\/ws\.ndc\.gov\.tw\/Download\.ashx\?/);return new Response(archive,{status:200,headers:{'content-type':'application/zip'}});};
+  const row=await api.loadNdcExportOrderIndex();
+  assert.equal(row.id,'TW_EXPORT_ORDERS');assert.equal(row.value,49.68);assert.equal(row.date,'2026-08-01');assert.equal(row.status,'ok');
+  assert.equal(row.scoring,'pending_threshold_approval');assert.match(row.detail,/口徑不同/);assert.equal(row.history.length,4);
+  globalThis.fetch=async()=>new Response('not a zip',{status:200});
+  await assert.rejects(api.loadNdcExportOrderIndex(),/ZIP/);
+}finally{globalThis.fetch=previousFetch;Date.now=previousNow;}
+console.log('NDC export-order diffusion index: official ZIP parsed, 50-based index kept separate from old YoY thresholds, bad archives rejected');
diff --git a/tests/three-questions.test.mjs b/tests/three-questions.test.mjs
