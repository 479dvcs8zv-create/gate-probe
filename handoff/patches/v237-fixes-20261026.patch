diff --git a/tests/v237-cb-relay.test.mjs b/tests/v237-cb-relay.test.mjs
new file mode 100644
index 0000000..b3f8ec4
--- /dev/null
+++ b/tests/v237-cb-relay.test.mjs
@@ -0,0 +1,44 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {collectCbRegistry,collectCbMonthly,RELAY_CB_URL} from '../worker/panel-sources.mjs';
+import {convertibleBonds} from '../worker/panel-calculations.mjs';
+
+// v237 讀回：網站伺服器連不到櫃買（三次 failed、failedKinds=[all]、CB_MONTHLY_UNAVAILABLE）。
+// 改讀 GitHub 排程代抓的官方檔。fixture＝中繼 scripts/sync_cb.py 用 10-26 真實官方回應產生的輸出（抓取時間設為 2026-10-26T13:30Z）。
+const RELAY=JSON.parse(readFileSync(new URL('./fixtures/relay-cb-snapshot-20261026.json',import.meta.url),'utf8'));
+const NOW=Date.parse('2026-10-26T14:00:00Z');
+const memory=()=>{const store=new Map();return {read:async k=>store.has(k)?{fresh:true,payload:store.get(k)}:null,write:async(k,v)=>{store.set(k,v);return true;},store};};
+const relayOnly=(relay=RELAY)=>async url=>{if(String(url)===RELAY_CB_URL)return new Response(JSON.stringify(relay),{status:200});throw Error('TPEx unreachable from the site server');};
+
+test('櫃買直連失敗 → 讀 GitHub 代抓的官方登錄檔：群聯三＋兩檔海外債，標示來源與 SHA-256',async()=>{
+  const m=memory(),reg=await collectCbRegistry({read:m.read,write:m.write,fetchImpl:relayOnly(),now:NOW});
+  assert.equal(reg.status,'ok');assert.equal(reg.capturePath,'github_relay');assert.deepEqual(reg.errors,[]);
+  assert.ok(reg.sources.every(s=>s.capturePath==='github_relay'&&/^[0-9a-f]{64}$/.test(s.sha256)&&s.fetchedAt==='2026-10-26T13:30:00+00:00'));
+  const mine=reg.bonds.filter(b=>b.issuer==='8299');
+  assert.deepEqual(mine.map(b=>b.id).sort(),['82993','XS3364922461','XS3364929045']);
+  assert.ok(mine.every(b=>b.capturedAt==='2026-10-26T13:30:00+00:00'),'時間是代抓時間，不是網站讀取時間');
+  assert.ok(m.store.has('panel:cb-registry:v1:2026-10-26'),'成功後照常快取');
+});
+
+test('代抓檔超過 36 小時、或來源網址不對，就不用（不補值）',async()=>{
+  const old=structuredClone(RELAY);for(const p of Object.values(old.registries))p.fetched_at='2026-10-25T01:00:00+00:00';
+  const a=await collectCbRegistry({...memory(),fetchImpl:relayOnly(old),now:NOW});
+  assert.equal(a.status,'failed');assert.equal(a.bonds.length,0);
+  const wrong=structuredClone(RELAY);wrong.registries.domestic.source_url='https://example.com/bond_ISSBD5_data';
+  const b=await collectCbRegistry({...memory(),fetchImpl:relayOnly(wrong),now:NOW});
+  assert.equal(b.status,'partial');assert.ok(b.bonds.every(x=>x.kind==='overseas'));assert.ok(b.errors.some(e=>e.kind==='domestic'));
+});
+
+test('觀測站月報直連失敗 → 讀代抓的同一份月報：群聯三目前轉換價 2,468.8（115/07/06 重設）',async()=>{
+  const m=memory(),monthly=await collectCbMonthly({read:m.read,write:m.write,fetchImpl:relayOnly(),now:NOW});
+  assert.equal(monthly.status,'ok');assert.equal(monthly.capturePath,'github_relay');assert.equal(monthly.month,'2026-09');
+  assert.deepEqual(monthly.prices['82993'],{issuer:'8299',price:2468.8,resetDate:'2026-07-06'});
+  assert.ok(Object.keys(monthly.prices).length>300);
+  const reg=await collectCbRegistry({...memory(),fetchImpl:relayOnly(),now:NOW});
+  const cb=convertibleBonds({...reg,monthly},{symbol:'8299',price:1880,priceDate:'2026-10-22'});
+  const p3=cb.bonds.find(b=>b.id==='82993');
+  assert.equal(p3.conversionPriceBasis,'MOPS_MONTHLY');assert.equal(p3.conversionPriceCurrent,2468.8);
+  assert.equal(cb.capturePath,'github_relay');assert.equal(cb.monthly.capturePath,'github_relay');
+  assert.equal(cb.scoreContribution,0);
+});
diff --git a/tests/v237-fixes.test.mjs b/tests/v237-fixes.test.mjs
new file mode 100644
index 0000000..d3cae46
--- /dev/null
+++ b/tests/v237-fixes.test.mjs
@@ -0,0 +1,35 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+
+// v237 讀回後的兩項補修：外部收集程式的「未列入行情表」欄位、M1B−M2 快取重讀的時效與中繼一致。
+const source=readFileSync(new URL('../dist/server/index.js',import.meta.url),'utf8');
+const site=await import('data:text/javascript;base64,'+Buffer.from(source+'\n// v237-fixes\nexport {macroObservationCurrent};').toString('base64'));
+
+function fakeDb(){const rows=new Map();return {rows,DB:{prepare(sql){return {run:async()=>({success:true}),bind(...a){return {run:async()=>{if(sql.includes('INSERT INTO site_runtime_cache'))rows.set(a[0],{cache_key:a[0],payload:a[1],updated_at:a[2],expires_at:a[3]});return {success:true};},all:async()=>({results:sql.includes('LIKE')?[...rows.values()].filter(r=>r.cache_key?.startsWith(a[0].replace('%',''))):rows.has(a[0])?[rows.get(a[0])]:[]})};}};}}};}
+
+test('外部收集程式送來的未列入行情表股票：匯入時驗證，缺收盤三類由網站重算',async()=>{
+  const {rows,DB}=fakeDb(),now=new Date().toISOString(),today=now.slice(0,10);
+  const post=async input=>{const r=await site.default.fetch(new Request('https://site.test/api/official-data-import',{method:'POST',body:JSON.stringify(input)}),{DB});return {status:r.status,body:await r.json()};};
+  const snapshot={date:today,capturedAt:now,sourceUrls:{twse:`https://www.twse.com.tw/rwd/zh/afterTrading/MI_INDEX?date=${today.replaceAll('-','')}`,tpex:`https://www.tpex.org.tw/www/zh-tw/afterTrading/otc?date=${today.replaceAll('-','/')}`},universe:{twse:500,tpex:500,total:1000},
+    rows:Array.from({length:990},(_,i)=>({id:String(1000+i),name:String(i),market:i<495?'twse':'tpex',industry:i<495?'A':'B',close:20,change:1,volume:100,amount:2000})),
+    noTradeRows:[{id:'2990',name:'x',market:'tpex',volume:0,amount:0,close:null,state:'official_no_trade'}],
+    volumeRows:[{id:'2991',name:'y',market:'tpex',volume:120,amount:6000,close:null,state:'official_volume_only'}],
+    notQuotedRows:[{id:'2992',name:'z',market:'tpex',close:null,state:'official_not_quoted'},{id:'2993',name:'w',market:'tpex',close:null,state:'official_not_quoted'}],
+    missingBreakdown:{noTrade:99,volumeOnly:99,notQuoted:99,total:297}};
+  assert.equal((await post({schema_version:1,marketSnapshots:[{...snapshot,notQuotedRows:[{id:'2992',market:'tpex',close:12,state:'official_not_quoted'}]}]})).body.error,'invalid_not_quoted_row','未列入的不能帶價格');
+  assert.equal((await post({schema_version:1,marketSnapshots:[{...snapshot,notQuotedRows:[{id:'1000',market:'twse',close:null,state:'official_not_quoted'}]}]})).body.error,'invalid_not_quoted_row','不能和有行情的重複');
+  const ok=await post({schema_version:1,marketSnapshots:[snapshot]});
+  assert.equal(ok.status,200);
+  const saved=JSON.parse(rows.get('market-scanner-snapshot:v1:'+today).payload);
+  assert.deepEqual({...saved.missingBreakdown,note:undefined},{noTrade:1,volumeOnly:1,notQuoted:2,total:4,note:undefined},'計數由網站重算，不用送來的 99');
+  const latest=JSON.parse(rows.get('market-scanner-latest:v1').payload);
+  assert.equal(latest.missingBreakdown.total,4);assert.deepEqual(latest.notQuoted.map(r=>r.id),['2992','2993']);
+});
+
+test('M1B−M2：中繼快照（觀測月 2026-08，max_age 95）在 10-26 快取重讀時仍有效，不再誤判過期',()=>{
+  const fetchedAt=new Date(Date.now()-3600000).toISOString();
+  const row={id:'TW_M1B_M2',status:'snapshot',snapshot:true,is_stale:false,value:-0.14,date:'2026-08-01',fetchedAt,source:'https://www.cbc.gov.tw/app.asp?xdUrl=AppT1.asp'};
+  const ageDays=(Date.now()-Date.parse('2026-08-01'))/86400000;
+  assert.equal(site.macroObservationCurrent(row,{checkedAt:fetchedAt}),ageDays<=95,`觀測月後 ${ageDays.toFixed(0)} 天，上限 95 天`);
+});
diff --git a/tests/v237-rules.test.mjs b/tests/v237-rules.test.mjs
new file mode 100644
index 0000000..d2084ef
--- /dev/null
+++ b/tests/v237-rules.test.mjs
@@ -0,0 +1,91 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {macroDirectionHolding} from '../worker/advisory-decision.mjs';
+import {entryCondition} from '../worker/panel-calculations.mjs';
+
+// 擁有者 2026-10-26 21:51 核准：大盤持股「看方向」（D10）、個股「技術強＋近 3 月營收年增 >10%」才進、技術不過避開。
+const source=readFileSync(new URL('../dist/server/index.js',import.meta.url),'utf8');
+const site=await import('data:text/javascript;base64,'+Buffer.from(source+'\n// v237-rules\nexport {recordMacroScoreDaily,MACRO_SCORE_SEED};').toString('base64'));
+
+const days=(values,start='2026-01-01')=>values.map((raw,i)=>({date:new Date(Date.parse(start)+i*86400000).toISOString().slice(0,10),raw,origin:'live'}));
+
+test('大盤持股 D10：20 日平均比 60 個交易日前高 5 分以上 75%、低 5 分以上 55%、其餘 65%；不足 80 天維持 65%',()=>{
+  assert.equal(macroDirectionHolding(days(Array(100).fill(60))).target,65);
+  const up=macroDirectionHolding(days([...Array(80).fill(55),...Array(20).fill(62)]));
+  assert.equal(up.status,'ok');assert.equal(up.target,75);assert.ok(Math.abs(up.delta-7)<1e-9);
+  assert.equal(macroDirectionHolding(days([...Array(80).fill(66),...Array(20).fill(60)])).target,55);
+  assert.equal(macroDirectionHolding(days([...Array(80).fill(60),...Array(20).fill(64.99)])).target,65,'未滿 5 分不動');
+  const short=macroDirectionHolding(days(Array(79).fill(60)));
+  assert.equal(short.status,'insufficient');assert.equal(short.target,65);assert.match(short.reason,/79\/80/);
+  // 同一天重複只算一次；壞資料不算
+  assert.equal(macroDirectionHolding([...days(Array(79).fill(60)),{date:'2026-01-01',raw:60},{date:'bad',raw:60},{date:'2026-12-31',raw:NaN}]).observations,79);
+});
+
+test('用第 31 輪重建分數（2026-05-29～10-22）：20 日平均 64.5、60 日前 60.1，差 +4.4 分 → 維持 65%',()=>{
+  const h=macroDirectionHolding(site.MACRO_SCORE_SEED);
+  assert.equal(site.MACRO_SCORE_SEED.length,100);assert.equal(h.asOf,'2026-10-22');
+  assert.ok(Math.abs(h.ma20-64.53)<0.01&&Math.abs(h.ma20Prior-60.09)<0.01,`${h.ma20} ${h.ma20Prior}`);
+  assert.equal(h.target,65);assert.equal(h.seedObservations,100);
+});
+
+test('網站每天記錄總經分數（資料齊才記、用加權指數交易日當鍵），同一天以網站記錄取代重建值',async()=>{
+  const rows=new Map();
+  const DB={prepare(sql){return {run:async()=>({success:true}),bind(...a){return {run:async()=>{if(sql.includes('INSERT INTO site_runtime_cache'))rows.set(a[0],{cache_key:a[0],payload:a[1],updated_at:a[2],expires_at:a[3]});return {success:true};},all:async()=>({results:rows.has(a[0])?[rows.get(a[0])]:[]})};}};}};
+  const market={rows:[{id:'TWSE_TAIEX',status:'ok',date:'2026-10-22',value:45000}]};
+  let merged=await site.recordMacroScoreDaily({DB},{complete:false,raw:80,score:80},market);
+  assert.equal(rows.size,0,'灰燈（資料未齊）不記錄');assert.equal(merged.length,100);
+  merged=await site.recordMacroScoreDaily({DB},{complete:true,raw:70.5,score:71,coverage:90},market);
+  const saved=JSON.parse(rows.get('macro-score-daily:v1').payload).days;
+  assert.deepEqual(saved.map(r=>[r.date,r.raw,r.origin]),[['2026-10-22',70.5,'live']]);
+  assert.equal(merged.length,100);assert.equal(merged.find(r=>r.date==='2026-10-22').origin,'live');
+  await site.recordMacroScoreDaily({DB},{complete:true,raw:70.5,score:71},{rows:[{id:'TWSE_TAIEX',status:'stale',is_stale:true,date:'2026-10-26'}]});
+  assert.equal(JSON.parse(rows.get('macro-score-daily:v1').payload).days.length,1,'加權指數日期過期就不記');
+});
+
+const revenueRows=(yoys,{year=2026,lastMonth=9,created='2026-10-08'}={})=>{
+  const out=[];
+  for(let k=0;k<yoys.length;k++){const m=lastMonth-yoys.length+1+k,mm=((m-1+12)%12)+1,yy=m<1?year-1:year;
+    out.push({revenue_year:yy-1,revenue_month:mm,revenue:100,create_time:`${yy-1}-01-01`});
+    out.push({revenue_year:yy,revenue_month:mm,revenue:100*(1+yoys[k]/100),create_time:k===yoys.length-1?created:`${yy}-0${Math.min(9,mm)}-01`});}
+  return out;
+};
+const strong={status:'ok',score:4},pass={questions:{technical:{result:'pass',daysBelowMa60:0}}},fail={questions:{technical:{result:'fail',daysBelowMa60:9,basis:'x'}}};
+
+test('個股進場條件：技術強＋營收成長才進；技術不過避開；其餘觀望；資料不足不判斷',()=>{
+  const asOf='2026-10-22',st=r=>({panelInputs:{revenueHistory:r}});
+  const enter=entryCondition(st(revenueRows([12,15,20])),strong,pass,{asOf});
+  assert.equal(enter.status,'enter');assert.equal(enter.label,'可進場');assert.ok(Math.abs(enter.revenue.avg3YoyPct-47/3)<1e-9);
+  assert.equal(entryCondition(st(revenueRows([2,5,8])),strong,pass,{asOf}).status,'wait','技術強但營收未達 +10%');
+  assert.equal(entryCondition(st(revenueRows([30,30,30])),{status:'ok',score:2},pass,{asOf}).status,'wait','均線未達 +3');
+  const avoid=entryCondition(st(revenueRows([30,30,30])),strong,fail,{asOf});
