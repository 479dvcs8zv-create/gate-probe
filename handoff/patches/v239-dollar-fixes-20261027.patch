+  const old=await stockRequest(base);
+  assert.equal(old.body.refreshing,true,'舊快照要背景重抓');assert.ok(old.finmindCalls>=1,'背景真的去重抓個股資料');assert.match(old.body.note,/缺除權息事件/);
+  assert.equal(old.body.price.value,33.95,'重抓期間仍顯示上次成功資料，不清空');
