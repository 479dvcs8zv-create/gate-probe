+    assert.match(render(panels),/櫃買清單、觀測站月報：網站直連失敗，改用 GitHub 排程代抓/);
+  }finally{globalThis.fetch=previous;}
+});
+
+test('混合來源（清單代抓、月報直連）也要註明清單是代抓；全部直連就不寫',()=>{
+  const bonds=[{id:'82993',issuer:'8299',kind:'domestic',currency:'TWD',outstandingFace:6e9,conversionPriceAtIssue:2400,issueDate:'2026-02-06'}];
+  const base={status:'ok',checkedAt:'2026-10-26T17:00:00Z',errors:[],bonds,monthly:{status:'ok',month:'2026-09',capturePath:'direct',prices:{'82993':{issuer:'8299',price:2468.8,resetDate:'2026-07-06'}}}};
+  const stock=reg=>({id:'8299',price:{date:'2026-10-22',value:1880},priceHistory:[],panelInputs:{cbRegistry:reg,issuer:{shares:210000000,date:'2026-10-22'}}});
+  // 舊版組裝丟掉了頂層 capturePath，只剩 sources 裡有：也要認得。
+  const mixed=render(buildStockPanels(stock({...base,sources:[{kind:'domestic',capturePath:'github_relay'},{kind:'overseas',capturePath:'github_relay'}]})));
+  assert.match(mixed,/櫃買清單：網站直連失敗，改用 GitHub 排程代抓/);assert.doesNotMatch(mixed,/觀測站月報：網站直連失敗/);
+  const direct=render(buildStockPanels(stock({...base,capturePath:'direct',sources:[{kind:'domestic'},{kind:'overseas'}]})));
+  assert.doesNotMatch(direct,/GitHub 排程代抓/);
+});
+
+async function stockRequest(payload){
+  const {default:worker}=await import('data:text/javascript;base64,'+Buffer.from(source+`\n// v239-stock-${Math.random()}`).toString('base64'));
+  const db=fakeDb(),now=new Date();
+  db.rows.set('stock:v5:5009',{payload:JSON.stringify(payload),updated_at:now.toISOString(),expires_at:new Date(now.getTime()+5*3600000).toISOString()});
+  const tasks=[],urls=[];const ctx={waitUntil(p){tasks.push(Promise.resolve(p).catch(()=>{}));}};
+  const previous=globalThis.fetch;globalThis.fetch=async url=>{urls.push(String(url));return new Response('unavailable in test',{status:503});};
+  try{const r=await worker.fetch(new Request('https://site.test/api/taiwan-stock?id=5009'),{DB:db},ctx);const body=await r.json();await Promise.all(tasks);
+    return {body,finmindCalls:urls.filter(u=>u.includes('finmindtrade.com')).length};}
+  finally{globalThis.fetch=previous;}
+}
