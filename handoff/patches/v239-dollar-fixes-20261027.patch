+const RELAY=JSON.parse(readFileSync(new URL('./fixtures/relay-cb-snapshot-20261026.json',import.meta.url),'utf8'));
+function fakeDb(){const rows=new Map();return {prepare(sql){let args=[];const stmt={bind(...a){args=a;return stmt;},async run(){if(/^INSERT INTO site_runtime_cache/.test(sql))rows.set(args[0],{payload:args[1],updated_at:args[2],expires_at:args[3]});return {success:true,meta:{changes:1}};},async all(){const r=/FROM site_runtime_cache/.test(sql)?rows.get(args[0]):null;return {results:r?[r]:[]};}};return stmt;},rows};}
+class Element{constructor(){this.children=[];this.style={};this.attributes={};this.hidden=false;}append(...x){this.children.push(...x);}replaceChildren(...x){this.children=x;this.text='';}set textContent(v){this.text=String(v);this.children=[];}get textContent(){return (this.text||'')+this.children.map(x=>x.textContent||String(x)).join(' ');}setAttribute(k,v){this.attributes[k]=v;}}
+function render(panels){
+  const host=new Element(),context=vm.createContext({document:{getElementById:()=>host,createElement:()=>new Element()},console});
+  vm.runInContext(readFileSync(new URL('../worker/panel-display.js',import.meta.url),'utf8'),context);
+  context.model={symbol:'8299',report:{advisoryPanels:panels}};vm.runInContext('renderAdvisoryPanels(model)',context);
+  return host.textContent;
+}
+
+test('網站直連櫃買失敗 → 代抓的 capturePath 一路帶到個股卡片，畫面寫出哪一份是 GitHub 代抓',async()=>{
+  const relay=structuredClone(RELAY),at=new Date().toISOString();
+  for(const p of Object.values(relay.registries))p.fetched_at=at;relay.monthly.fetched_at=at;
+  const previous=globalThis.fetch;
+  globalThis.fetch=async url=>{const u=String(url);if(u.includes('cb_snapshot.json'))return new Response(JSON.stringify(relay),{status:200});if(u.includes('keyless_snapshot.json'))return new Response('not found',{status:404});throw Error('official host unreachable from the site server');};
+  try{
+    const api=await load('v239-cb-path');
