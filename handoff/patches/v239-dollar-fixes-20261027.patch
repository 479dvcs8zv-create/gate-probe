diff --git a/tests/v239-collector-utc.test.mjs b/tests/v239-collector-utc.test.mjs
new file mode 100644
index 0000000..977b82f
--- /dev/null
+++ b/tests/v239-collector-utc.test.mjs
@@ -0,0 +1,41 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {execFileSync} from 'node:child_process';
+import {mkdtempSync,readFileSync,rmSync} from 'node:fs';
+import {tmpdir} from 'node:os';
+import path from 'node:path';
+
+// GPT 2026-10-27 回報：台北凌晨跑收集程式，FRED 已列出 IORB 下一日（10/27）觀測；收集程式用本機日期放行，
+// 網站匯入用 UTC 日期檢查「不得晚於今天」，整筆 invalid_series_history 被拒。收集程式改用 UTC 日期，兩邊一致。
+const script=new URL('../scripts/collect-official-data.py',import.meta.url).pathname;
+const harness=String.raw`
+import datetime as dt,io,json,runpy,sys,urllib.request,urllib.error,urllib.parse
+script,folder=sys.argv[1:]
+utc=dt.datetime.now(dt.timezone.utc).date()
+def fetch(request,**kwargs):
+    url=request.full_url;u=urllib.parse.urlparse(url);q=urllib.parse.parse_qs(u.query)
+    if u.netloc=='fred.stlouisfed.org' and u.path=='/graph/fredgraph.csv':
+        sid=q['id'][0];days=[utc-dt.timedelta(days=n) for n in range(150,-2,-1)]  # 含 UTC 明天一筆
+        return io.BytesIO(('observation_date,'+sid+'\n'+'\n'.join(d.isoformat()+',4.4' for d in days)).encode())
+    raise urllib.error.HTTPError(url,503,'unavailable in test',{},None)
+urllib.request.urlopen=fetch
+sys.argv=[script,'--output',folder,'--macro-only']
+try: runpy.run_path(script,run_name='__main__')
+except SystemExit: pass
+`;
+
+test('收集程式「不得晚於今天」用 UTC 日期：不論本機時區，FRED 列出的 UTC 明天觀測都不送、UTC 今天的保留',()=>{
+  const utcHour=new Date().getUTCHours();
+  // 選一個讓本機日期 ≠ UTC 日期的時區：UTC 10 點後用 UTC+14（本機已是明天），之前用 UTC−12（本機還是昨天）。
+  const tz=utcHour>=10?'Etc/GMT-14':'Etc/GMT+12';
+  const folder=mkdtempSync(path.join(tmpdir(),'collector-utc-'));
+  try{
+    execFileSync('python3',['-I','-c',harness,script,folder],{env:{...process.env,TZ:tz},stdio:['ignore','pipe','pipe']});
+    const saved=JSON.parse(readFileSync(path.join(folder,'series.json'),'utf8')).series;
+    const utcToday=new Date().toISOString().slice(0,10);
+    const iorb=saved.find(s=>s.id==='IORB');
+    assert.ok(iorb,'IORB 應有輸出');
+    assert.equal(iorb.history.at(-1).date,utcToday,`TZ=${tz}：最後一筆應為 UTC 今天`);
+    for(const s of saved)assert.ok(s.history.every(x=>x.date<=utcToday),`${s.id} 不得含 UTC 今天之後的觀測`);
+  }finally{rmSync(folder,{recursive:true,force:true});}
+});
