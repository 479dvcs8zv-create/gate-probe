+  ...Array.from({ length: 300 }, (_, i) => ({ stock_id: String(2000 + i), stock_name: `上櫃測試${i}`, type: 'tpex', industry_category: i % 2 ? '半導體業' : '電子零組件業' })),
+];
+const twseRows = universeRows.filter(x => x.type === 'twse').map((x, i) => ({ Date: '1151007', Code: x.stock_id, Name: x.stock_name, ClosingPrice: '100.00', Change: i % 2 ? '+1.00' : '-1.00', TradeVolume: '10000', TradeValue: '1000000' }));
