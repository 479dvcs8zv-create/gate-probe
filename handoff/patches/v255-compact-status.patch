+class MemoryD1 {
+  rows = new Map();
+  prepare(sql) {
+    const lease=refreshLeaseStatement(this,sql);if(lease)return lease;
+    return {
+      bind: (...args) => ({
+        run: async () => {
+          if (sql.includes('INSERT INTO site_runtime_cache')) {
+            this.rows.set(args[0], { payload: args[1], updated_at: args[2], expires_at: args[3] });
+          }
+          return { success: true };
+        },
+        all: async () => {
+          if (sql.includes('SELECT payload, updated_at, expires_at FROM site_runtime_cache')) {
+            const row = this.rows.get(args[0]);
+            return { results: row ? [row] : [] };
+          }
+          if (sql.includes('WHERE cache_key LIKE')) {
+            return { results: [...this.rows.entries()].filter(([key]) => key.startsWith(String(args[0]).replace('%', ''))).slice(-Number(args[1])).map(([cache_key, row]) => ({ cache_key, ...row })) };
+          }
+          return { results: [] };
+        },
+      }),
+      run: async () => ({ success: true }),
+    };
+  }
+}
+
+// v255（擁有者 2026-11-09「GPT 額度消耗太快」）：巡檢輪詢加 ?compact=1 只回進度與摘要；不帶參數時回應不變。
+const db = new MemoryD1();
+const originalFetch = globalThis.fetch;
