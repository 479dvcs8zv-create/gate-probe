+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { pathToFileURL } from 'node:url';
+import {refreshLeaseStatement} from './helpers/refresh-lease.mjs';
+
+const workerUrl = pathToFileURL(new URL('../dist/server/index.js', import.meta.url).pathname).href;
+const { default: worker } = await import(workerUrl);
