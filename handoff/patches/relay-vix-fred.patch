+def fetch_public(url,accept,limit,prefer_default_agent=False):
+    """擁有者 2026-11-06 17:27「好」：FRED 在 GitHub 上會擋自訂 User-Agent（11/06 14:59 VIX 抓取逾時；11/03 實測只有 Python 預設字串回 200），
