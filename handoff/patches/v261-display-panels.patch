@@ -0,0 +1,62 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { trustToCapital, ma60Deduction, grossMarginTrend } from '../worker/panel-calculations.mjs';
+
+// v261（擁有者 2026-11-27）：第 45～47 輪回測後的三個只顯示項目；都不改評級、Gate 或進場判斷。
+
+const businessDays=(start,count)=>{const out=[];const d=new Date(start+'T00:00:00Z');while(out.length<count){if(d.getUTCDay()%6)out.push(d.toISOString().slice(0,10));d.setUTCDate(d.getUTCDate()+1);}return out;};
+
+test('投本比：投信 20 日淨買 ÷ 發行股數；缺股數或法人未對齊就不算',()=>{
+  const tq={questions:{chips:{windows:{d5:{trustShares:5000,to:'2026-11-20'},d10:{trustShares:-2000,to:'2026-11-20'},d20:{trustShares:12000,to:'2026-11-20'}}}}};
+  const r=trustToCapital({valuationInputs:{issuedShares:1000000,shareSource:'TWSE 公司基本資料'}},tq);
+  assert.equal(r.status,'ok');assert.equal(r.d20,1.2);assert.equal(r.d5,0.5);assert.equal(r.d10,-0.2);assert.equal(r.to,'2026-11-20');
+  assert.equal(r.scoreContribution,0);assert.match(r.backtest,/第 45 輪/);
+  assert.equal(trustToCapital({valuationInputs:{}},tq).reason,'ISSUED_SHARES_MISSING');
+  assert.equal(trustToCapital({valuationInputs:{issuedShares:1000000}},{questions:{chips:{windows:{}}}}).status,'insufficient');
+});
+
+test('季線扣抵價：明天扣掉的是 60 日窗口最舊那筆；收盤高於它季線才會續上彎',()=>{
+  const dates=businessDays('2026-08-03',65),priceHistory=dates.map((date,i)=>({date,close:i+1}));
+  const stock={priceHistory,exRightsEvents:[]},asOf=dates.at(-1);
+  const r=ma60Deduction(stock,{asOf});
+  assert.equal(r.status,'ok');
+  assert.equal(r.ma60,35.5);assert.equal(r.ma60Previous,34.5);assert.equal(r.rising,true);
+  assert.equal(r.nextDeduction,6);assert.deepEqual(r.nextDeductions.map(x=>x.price),[6,7,8,9,10]);
+  assert.equal(r.nextDeductions[0].date,dates[5]);
+  // 驗證定義：明天收盤 = 扣抵價時季線持平
+  const tomorrow=[...priceHistory.slice(-59).map(x=>x.close),r.nextDeduction];
+  assert.equal(tomorrow.reduce((s,x)=>s+x,0)/60,r.ma60,'明天收盤剛好等於扣抵價 → 季線持平');
+  assert.equal(r.scoreContribution,0);assert.match(r.backtest,/第 46 輪/);
+  assert.equal(ma60Deduction({priceHistory:priceHistory.slice(1),exRightsEvents:[]},{asOf}).status,'insufficient','64 筆不夠');
+  assert.equal(ma60Deduction(stock,{asOf:'2026-12-31'}).reason,'PRICE_HISTORY_NOT_ALIGNED');
+});
+
+test('季線扣抵價：除息日之前的價格要還原，扣抵價跟著還原',()=>{
+  const dates=businessDays('2026-08-03',65),priceHistory=dates.map(date=>({date,close:100}));
+  priceHistory[30]={...priceHistory[30],close:95};for(let i=31;i<65;i++)priceHistory[i]={...priceHistory[i],close:95};
+  const r=ma60Deduction({priceHistory,exRightsEvents:[{cashDate:dates[30],cash:5,stockDate:null,stockBonus:0}]},{asOf:dates.at(-1)});
+  assert.equal(r.status,'ok');assert.ok(Math.abs(r.nextDeduction-95)<1e-9,'除息前 100 元還原成 95 元');assert.ok(Math.abs(r.ma60-95)<1e-9);
+  assert.equal(r.adjustedFor.length,1);
+});
+
+test('單季毛利率：比上季、比去年同季；缺期別不判斷',()=>{
+  const key=y=>q=>y*4+q-1,row=(y,q,m)=>({date:`${y}-${['03-31','06-30','09-30','12-31'][q-1]}`,key:key(y)(q),margin:m});
+  const fq=rows=>({financialQuality:{source:'FinMind 財報',grossMarginHistory:rows}});
+  const base=[row(2025,2,40),row(2025,3,41),row(2025,4,42),row(2026,1,43)];
+  let r=grossMarginTrend(fq([...base,row(2026,2,44)]));
+  assert.equal(r.label,'季增且年增');assert.equal(r.qoqUp,true);assert.equal(r.yoyUp,true);assert.equal(r.sameQuarterLastYear.date,'2025-06-30');
+  assert.equal(grossMarginTrend(fq([...base,row(2026,2,39)])).label,'季減且年減');
+  assert.equal(grossMarginTrend(fq([...base,row(2026,2,42)])).label,'只有年增');
+  assert.equal(grossMarginTrend(fq([row(2025,2,45),...base.slice(1),row(2026,2,44)])).label,'只有季增');
+  assert.equal(grossMarginTrend(fq(base.slice(1).concat(row(2026,2,44)))).reason,'SAME_QUARTER_LAST_YEAR_MISSING');
+  assert.equal(grossMarginTrend({}).reason,'FINANCIAL_QUALITY_NOT_LOADED');
+  assert.equal(r.scoreContribution,0);assert.match(r.backtest,/第 47 輪/);
+});
+
+test('網頁有三張新卡片，都標只顯示',()=>{
+  const html=readFileSync(new URL('../dist/index.html',import.meta.url),'utf8');
+  for(const label of ['投本比（投信淨買 ÷ 發行股數）','季線（60日）扣抵價','單季毛利率 季增／年增'])assert.ok(html.includes(label),label);
+  const server=readFileSync(new URL('../dist/server/index.js',import.meta.url),'utf8');
+  for(const name of ['trustToCapital:trustToCapital(stock,tq)','ma60Deduction:ma60Deduction(stock,{asOf})','grossMarginTrend:grossMarginTrend(stock)','grossMarginHistory, roe'])assert.ok(server.includes(name),name);
+});
