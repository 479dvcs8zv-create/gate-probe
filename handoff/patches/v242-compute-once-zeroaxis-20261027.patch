@@ -0,0 +1,104 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+
+// 擁有者 2026-10-27 17:02「好一次處理」：後台只算一次。
+// ① 個股結果（評級、Gate、進場出場、估值、持股建議）輸入沒變就讀存好的那份，網頁與巡檢同一份；輸入一變才重算。
+// ② 巡檢沒有登入身分時，用擁有者上次同步清單的身分讀證據（只限內部巡檢；外部請求不能借用）。
+// ③ 總經分數只在後台算一次：/api/macro-scores、個股的大盤持股建議讀同一份；輸入與原本網頁分數卡相同（含美股三大指數那一組）。
+const source=readFileSync(new URL('../dist/server/index.js',import.meta.url),'utf8');
+let n=0;
+const load=()=>import('data:text/javascript;base64,'+Buffer.from(source+`\n// v241-once-${n++}\nexport {masterModelResponse,macroScoreSnapshot,backendMarketScoreModels,SITE_BUILD_ID};`).toString('base64'));
+const {stock}=JSON.parse(readFileSync(new URL('./fixtures/master-remediation.json',import.meta.url),'utf8'));
+function memoryDb(){
+  const rows=new Map(),writes=[];
+  const db={rows,writes,seed(key,payload,ttl=3600000){rows.set(key,{payload:JSON.stringify(payload),updated_at:new Date().toISOString(),expires_at:new Date(Date.now()+ttl).toISOString()});},
+    prepare(sql){return {run:async()=>({success:true}),bind(...args){return {run:async()=>{if(sql.startsWith('INSERT INTO site_runtime_cache')){rows.set(args[0],{payload:args[1],updated_at:args[2],expires_at:args[3]});writes.push(args[0]);}return {success:true};},all:async()=>({results:rows.has(args[0])?[rows.get(args[0])]:[]}),first:async()=>null};}};}};
+  return db;
+}
+function lastUsSession(){const d=new Date();do{d.setUTCDate(d.getUTCDate()-1);}while([0,6].includes(d.getUTCDay()));return d.toISOString().slice(0,10);}
+function seedSite(db,{price=null}={}){
+  const today=new Date(Date.now()+8*3600000).toISOString().slice(0,10);
+  db.seed('stock:v5:8299',{...stock,price:{...stock.price,date:today,...(price?{value:price}:{})},checkedAt:'2026-10-27T01:00:00.000Z',exRightsEvents:[]},6*3600000);
+  db.seed('macro:v1',{checkedAt:new Date().toISOString(),rows:[{id:'VIXCLS',name:'VIX 波動指數（^VIX）',status:'ok',value:19.45,date:'2026-10-23'}],light:'灰色',coverage:{missingCore:[]}});
+  db.seed('macro-market:v7',{checkedAt:new Date().toISOString(),rows:[]});
+  db.seed('us-indices:v1',{checkedAt:new Date().toISOString(),rows:[{id:'SP500',name:'標普 500',status:'ok',value:7000,percent:0.62,date:lastUsSession()}]});
+}
+// 官方來源一律連不到；可轉債改讀中繼的同一份官方檔（狀態穩定），其餘面板來源維持「失敗」也一樣穩定。
+const cbRelay=JSON.parse(readFileSync(new URL('./fixtures/relay-cb-snapshot-20261026.json',import.meta.url),'utf8'));
+const offline=async url=>{
+  if(String(url).includes('cb_snapshot.json')){const r=structuredClone(cbRelay),at=new Date().toISOString();for(const p of Object.values(r.registries))p.fetched_at=at;r.monthly.fetched_at=at;return new Response(JSON.stringify(r),{status:200});}
+  return new Response('offline in test',{status:503});
+};
+
+test('同一份輸入只算一次：第二次（網頁重開、巡檢）直接讀存好的結果；輸入改變才重算',async()=>{
+  const api=await load(),db=memoryDb();seedSite(db);
+  const previous=globalThis.fetch;globalThis.fetch=offline;
+  try{
+    const ask=async(headers={},ctx={})=>(await api.masterModelResponse(new Request('https://site.test/api/master-model?id=8299',{headers}),{DB:db},ctx)).json();
+    const first=await ask();
+    assert.equal(first.symbol,'8299');assert.equal(first.reusedSavedResult,false);assert.ok(first.computedAt);
+    const second=await ask();
+    assert.equal(second.reusedSavedResult,true,'輸入沒變 → 不重算');
+    assert.equal(second.computedAt,first.computedAt);assert.equal(second.generatedAt,first.generatedAt,'同一份結果');
+    assert.deepEqual(second.gates.map(g=>g.status),first.gates.map(g=>g.status));
+    // 個股資料更新（新的收盤價）→ 重算一次，之後又重用
+    seedSite(db,{price:Number(stock.price.value)*1.05});
+    const third=await ask();assert.equal(third.reusedSavedResult,false,'輸入改變 → 重算');assert.notEqual(third.stockPriceValue,first.stockPriceValue);
+    const fourth=await ask();assert.equal(fourth.reusedSavedResult,true);assert.equal(fourth.computedAt,third.computedAt);
+  }finally{globalThis.fetch=previous;}
+});
+
+test('巡檢沒有登入身分：用擁有者上次同步清單的身分讀證據，和擁有者看到的是同一份；外部未登入請求不能借用',async()=>{
+  const api=await load(),db=memoryDb();seedSite(db);
+  db.seed('site-owner:v1',{userId:'owner-123',savedAt:new Date().toISOString()},86400000);
+  db.seed('master-gate-evidence:v1:owner-123:8299',{updatedAt:'2026-10-27T00:00:00Z'},86400000);
+  const previous=globalThis.fetch;globalThis.fetch=offline;
+  try{
+    const ask=async(headers={},ctx={})=>(await api.masterModelResponse(new Request('https://site.test/api/master-model?id=8299',{headers}),{DB:db},ctx)).json();
+    const owner=await ask({'oai-authenticated-user-id':'owner-123'});assert.equal(owner.reusedSavedResult,false);
+    const patrol=await ask({}, {useSiteOwnerEvidence:true});
+    assert.equal(patrol.reusedSavedResult,true,'巡檢讀到擁有者那一份，不另算');assert.equal(patrol.computedAt,owner.computedAt);
+    const outsider=await ask({});
+    assert.equal(outsider.reusedSavedResult,false,'未登入的外部請求不會用到擁有者的證據');
+    assert.ok([...db.rows.keys()].some(k=>k.startsWith('master-model-result:v1:8299:public')));
+    assert.ok(![...db.rows.keys()].some(k=>k.includes('owner-123')&&k.startsWith('master-model-result')),'存檔鍵不含擁有者身分原文');
+  }finally{globalThis.fetch=previous;}
+});
+
+test('總經分數只算一次：/api/macro-scores 與個股持股建議用同一份；輸入沒變不重算；輸入與原本網頁分數卡相同',async()=>{
+  const api=await load(),db=memoryDb();seedSite(db);
+  const previous=globalThis.fetch;globalThis.fetch=offline;
+  try{
+    const a=(await api.macroScoreSnapshot({DB:db},{},{refresh:false})).record;
+    assert.equal(a.reused,false);assert.deepEqual(a.models.map(m=>m.market).sort(),['TW','US']);
+    assert.equal(a.inputs.usIndexCheckedAt!==null,true,'和原本網頁分數卡同一組輸入（含美股三大指數）');
+    const b=(await api.macroScoreSnapshot({DB:db},{},{refresh:false})).record;
+    assert.equal(b.reused,true);assert.equal(b.computedAt,a.computedAt);
+    const viaApi=await (await (await load()).masterModelResponse(new Request('https://site.test/api/master-model?id=8299'),{DB:db},{})).json();
+    assert.equal(viaApi.macroScoresComputedAt,a.computedAt,'個股結果標明用的是同一次總經分數');
+    const {default:worker}=await load();
+    const res=await worker.fetch(new Request('https://site.test/api/macro-scores'),{DB:db},{waitUntil(){}});
+    const body=await res.json();assert.equal(res.status,200);assert.equal(body.computedAt,a.computedAt);assert.equal(body.reused,true);
+    assert.deepEqual(body.models.map(m=>[m.market,m.score]),a.models.map(m=>[m.market,m.score]));
+    // 網頁原本那份與後台同一套規則：用同一組輸入算出同樣的分數
+    const html=readFileSync(new URL('../dist/index.html',import.meta.url),'utf8');
+    assert.ok(!/const add=\(dims,key,name,scorer/.test(html),'網頁不再有第二份計分程式');
+  }finally{globalThis.fetch=previous;}
+});
+
+test('程式版本指紋：建置時依程式內容產生，換版就不會沿用舊結果',async()=>{
+  const api=await load();assert.match(api.SITE_BUILD_ID,/^[0-9a-f]{16}$/);
+  assert.ok(source.startsWith(`const SITE_BUILD_ID = "${api.SITE_BUILD_ID}";`));
+});
+
+test('擁有者同步追蹤清單時記下身分（只存後台）；回應不帶身分',async()=>{
+  const {default:worker}=await load(),db=memoryDb();
+  db.seed('site-watchlist:v1:owner-9',{watchlist:[{id:'8299',name:'群聯',industry:'半導體'}]},86400000);
+  const res=await worker.fetch(new Request('https://site.test/api/watchlist',{headers:{'oai-authenticated-user-id':'owner-9'}}),{DB:db},{waitUntil(){}});
+  const text=await res.text();assert.equal(res.status,200);assert.ok(!text.includes('owner-9'),'回應不含身分');
+  assert.equal(JSON.parse(db.rows.get('site-owner:v1').payload).userId,'owner-9');
+  const put=await worker.fetch(new Request('https://site.test/api/watchlist',{method:'PUT',headers:{'oai-authenticated-user-id':'owner-10','content-type':'application/json'},body:JSON.stringify({watchlist:[{id:'5009',name:'榮剛',industry:'鋼鐵'}]})}),{DB:db},{waitUntil(){}});
+  assert.equal(put.status,200);assert.ok(!(await put.text()).includes('owner-10'));
+  assert.equal(JSON.parse(db.rows.get('site-owner:v1').payload).userId,'owner-10','最後同步的人＝巡檢用的身分（與巡檢清單同一人）');
+});
