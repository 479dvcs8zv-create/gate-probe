"use strict";

//報表功能
class bxRport {

  /*
   避免程式中大量的 this，通在會在函式開頭指定 _ 變數為這個類別
   避免 this 變成 jQuery 的，可以用 $.proxy
   開頭 # 為私有變數
  */


  //自動固定欄名
  #reAutoFixed = /^(?:名稱|證券商名稱|Name|Securities Firms Code)$/i;

  //自動置中: 完整符合 $| 部份符合
  #reAutoCenter = /(?:^(?:累計|下載|下載\s*\w{3,5}|\w{3,5}\s*下載|\w{3,5}\s*檔案下載|項次|Number of Announcement|Number|Download|Download\s*\w{3,5}|No\.)$|序號|編號|排名|排行|代號|日期|Code|Rank|Ranking|Date)/i;

  //自動漲跌色的欄名:
  #reAutoColor = /^(?:漲跌|漲\/跌|Change)/i;

  //自動欄寬
  #autoWidth =  {
    '名稱': 8,
    'Name': 20
  }

  //最近一次查詢
  #formData = {}
  
  //分頁預設參數
  #paginationOptions = {}


  //在 constructor() 定值
  #isDev; //網址為 localhost
  #i18n; //多國語言字串
  #lan; // zh jp en
  #day; //日期相關內容
  #$ = {}; // jQuery HTML 元素

  submitCount = 0; //Submit次數
  lastSubmitTime = 0; //最後一次Submit時間
  tableHeadStickyTop = 0; //表頭吸頂的位置 初始及resize事件會更新此值
  elStickyTitle;



  //在 init() 定值
  #option;
  #tmpTableHead;  //複雜表頭範本
  apiAction = ''; //API路徑: 報表
  apiOption = ''; //API路徑: 選項
  apiAutocomplete = ''; //API路徑: 自動完成

  //在 #renderReports 定初值、排序時會變更這
  #JsonTables = [];
  
  //上次查詢回傳的日期
  #JsonDate = [];

  constructor() {
    const _ = this;

    if(typeof jQuery !== 'function') console.error('jQuery 需要先載入');

    _.#isDev = /^localhost\b/.test(location.host);

    const elMap = {
      body: 'body',
      form: '#tables-form',
      reports: '#reports',
      content: '#tables-content',
      message: '#tables-message'
    }
    for(let key in elMap) _.#$[key] = $(elMap[key]);

    const docLang = document.documentElement.lang;
    _.#lan = /^zh/i.test(docLang)?'zh':(/jp/i.test(docLang)?'jp':'en');

    ////// _.#lan = 'en'; /////測試英文版


    const isZ = _.#lan==='zh';
    const dToday = new Date(); //今日
    const dTomorrow = new Date(); dTomorrow.setDate(dToday.getDate()+1); //明日
    const dEndOfYear = new Date(dToday.getFullYear(),11,31); //年底 今年最後一天日期
    
    

    _.#day = {
      start: new Date(2009,0,1), //預設起始日 20090101
      today: dToday,
      tomorrow: dTomorrow,
      yearEnd: dEndOfYear,
      ymd: 'yyyy/mm/dd',
      WEEK: isZ?' (週)':' (Week)',
      YMD: isZ?'YYY/m/d':'mmm d, yyyy', //日期格式
      YM:  isZ?'YYY年m月':'mmm yyyy', //日期格式
      Y:   isZ?'YYY年':'yyyy' //日期格式
    }

    _.#i18n = isZ?{
      date:     '資料日期：',
      notes:    '註：',
      pageShow: '每頁 %s 筆',
      pageAll:  '全部',
      pagePrev: '上一頁',
      pageNext: '下一頁',
      pageFirst: '第一頁',
      pageLast:  '最後一頁',
      pageNumber: '第 %s~%s 筆，共 %s 筆'
    }:{
      date:     'Date: ',
      notes:    'Notes: ',
      pageShow: '%s records per page',
      pageAll:  'All',
      pagePrev: 'Prev',
      pageNext: 'Next',
      pageFirst: 'First',
      pageLast:  'Last',
      pageNumber: '%s-%s of %s records'
    }

    //分頁預設參數 https://flaviusmatis.github.io/simplePagination.js/
    _.#paginationOptions = {
      displayedPages: 3, //秀幾頁，最小3
      edges: 1, //尾秀幾頁
      ellipsePageSet: false, //中間點點點不能點
      prevText:  _.#i18n.pagePrev,
      nextText:  _.#i18n.pageNext,
      firstText: _.#i18n.pageFirst,
      lastText:  _.#i18n.pageLast,
      //以下須在創建時指定
      //items: allRecords, //資料總筆數
      //itemsOnPage: pageSize, //每頁筆數
      //onPageClick: $.proxy(_.#changePage, _, $pagination)  //翻頁事件
    }





  }

  init(cfg) {

    const _ = this;
    const $form = _.#$.form;
    const defaultOption = {
      pattern: '/{LANG}/{ACTION}',    //API路徑
      action: '',                     //報表API (必要) 會套入上面 PATTERN
      option: '',                     //選項API (非必要) 會套入上面 PATTERN
      autocomplete: 'api/codeQuery',  //自動完成API (不設時預設為api/codeQuery) 會套入上面 PATTERN
      autoLoad: false,           //頁面載入後自動查詢一次
      autoChange: false,         //變更表單時自動重新查詢
      serverPaging: false,       //分頁時採用 server 端分頁
      width: 6,                  //預設欄寬(中文字數或'auto')。(可無，預設7)
      paramKey: 'id',            //網址參數預設key。(可無)
      beforeInit: (cfg)=>{},     //callbacks: 在初始化之前被呼叫 (可無)
      afterFormInit: (cfg)=>{},  //callbacks: 表單初始後，下拉選項有值之後。 (可無)
      beforeRender: (J)=>{},     //callbacks: 表格API載入後、表格還沒繪出前(可無)。參數為即API讀取之JSON存入的變數(by reference)
      afterRender: ()=>{},       //callbacks: 頁面表格繪製完被呼叫 (可無)。若觸發分頁/排序事件只要表格內容重秀，都會重新被呼叫。
      customTable: {},           //客製表格type函式: {'名稱':(fields,data)=>{ 回傳完整HTML }}
      tables:[]                  //依照JSON回傳會有數量不同的選項
    }
    const defaultTableOption = {
      type: 'horizontal',      //表格型態。 可無。 (horizontal預設水平表格、vertical垂直表格)
      class: '',               //  <table> 上一層 .rwd-table 附加的 class 樣式
      align: '',               //對齊指令: 可無(自動)。
      sortable: false,         //排序: 可無，或 false 不排序。
      fieldTypes: [],          //強制指定欄位形態為 'String' 或 'Number'。例: [{index:0,type:'String'}]
      pagin: 0,                //每頁筆數: 可無，或 0不分頁 或 [10,25,50,100,0]。
      paginBtn: 3,             //分頁按鈕數，預設3
      title: '',               //表格大標題: 可無
      title2: '',              //表格大標題下面的大字: 可無
      subtitle: '',            //上左文字: 可無
      subtitle2: '',           //上右文字: 可無
      footnote: '',            //下左文字: 可無 (若用了「分頁器」，此值會被忽略。會顯示: 第x至x筆，共x筆)
      footnote2: '',           //下右文字: 可無 (若用了「分頁下拉選項」，此值會被忽略)
      notes: []                //表格下的註
    }

    if($form.length===0) console.error('頁面中需要 #tables-form 元素');
    if(_.#$.content.length===0) console.error('頁面中需要 #tables-content 元素');

    if(_.#$.reports.length===0) { //有些頁面漏掉  #reports
      const div = _.#$.content.parent();
      if(div[0].tagName==='DIV') {
        _.#$.reports = _.#$.content.parent();
        _.#$.reports.attr('id','reports');
      }
    }

    _.#$.reports.addClass('hide');


    $form.on('submit',()=>{ return false; }); //讓表單不能submit

    _.#option = Object.assign({},defaultOption,cfg);


    if(_.#option.width === '') _.#option.width = 6;


    if(cfg?.tables.length) { //看有幾個表格，補充表格預設值
      for(let i=0;i<cfg.tables.length;i++) _.#option.tables[i] = Object.assign({},defaultTableOption,cfg.tables[i]);
      _.#tmpTableHead = new Array(cfg.tables.length);
    }

    //複雜表頭範本 放入 _.#tmpTableHead 陣列
    let tmpTH = document.getElementById('theads');
    if(tmpTH !== null) {
      let theads = [...tmpTH.content.querySelectorAll('thead')].map(el=>el.innerHTML.strTrim().replace(/>\s+</g,'><'));
      for(let i=0;i<_.#tmpTableHead.length;i++) _.#tmpTableHead[i] = theads[i] || '';
    }
    else {
      for(let i=0;i<_.#tmpTableHead.length;i++) _.#tmpTableHead[i] = '';
    }


    const opt = _.#option;
    const langDir = { 'zh': 'zh-tw', 'en': 'en-us', 'jp': 'ja-jp' }

    //API路徑: 報表、選項
    _.apiAction   = opt.action?opt.pattern.replace(/\{LANG\}/,langDir[_.#lan]).replace(/\{ACTION\}/,opt.action):'';
    _.apiOption   = opt.option?opt.pattern.replace(/\{LANG\}/,langDir[_.#lan]).replace(/\{ACTION\}/,opt.option):'';
    _.apiAutocomplete = opt.autocomplete?opt.pattern.replace(/\{LANG\}/,langDir[_.#lan]).replace(/\{ACTION\}/,opt.autocomplete):'';

    _.#option.beforeInit(_.#option);


    //表頭吸頂的位置 初始及resize事件會更新此值
/*之前是動態多多出來的
    $('#layout>header').whenHas('.sticky-top.thehead',(el)=>{
      _.elStickyTitle = $('.sticky-top.thehead',el)[0];
      initShadowScrollbar();
    });
    現在又改回固定了
*/

    _.elStickyTitle = $('body>header')[0]; //固定的頁眉



    //各種初始, 順序不可變
    initTable();
    initScrollingState();
    initShadowScrollbar();
    initStickyTableHeaders();
    initForm(()=>{
      //待下拉選項載入完成要做的事...

      initURL();

      _.#option.afterFormInit(_.#option); //表單完成後

      if(opt.autoLoad) { //自動載入
        _.#doSubmitForm();
      }

      if(opt.autoChange) { //自動查詢
        $('[name]',$form).on('change',(ev)=>{
          const $input = $(ev.target);
          const isAutocomplete = $input.data('autocomplete') !== undefined; //自動完成輸入框
          
          const isTrusted = ev?.originalEvent?.isTrusted === true; //系統change事件
          
          if(isAutocomplete && isTrusted) return; //不理會: 自動完成且系統事件, 因為可能打一半
          //console.log('input change',$input.val());
          
          
          setTimeout(()=>{
            _.#doSubmitForm.bind(_)(); //棄用 $.proxy(_.#doSubmitForm,_)();  
          },300);
          
          
          
          
          
        });
      }

    });
    initAutocomplete();
    initPaging();

    //<a data-action="aaa/bbb">下載</a> 生出 href
    $('a[data-action]').each((i,a)=>{
      let $a = $(a);
      let url = opt.pattern.replace(/\{LANG\}/,langDir[_.#lan]).replace(/\{ACTION\}/,$a.data('action'));
      $a.prop('href',url);
    });


    ////////////////////////////////////////////////////////

    //初始: 網址參數填入表單
    function initURL() {

      const isZ = _.#lan==='zh';
      
      const day = _.#day;

      let qs = QUERY_STRING; //來自 _common.js
      if(!/[=]/.test(qs)) qs = (_.#option.paramKey+'='+qs);
      const params = new URLSearchParams(qs); //繞過弱掃
      const keys = [...new Set([...params.keys()])]; //不重覆的 key
      for(let key of keys) {
        let $input = $(`[name=${key}]`,$form).first();
        let value = params.get(key);

        if($input.length===0) { //input 不存在
          let el = document.createElement('input');
          el.type = 'hidden';
          el.name = key;
          el.value = value;
          $form[0].appendChild(el);
        }
        else {

          let type = ($input.attr('type') || $input[0].tagName).toLocaleLowerCase();

          //console.log(key,type,value);
          if($input.length===0) continue; //無此輸入

          if($input.hasClass('date')) { //日期類的
            _.#setDateValue($input,value)
          }
          else if(type === 'radio') {
            $(`[name="${key}"][value="${value}"]`,$form).prop('checked',true);
          }
          else if(type === 'checkbox') {
            let aValue = params.getAll(key);
            console.log(aValue);
            let $boxs = $(`[name="${key}"]`,$form).prop('checked',false);
            $boxs.each((i,el)=>{
              let $box = $(el);
              if(aValue.includes($box.val())) $box.prop('checked',true);
            });
          }
          else if(type === 'select') {
            //檢查 <option> 值存在才放值
            if( $(`[value="${value}"]`,$input).length ) $input.val(value);
          }
          else { //文字或其他
            $input.val(value);
          }

        }
      }


    }

    //初始: 空 table
    function initTable() {
      const opt = _.#option;

      //建立多個表格區空結構
      for(let tOpt of opt.tables) {

        let noteLI = tOpt.notes.map(s=>`<li>${s}</li>`).join('');

        let fieldWidth =
          isNaN(opt.width)? //非數字可用 '6em' 'auto' 等
            opt.width:
            ((Number(opt.width)+(tOpt.sortable?1.5:1))+'em'); //有排序還要加上左右白邊

        let htm = `
          <div class="table">
            <h2 aria-hidden="${tOpt.title?'false':'true'}">${tOpt.title}</h2>
            <h3 aria-hidden="${tOpt.title2?'false':'true'}">${tOpt.title2}</h3>
            <div class="top-hints"><div>${tOpt.subtitle}</div><div>${tOpt.subtitle2}</div></div>
            <div class="main-content">
              <div class="shadow-scrollbar"><b><i></i></b></div>
              <div class="rwd-table${tOpt?.class?(' '+tOpt.class):''}${tOpt?.type?(' type-'+tOpt.type):''}" style="--field-width: ${fieldWidth};"></div>
            </div>
            <div class="bottom-hints"><div>${tOpt.footnote}</div><div>${tOpt.footnote2}</div></div>
            <div class="pagination light-theme simple-pagination"></div>
            <div class="noteblock"><strong>${_.#i18n.notes}</strong><ol>${noteLI}</ol></div>
          </div>
        `;
        _.#$.content.append(htm);
      }


      //如果 <tr> 可以點擊 的事件
      $('.rwd-table.row-clickable',_.#$.content).on('click','tr',(ev)=>{
        const $tr = $(ev.currentTarget);
        const $a = $('a',$tr).first();
        window.open($a.attr('href'),$a.attr('target') || '_self');
        return false;
      });

    }

    //初始: 捲軸已捲動時在 .rwd-table 加上 scrolling，為了已捲時固定加陰影
    function initScrollingState() {
      const SCROLLING = 'scrolling';
      $('.rwd-table',_.#$.content).each((idx,wp)=>{
        let $wp = $(wp);
        let isScrolling = false;
        $wp.on('scroll',()=>{
          if(wp.scrollLeft>0 && !isScrolling) {
            $wp.addClass(SCROLLING);
            isScrolling = true;
          }
          if(wp.scrollLeft==0 && isScrolling) {
            $wp.removeClass(SCROLLING);
            isScrolling = false;
          }
        });
      });
    }

    //初始: 影子卷軸 <div class="shadow-scrollbar"><b><i></i></b></div>
    function initShadowScrollbar() {

      //計算頁眉高度: 當視窗 resize 時在 #tables-content 加上 --headerH: 標記
      //const layoutHeader = $('body>header')[0]; //elStickyTitle


      //計算layout固定標題位置的下面
      const calcHeaderSize = (ev)=>{
        const pos = _.elStickyTitle.getBoundingClientRect();
        _.#$.content[0].style.setProperty('--hh',`${parseInt(pos.top+pos.height,10)}px`);
      }
      window.addEventListener('resize',calcHeaderSize);
      calcHeaderSize();


/*
      //監視浮動標題樣式改變
      new MutationObserver((mutationsList, observer) => {
        for (const mutation of mutationsList) {
          if (mutation.type === 'attributes' && mutation.attributeName === 'style') calcHeaderSize();
        }
      }).observe(_.elStickyTitle, { childList: true, attributes: true });
*/





      $('.main-content',_.#$.content).each((idx, mainContent)=>{ //報表區 容器s


        let $wp = $('>.rwd-table',mainContent); // <table>的外包
        let $sc = $('>.shadow-scrollbar>b',mainContent); //捲軸框

        //上下雙軸同步捲動
        $wp.on('scroll',()=>{ $sc.scrollLeft($wp.scrollLeft()); }); //表格捲軸
        $sc.on('scroll',()=>{ $wp.scrollLeft($sc.scrollLeft()); }); //影子卷軸


        //監視表格出現，複製表格寬
        monitorTebleGenerated(mainContent,(mc)=>{





          let $table = $('table',$wp).first();
          if($table.length === 0) return;
          let changeValues = ()=>{
            mainContent.style.setProperty('--ssF', $table.css('width') ); //填充寬
            //仿製下卷軸大小
            mainContent.style.setProperty('--ssW',($wp[0].offsetWidth - $wp[0].clientWidth)+'px'); //軸寬
            mainContent.style.setProperty('--ssH',($wp[0].offsetHeight - $wp[0].clientHeight) +'px'); //軸高
          }
          changeValues();

          monitorTebleWidth($table[0],changeValues);
          monitorWidth($wp[0],changeValues);
        });


      });

      //監視表格 出現
      function monitorTebleGenerated(outer,callback) {
        new MutationObserver((mutationsList, observer) => {
          for (const mutation of mutationsList) {
            if (mutation.type === 'childList') callback(outer);
          }
        }).observe(outer, { childList: true, subtree: true });
      }
      //監視表格 寬改變
      function monitorTebleWidth(table,callback) {
        new MutationObserver((mutationsList, observer) => {
          for (const mutation of mutationsList) {
            if (mutation.type === 'attributes' && mutation.attributeName === 'style') callback(table);
          }
        }).observe(table, { childList: true });
      }
      //監視寬度改變
      function monitorWidth(el,callback) {
        new ResizeObserver((entries) => {
          for (const entry of entries) {
            if (entry.borderBoxSize) callback(entry);
          }
        }).observe(el);
      }
    }

    //初始: 吸頂表頭
    function initStickyTableHeaders() {




      const calcTHeadOffset = ()=>{

        if(_.elStickyTitle === undefined) return; //如果在頁面中間重載，頁眉會沒出現

        let y = window.scrollY; // = document.documentElement.scrollTop

        let hH = _.elStickyTitle.offsetTop + _.elStickyTitle.clientHeight; //頁眉高度

        //console.log(_.elStickyTitle);


        let wB = window.innerHeight + y; // 視窗底


        //表格s 只有 全秀無內Y軸 的
        document.querySelectorAll('.rwd-table').forEach((outer)=>{


          const table = outer.querySelector('table');
          const thead = outer.querySelector('thead');
          const shadowScrollbarHeight = outer.previousElementSibling.offsetHeight; //影子卷軸高
          //const shadowScrollbarHeight2 = parseInt(outer.parentElement.style.getPropertyValue('--ssH').slice(0,-2),10); //與上面那行等效



          if( table == null || thead == null) return;

          const t  = table.getBoundingClientRect();
          const tTY = y  + t.top;    //表格 頂Y
          const tBY = tTY+ t.height; //表格 底Y

          //console.log(`${tTY} > ${wB} ? ${tBY} < ${y}? `);

          if(tTY > wB) return; //表頂 在可視下面
          if(tBY < y ) return;   //表底 在可視上面

          let topPaddingH = hH+shadowScrollbarHeight; ///眉高+軸高

          let theadOffset = t.top > topPaddingH ? 0: Math.round((t.top*-1)+topPaddingH) ; //表格 在 螢幕上緣 之下 或 上

          thead.style.setProperty('--thead-offset',`${theadOffset}px`);
        });



      }

      window.addEventListener('scroll',calcTHeadOffset);
      window.addEventListener('resize',calcTHeadOffset);


    }


    //初始: form
    function initForm(cb) {
      const isZ = _.#lan==='zh';
      const day = _.#day;

      const datePickerLocale = isZ? {
        "format": "YYYY/MM/DD",
        "separator": " 至 ",
        "applyLabel": "確定",
        "cancelLabel": "清除",
        "fromLabel": "從",
        "toLabel": "至",
        "customRangeLabel": "Custom",
        "weekLabel": "星期",
        "daysOfWeek": ["日","一","二","三","四","五","六"],
        "monthNames": ["1月","2月","3月","4月","5月","6月","7月","8月","9月","10月","11月","12月"],
        "firstDay": 1
      }:{
        "format": "YYYY/MM/DD",
        "separator": " - ",
        "applyLabel": "Apply",
        "cancelLabel": "Clear",
        "fromLabel": "From",
        "toLabel": "To",
        "customRangeLabel": "Custom",
        "weekLabel": "W",
        "daysOfWeek": ["Su","Mo","Tu","We","Th","Fr","Sa"],
        "monthNames": ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sept','Oct','Nov','Dec'],
        "firstDay": 1
      }


      //選日預設選項
      const drpDefOption = {
        "isROC": isZ,
        "autoUpdateInput": false,
        "singleDatePicker": true,
        "showDropdowns": true,
        "locale": datePickerLocale,
        "autoApply": true,
        "maxDate": day.yearEnd
      }

      const fnClear = (ev,picker)=>{
        picker.element.val('');
      }

      const drp = '.daterangepicker'; // events: show hide apply cancel showCalendar hideCalendar
      const cdrp = 'Calendar.daterangepicker';

      //選日事件
      const drpEvH = (ev,picker)=>{
        //console.log('drp event:',ev.type);
        const $input = $(ev.target);
        const d = picker.startDate.toDate(); //目前選中日期
        const calendarD = picker.leftCalendar.calendar.firstDay._d; //月曆的第1天

        switch(ev.type) {
          case 'apply': //[確定]
            $input.val(d.format(day.YMD));           //顯示用
            $input.data('value',d.format(day.ymd));  //表單用
            $input.trigger('change');
            break;
        }
      }

      //選日
      $('input.date[data-format=D]',$form).each((idx,input)=>{
        let $input = $(input);

        let opt = $.extend({},drpDefOption,{ //克隆預設選項
          "minDate": $input.data('start')?.toString().toDate() || day.start //起始日
        });

        if($input.data('end')) opt.maxDate = $input.data('end').toString().toDate(); //若有限日曆最後一天

        $input.prop('readonly',true).daterangepicker(opt)
        .on('show'+drp,drpEvH)
        .on('hide'+drp,drpEvH)
        .on('apply'+drp,drpEvH)
        .on('show'+cdrp,drpEvH)
        .on('hide'+cdrp,drpEvH);

/*
        .on('apply'+drp, (ev,picker)=>{
          console.log('Event:',ev.type);
          const $input = $(ev.target);
          const d = picker.startDate.toDate();
          $input.val(d.format(day.YMD));
          $input.data('value',d.format(day.ymd));
          $input.trigger('change');
        });
*/

        //表單預設值
        if($input.val()){
          let defDay = $input.val().toDate();
          $input.data('daterangepicker').setStartDate(defDay); //預設日
          $input.data('value',defDay.format(day.ymd));  //表單用
        }


      });


      //選週
      $('input.date[data-format=W]',$form).each((idx,input)=>{
        let $input = $(input);
        let opt = $.extend({},drpDefOption,{ //克隆預設選項
          "isWeekRange": true,
          "minDate": $input.data('start')?.toString().toDate() || day.start //起始日
        });

        if($input.data('end')) opt.maxDate = $input.data('end').toString().toDate(); //若有限日曆最後一天


        $input.prop('readonly',true).daterangepicker(opt)
        .on('apply.daterangepicker', function(ev,picker) {
          const $input = $(ev.target);
          const d = picker.startDate.toDate();
          $input.val(d.format(day.YMD)+day.WEEK);
          $input.data('value',d.format(day.ymd));
          $input.trigger('change');
        });








        //表單預設值
        if($input.val()){
          let defDay = $input.val().toDate();
          $input.data('daterangepicker').setStartDate(defDay); //預設日
          $input.data('value',defDay.format(day.ymd));  //表單用
        }

      });


      //選年月: 長出下拉選項
      $('input.date[data-format=M],input.date[data-format=MA],input.date[data-format=Y],input.date[data-format=YA]',$form).each((idx,input)=>{

        const $input = $(input);
        const inputFormat = $input.data('format');
        const minDate = $input.data('start')?.toString().toDate() || day.start //起始日
        const maxDate = $input.data('end')?.toString().toDate() || day.tomorrow; //結束日
        const minY = minDate.getFullYear();
        const maxY = maxDate.getFullYear();


        //產生年月下拉選項
        let yOp = ''; for(let y=maxY; y>=minY; y--) yOp += `<option value="${y}">${isZ?(y-1911)+'年':y}</option>`;
        let mOp = datePickerLocale.monthNames.map((v,i)=>`<option value="${i+1}">${v}</option>`).join('');

        if(inputFormat==='MA') mOp = `<option value="">${isZ?'年度':'All'}</option>`+mOp;
        if(inputFormat==='YA') yOp = `<option value="ALL">${isZ?'全部':'All'}</option>`+yOp;

        if(/^M/.test(inputFormat))
          $input.after(`<select class="select-year">${yOp}</select><select class="select-month">${mOp}</select>`);
        else if(/^Y/.test(inputFormat))
          $input.after(`<select class="select-year">${yOp}</select>`);

        //預設始值
        const $selY = $input.next();
        const $selM = /^M/.test(inputFormat)?$selY.next():null;
        const today = _.#str864ToDate( $input.val() );
        const todayY = today.getFullYear();
        const todayM = today.getMonth();
        const month1st = new Date(todayY,todayM,1); //該月1日


        const initVal = $input.data('initial');

        //console.log(inputFormat,$input.val(),today.format(day.ymd));
        //值為 "2024/06/01"
        if(inputFormat==='M') { //年月
          $input.val(initVal===undefined?month1st.format(day.ymd):initVal);
          $selY.val(todayY);
          $selM.val(todayM+1);
        }
        else if(inputFormat==='Y') { //年
          $input.val(initVal===undefined?todayY:initVal);
          $selY.val(todayY);
        }
        else if(inputFormat==='MA') { //年月含全部
          let v = $input.val().replace(/\D/g,'');
          if(v.length===4) {
            $selY.val(v);
          }
          else if(v.length>=6) {
            $selY.val(v.substr(0,4));
            $selM.val(parseInt(v.substr(4,2),10));
          }
        }
        else if(inputFormat==='YA') { //年含全部
          let v = $input.val();
          if(/^(\d{4})/.test(v)){ // input 有指定值就改變 下拉位置,
            $selY.val(RegExp.$1);
          }
          else { //否則就放預設值:下拉預設(第一個)
            $input.val($selY.val());
          }

        }
      });


      //選年月: 下拉選項事件
      $('.select-year, .select-month',$form).on('change',(ev)=>{
        const $el = $(ev.target);
        let $selY = null;
        let $selM = null;
        let isChangeY = false; //變更年事件

        //決定年月的<select>
        if($el.hasClass('select-month')){
          $selM = $el;
          $selY = $selM.prev();
        }
        else if($el.hasClass('select-year')) {
          $selY = $el;
          isChangeY = true;
        }
        if($selM===null && $selY.next().hasClass('select-month')) $selM = $selY.next();


        const $input = $selY.prev();
        const inputFormat = $input.data('format');
        const minDate = $input.data('start')?.toString().toDate() || day.start //起始日 或用 預設
        const maxDate = $input.data('end')?.toString().toDate() || day.tomorrow; //結束日  或用 預設
        const minY = minDate.getFullYear();
        const maxY = maxDate.getFullYear();
        const minM = minDate.getMonth() + 1;
        const maxM = maxDate.getMonth() + 1;
        const selY = parseInt($selY.val(),10); //目前選中的 年

        //禁用月份超過的選項
        if(isChangeY && $selM!==null) {
          const $optM = $('option',$selM).prop('disabled',false);
          if(selY === maxY) {
            $optM.filter((i,el)=>(parseInt($(el).val(),10) || 0)>maxM).prop('disabled',true);
          }
          else if(selY === minY) {
            $optM.filter((i,el)=>(parseInt($(el).val(),10) || 0)<minM).prop('disabled',true);
          }
        }





        let srtVal = '';

        if(inputFormat==='M') {
          srtVal = new Date($selY.val(),$selM.val()-1,1).format(day.ymd);
        }
        if(inputFormat==='MA') {
          let y = $selY.val()
          let m = $selM.val()
          srtVal = m===''?y:(y+String(m).padStart(2,'0'));
        }
        if(/^Y/.test(inputFormat)) {
          srtVal = $selY.val();
        }

        $input.data('value',srtVal).val(srtVal).trigger('change');

      });

      //日期選項不可大於當月
      //$('input.date[data-format^=M]+select',$form).trigger('change');







      //無障礙自動ID
      let autoNum = 1;
      $('label+input, label+select',$form).each((idx,input)=>{
        let $input = $(input);
        const $label = $input.prev();
        if($input.is(':hidden')) $input = $input.next(); // input[data-format=M Y MA MY] 是隱藏的，用下一個
        let idName = $input.attr('id');
        if(typeof idName === 'undefined') { //沒有ID的給定一個流水號ID
          idName = '___auto'+(autoNum++);
          $input.attr('id',idName);
        }
        $label.attr('for',idName);
      });
      //點擊radio後面的input，要選取它
      $('input[type=radio]+.row',$form).on('click',(ev)=>{
        const $row = $(ev.currentTarget);
        const $radio = $row.prev();
        $radio.prop('checked',true).trigger('change');
      });


      //======== 按鈕

      //查詢
      $('[type=submit]',$form).on('click',_.#doSubmitForm.bind(_)); // 棄用$.proxy(_.#doSubmitForm,_)

      //下載 / 列印
      $('button.response',$form).on('click',(ev)=>{
        
        const $button = $(ev.target);
        const FORMAT = $button.data('format');
        
        //前端列印功能
        if(FORMAT==='print') {
          _.doPrintTable($button);
          return;
        }
        
        

        //檢查表單驗證
        if(!$form[0].checkValidity()){
            $form[0].reportValidity();
            return false;
        }

        const $captcha = $('[data-format=captcha]',$form);
        if($captcha.length && $captcha.val()==='') {
          alert('請勾選我不是機器人!');
          return;
        }


        let strData = _.#getFromSerialize();
        strData += ('&response='+FORMAT);
        
        
        //排序參數 order=0&sort=asc|desc
        const $table1 = $('.table',_.#$.content).first();
        const $sortTH = $('.rwd-table.sortable thead',$table1).find('.desc, .asc'); //第1個表格 有 asc desc 的
        const orderIdx = $sortTH.index();
        if(orderIdx>-1) strData += ( '&order='+ orderIdx +'&sort='+ ($sortTH.hasClass('desc')?'desc':'asc') );


        window.open(_.apiAction+'?'+strData,'_blank');

        //重置我不是機器人
        if($captcha.length) {
          $captcha.val('');
          grecaptcha.reset();
        }


      });
      
      
      //返回 按鈕
      $('button.home',$form).on('click',(ev)=>{ window.location.href = '/'; });
      $('button.back',$form).on('click',(ev)=>{ history.back();});

      //下拉選單
      if(_.apiOption) {

        let keys = [...$('select[data-option]',$form)].map(el=>$(el).data('option'));
        let argv = keys.map(s=>'name='+s).join('&');

        $.get(_.apiOption,argv,(J)=>{

          if(J?.stat !== 'ok') {
            console.error('Error:', J?.stat); return;
          }

          for(let key of keys){
            if(!(key in J.options)) {
              console.error(`Option '${key}' not exist.`);
              continue;
            }

            const $select = $(`select[data-option="${key}"]`,$form);

            for(let o of J.options[key]) {
              let op = new Option(o.text,o.value);
              $select[0].add(op);
            }

          }

          cb();
        });



      }
      else {
        cb();
      }

      //<select>樣式
      $('select',$form).addClass('selectobj');


      //我不是機器人
      const $captcha = $('[data-format=captcha]',$form);
      if($captcha.length==1) {
        if(typeof(grecaptcha) !== 'object') {
          console.error('需要 <script src="https://www.google.com/recaptcha/api.js?render=explicit"></script>');
          return;
        }

        $captcha.after('<div id="gRecaptcha"></div>');

        setTimeout(()=>{
          grecaptcha.render('gRecaptcha',{
            'theme':'light',
            'size':'normal',
            'sitekey':RECAPTCHA,
            'callback':(resp)=>{
              $captcha.val(resp);
            },
            'expired-callback': ()=>{
              $captcha.val('');
              grecaptcha.reset();
            }
          });
        },300)





      }
      if($captcha.length>1) {
        console.error('不適用多個captcha');
      }


    }

    //初始: 自動完成
    function initAutocomplete() {

      //if(isDev) { _.apiAutocomplete = '/test-proxy/tpex_www/zh-tw/api/codeQuery'; }


      const types = {
        '/mainboard/': 'stk_reg',
        '/esb/': 'stk_esb',
        '/gisa/': 'stk_gisa'
      }

      const colors = {
        '上櫃': ' mega1',
        '興櫃': ' mega2',
        '創櫃': ' mega3'
      }


      let defaultType = 'stk_all';
      for(let key of Object.keys(types)) if(REQUEST_URI.indexOf(key)>-1) defaultType = types[key]; //網址符合的類別

      //https://github.com/devbridge/jQuery-Autocomplete
      $('[data-autocomplete]',$form).each((undefined,input)=>{
        
        let strType  = $(input).data('autocomplete') || defaultType;
        
        //https://github.com/devbridge/jQuery-Autocomplete
        $(input).autocomplete({
          width: 180,
          serviceUrl: _.apiAutocomplete,
          dataType: 'json',
          params: { type: strType },
          groupBy: 'category',
          preserveInput: true,  //股票自動完成，鍵盤上下選動時(沒點或按Enter前)，不改變input值
          formatGroup: (suggestion, category)=> {
            let clsName = ' mega11'; //預設顏色
            for(let key of Object.keys(colors)) if(category.indexOf(key) ===0) clsName = colors[key];
            return `<div class="autocomplete-group${clsName}">${category}</div>`;
          },
          transformResult: (resp)=>{
            const out = [];
            for(let oCategory of resp.suggestions) {
              for(let strVal of oCategory.data ) {
                let v = strVal.split('\t');
                out.push({ value: v[0], data: { category: oCategory.type, sid: v[1] } });
              }
            }
            return({suggestions:out});
          },
          onSelect: (suggestion)=>{
            input.value = suggestion.data.sid;
            $(input).trigger('blur'); //按Enter後關掉
            
            //$(input).trigger('change'); //人工觸發 會造成 自動完成再出現
            _.#doSubmitForm(); //不能用 _.#doSubmitForm.bind(_); 因為還沒初始
            
          }
        }).on('focus',(ev)=>{
          $(ev.target).trigger('select');
        }).on('keydown',(ev)=>{
          //按 Enter 要送出表單
          //if(ev.key==='Enter') $(input).trigger('change');  //  不能用 _.#doSubmitForm.bind(_); 因為還沒初始
          if(ev.key==='Enter') _.#doSubmitForm();
        });


      });

    }
    
    

    //初始: 分頁器
    function initPaging() {

      const i18n = _.#i18n;
      const $content = _.#$.content; //報表區 容器
      const $paginations = $('.pagination',$content); //分頁器 容器(多個)
      const $bottomHints = $('.bottom-hints',$content); //每頁幾筆 容器(多個)

      $paginations.each((idx,$pagination)=>{
        let opt = _.#option.tables[idx]; //表格設定選項
        if(Array.isArray(opt.pagin)) { //每頁幾筆 下拉選單
          let pageOpts = opt.pagin.map(n=>`<option value="${n}">${n===0?i18n.pageAll:n}</option>`); //全部
          let pageSelect = i18n.pageShow.replace('%s',`<select>${pageOpts}</select>`); //每頁 %s 筆
          let $div = $bottomHints.eq(idx).find('div:last-child');
          $div.html(pageSelect).find('select').on('change',changePageSize.bind(_));  //棄用 $.proxy(changePageSize,_)
        }
      });
      //////////
      //分頁器: 更換每頁筆數
      function changePageSize(ev) {

        const _ = this;

        const $pageSizeSelect = $(ev.target);
        const $wp = $pageSizeSelect.closest('.table');
        const $mainContent = $('>.main-content',$wp);
        const $tableTag = $('.rwd-table>table',$wp);

        const tableIndex = $wp.index(); //此表索引
        const op = _.#option.tables[tableIndex]; //此表選項
        const pageSize = parseInt( Array.isArray(op.pagin)? $('.bottom-hints select',$wp).val(): op.pagin,10);

        //let tbodyData = _.#JsonTables[tableIndex].data; //完整的 tbody 資料

        const $pagination = $('.pagination',$wp);
        if(!$pagination.is(':empty')) $pagination.pagination('destroy'); //先移掉舊的分頁器

        //重建分頁器
        if(pageSize>0) {  //要分頁 (總筆數>0)

          let t = _.#JsonTables[tableIndex];

          let allRecords = opt.serverPaging?t.totalCount:t.data.length; //實際總筆數(不分前後端)

          //創建分頁器
          $pagination.pagination(Object.assign({},_.#paginationOptions,{
            items: allRecords, //資料總筆數
            itemsOnPage: pageSize, //每頁筆數
            displayedPages: op.paginBtn, //分頁按鈕數量
            onPageClick: _.#changePage.bind(_,$pagination)  //翻頁事件 棄用 $.proxy(_.#changePage, _, $pagination)
          }));

        }


        $mainContent.addClass('load');


        //擷取要顯示的那頁資料, 因為會有後端分頁所以會有 callback
        _.#loadTablePageData(tableIndex,1,pageSize,(displayArray, recordInfo)=>{

          //左下文字
          if(recordInfo !== null) $('.bottom-hints>div:first-child',$wp).text(recordInfo);

          //tbody內容
          $('tbody',$wp).html(displayArray.map( tr => '<tr>'+tr.map(td=>`<td>${td?td.toString():''}</td>`).join('')+'</tr>').join(''));
          _.#autoChangeColor(); //漲跌顏色
          opt.afterRender(_,tableIndex,displayArray); //分頁/排序器產表完成後


          $mainContent.removeClass('load');

        });

      }

    }

  }


  //轉日期 年月日、年月、年
  #str864ToDate(str) {
    let v = str.replace(/\D/g,'');
    if(v.length===4) v += '0101';
    else if(v.length===6) v += '01';
    else if(v.length!==8) return new Date(); //日期格式不對回傳今日

    let d = new Date(parseInt(v.substr(0,4),10), parseInt(v.substr(4,2),10)-1, parseInt(v.substr(6,2),10));

    return d;
  }

  //取得 form 全部元素的值: 資料物件
  #getFromSerializeObject() {
    const _ = this;
    _.submitCount++; //第幾次submit

    let o = _.#$.form.serializeObject();
    if('g-recaptcha-response' in o) delete o['g-recaptcha-response']; //移掉我不是機器人, 用自己的
    for(let key of Object.keys(o)) {
      let $input = $(`[name="${key}"]`,_.#$.form);
      let value = $input.data('value');
      let dataFormat = $input.data('format');
      let dataInitial = $input.data('initial');

      if(typeof(value) !== 'undefined') o[key] = value; //日期欄 data-format="D" 或 data-format="W"

      if(_.submitCount===1 && dataFormat === 'YA' && typeof(dataInitial) !== 'undefined') {
        o[key] = dataInitial;
      }


    }
    return o;
  }
  //取得 form 全部元素的值: 查詢字串
  #getFromSerialize() {
    const _ = this;
    const o = _.#getFromSerializeObject();


    const searchParams = new URLSearchParams();
    for(let key of Object.keys(o)) {
      if(Array.isArray(o[key])) {
        o[key].forEach(v=>searchParams.append(key,v));
      }
      else {
        searchParams.append(key, o[key]);
      }
    }

    return searchParams.toString();
  }

  //填入日期值
  #setDateValue($input,value) {
    if($input.length===0) return;

    const _ = this;
    const drp = $input.data('daterangepicker');
    const day = _.#day;
    let d = _.#str864ToDate(value);



    let f = $input[0].dataset.format; //有時讀不到$input.data('format');

    if(f=='D') {
      if(value==='') {
        $input.data('value',''); //給選日的預設值
        $input.val(''); //顯示
        return;
      }
      $input.data('value',d.format(day.ymd)); //給選日的預設值
      $input.val(d.format(day.YMD)); //顯示
      drp?.setStartDate(d);
      drp?.setEndDate(d);
    }
    if(f=='W') {
      $input.data('value',d.format(day.ymd)); //給選日的預設值
      $input.val(d.format(day.YMD)+day.WEEK); //顯示
    }
    if(f=='M' || f=='MA') {
      $input.val(d.format(day.ymd));
      let $sY = $input.next();
      let $sM = $sY.next();
      $sY.val(d.getFullYear()); //還原下拉
      $sM.val(d.getMonth()+1);
    }
    if(f=='Y') {
      $input.val(d.getFullYear());
      let $sY = $input.next();
      $sY.val(d.getFullYear()); //還原下拉
    }
    if(f=='YA') {
      $input.val(value);
      let $sY = $input.next();
      $sY.val(value==='ALL'?'ALL':d.getFullYear()); //還原下拉
    }

  }

  //Submit Form動作
  #doSubmitForm() {
    
    
    //此函式呼叫要經過 $.proxy，否則 this 無法預期
    const _ = this;
    //console.log('dosubmit',_);
    
    const opt = _.#option;

    //避免短時間submit
    const currentTime = new Date().getTime();
    if (currentTime - _.lastSubmitTime < 500) return;
    _.lastSubmitTime = currentTime;

    //非翻頁 且 表單驗證不過  
    if(!opt.serverPaging){
      if(!(_.#$.form[0].checkValidity())) {
        _.#$.form[0].reportValidity();
        return; 
      }
    } 
    
    
    
    

    //有我不是機器人而且沒勾
    const $captcha = $('[data-format=captcha]',_.#$.form);
    if($captcha.length && $captcha.val()==='') {
      alert('請勾選我不是機器人!');
      return;
    }


    _.#$.reports.removeClass('error').addClass('load');
    _.#$.message.empty();

    _.#formData = _.#getFromSerializeObject(); //保留最近一次查詢給後端翻頁用



    let oData = Object.assign({},_.#formData); //克隆最近一次查詢
    oData['response'] = 'json';


    if(opt.serverPaging) { //後端分頁
      oData['paging-offset'] = 0;
      const pgSize = opt.tables[0].pagin;
      oData['paging-size'] = Array.isArray(pgSize)?pgSize[0]:pgSize;
    }



    if(_.apiAction==='') { //沒有 action 參數時
      _.#renderReports({stat:'ok'});
    }
    else {

      $.post(_.apiAction,oData, _.#renderReports.bind(_) ,'json'); //棄用 $.proxy(_.#renderReports,_)

      //重置我不是機器人
      if($captcha.length) {
        $captcha.val('');
        grecaptcha.reset();
      }

    }




  }

  //按查詢載入JSON後: 更新表格內容
  #renderReports(J) {
    //此函式呼叫要經過 $.proxy，否則 this 無法預期
    const _ = this;
    const $form = _.#$.form;
    const $content = _.#$.content;

    /*
    _.#$.body: 'body',
    _.#$.form: '#tables-form',
    _.#$.reports: '#reports',
    _.#$.content: '#tables-content',
    _.#$.message: '#tables-message',
    _.#$.notes: '#tables-notes'
    */


    if(J.stat!=='ok') {
      _.#$.message.safeHtml(J.stat.replace(/\n/g,'<br>'));
      _.#$.reports.removeClass('hide load').addClass('error');
      return;
    }

    const opt = _.#option;

    opt.beforeRender(J); //修飾JSON變數 by reference
    




    if(opt.tables.length != J.tables.length) {
      alert('系統維護中');
      console.error(`表格數量無法匹配。初始 ${opt.tables.length} 個、API ${J.tables.length} 個`);
      return;
    }


    _.#JsonTables = J.tables; //表格資料存入公用區
    
    

    if(!('tables' in J)) {
       _.#$.message.text('系統維護中');
       _.#$.reports.removeClass('hide load').addClass('error');
      console.error("No 'tables' in the returned JSON.");
      return;
    }

    //回填 form 中的日期
    if(J?.date) {
      let aDate = J.date.split(/[\s\~\-\,]+/);
      _.#JsonDate = [];
      aDate.forEach((v,i)=>{
        _.#setDateValue($('input.date',$form).eq(i),v);
        _.#JsonDate.push(v.toDate()); 
      });
    }
    else {
      _.#JsonDate = [];
    }

    // 覆寫 options 的 tables 的 title title2 subtitle subtitle2 footnote footnote2 notes
    _.#JsonTables.forEach((t,i)=>{
      for(let key of ['title','title2','subtitle','subtitle2','footnote','footnote2','notes']) {
        if(key in t) opt.tables[i][key] = t[key];
      }
    });




    //更新 至 view 標題及說明等
    opt.tables.forEach((o,i)=>{
      const $t= $('>.table',$content).eq(i);
      const $topHints = $('.top-hints>div',$t);
      const $bottomHints = $('.bottom-hints>div',$t);

      $('h2',$t).html(o.title).attr('aria-hidden',o.title?'false':'true');
      $('h3',$t).html(o.title2).attr('aria-hidden',o.title2?'false':'true');
      

      $topHints.eq(0).html(o.subtitle);
      $topHints.eq(1).html(o.subtitle2);
      $bottomHints.eq(0).html(o.footnote);
      if(!Array.isArray(o.pagin)) $bottomHints.eq(1).html(o.footnote2); //不為分頁下拉才可以更新成文字
      $('.noteblock>ol',$t).html(o.notes.map(s=>`<li>${s}</li>`).join(''));
    });

    //產表格
    _.#JsonTables.forEach((t,i)=>{

      //t: API回傳的每個表格資料 {}

      const op = opt.tables[i]; //此表選項
      
      const $table = $('>.table',$content).eq(i); //各組報表最外層
      const $rwdTable = $('.rwd-table',$table); //<table>上一層

      //表格API為空( data 都不存在就整個表格不秀)
      if(!('data' in t)) {
        console.log('empty table',i);
        $rwdTable.empty();
        $table.addClass('hide');
        return;
      }
      $table.removeClass('hide');

      //有 data 但 null 不秀表格但標題那些要秀
      if(t.data===null) {
        $rwdTable.empty();
        return;
      }


      const tth = _.#tmpTableHead[i]; //複雜表頭HTML

      //每頁筆數: 若沒分頁則 0，有則取數字或第一個陣列值
      const pageSize = parseInt( Array.isArray(op.pagin)? $('.bottom-hints select',$table).val(): op.pagin,10);

      //判斷各欄是否為數字，把結果加入JSON  tables[n].fieldsIsNum
      //視為數字的格式: 123、1.23、1,234、1,234.5、.1234、前有無 +-$ 號、後有無%、 ---
      t.fieldsIsNum = (t.data?.length && Array.isArray(t.data[0]))? t.data[0].map(s => /^(?:[\-\+\$]?\s?[\d,]+(?:\.\d+)?%?|[\-]{1,3}|\.\d+)$/.test(s) ):[];
      //強制指定某欄為字串或數字 (給排序使用)
      if(t.fieldsIsNum.length && op.fieldTypes.length ) {
        for(let col of op.fieldTypes) {
          t.fieldsIsNum[col.index] = col.type === 'Number'?true:false;
        }
      }
      
      //console.log('fieldsIsNum:',t.fieldsIsNum);
      

      //是否為民國日期
      t['fieldsIsROC'] = (t.data?.length && Array.isArray(t.data[0]))? t.data[0].map(s => /^\d{2,3}[\/\.\-]\d{1,2}[\/\.\-]\d{1,2}$/.test(s) ):[];


      //需要前端對資料預先排序?
      _.#sortTableJsonArray(t,op.sortable);


      //參數: (表格陣列,每頁筆數,頁碼)。回傳: 要顯示的陣列、「%s - %s 筆，共 %s 筆」
      let {displayArray,recordInfo} = _.#pageViewOfArray(t,pageSize,1);


      //左下文字
      if(pageSize && recordInfo !== null) $('.bottom-hints>div:first-child',$table).text(recordInfo);

      //產<table>內容
      let htm = '';

      //產完整的<table>內容
      switch(op.type) {
        case 'horizontal': //正常: 橫式表格
          htm = makeTable(tth || t?.fields || '',displayArray,t?.summary || []);
          //console.log(htm);
          break;
        case 'vertical': //直式表格
        case 'grid': //網格
          htm = htm = makeTableVertical(t?.fields || '', displayArray);
          break;
        case 'link': //連結按鈕
          htm = makeTableLinkButton(t?.fields || '', displayArray);
          break;
        default: //客製表格
          if( op.type in opt.customTable ) {
            htm = opt.customTable[op.type](t?.fields || '', displayArray);
          }
          else {
            console.error(`Custom Table does not exist: ${op.type}`);
          }
          break;
      }
      $rwdTable.html(htm);

      let $tableTag = $('>table',$rwdTable);
      let $thead = $('thead',$tableTag);







      //初始化: 排序
      makeSortableTH(op,$thead);

      //對齊類別
      if(op.type==='horizontal') makeAlignStyle(op,t,$tableTag);


      //開發時欄順序數字
      if(_.#isDev) {
        $('.sort',$thead).each((idx,sort)=>{
          $(sort).append(`<i>${idx+1}</i>`);
        });
      }


      //重建分頁器
      if(pageSize>0) {  //要分頁 (總筆數>0)

        let $pagination = $('.pagination',$table);
        if(!$pagination.is(':empty')) $pagination.pagination('destroy'); //先移掉舊的分頁器

        let allRecords = opt.serverPaging?t.totalCount:t.data.length; //實際總筆數(不分前後端)

        if(allRecords>pageSize) { //總筆數 > 分頁數 才秀分頁器

          //創建分頁器
          $pagination.pagination(Object.assign({},_.#paginationOptions,{
            items: allRecords, //資料總筆數
            itemsOnPage: pageSize, //每頁筆數
            displayedPages: op.paginBtn, //分頁按鈕數量
            onPageClick: _.#changePage.bind(_, $pagination)  //翻頁事件  棄用$.proxy(_.#changePage, _, $pagination)
          }));
          

        }


      }





    });

    //表格外的總結
    $('+.blockset',_.#$.content).remove(); //表格區(#tables-content)下面的總結
    if(J?.summary) {
      _.#$.content.after('<div class="blockset center">'+Object.keys(J.summary).map(k=>`<div class="item"><p>${k}</p><p class="h2">${J.summary[k]}</p></div>`).join('')+'</div>');
    }

    //下載按鈕狀態
    const allRec = J.tables.reduce( (recSum,a)=>recSum + (a?.data?.length || 0) , 0); //不分表格全部的資料筆數

    $('button[data-format]',_.#$.form).prop('disabled',allRec===0?true:false);


    _.#autoChangeColor(); //漲跌顏色
    opt.afterRender(_,-1,J); //首次產表產完成後

    _.#$.reports.removeClass('hide load');

    /////////////////////////////////



    //對齊指令
    function makeAlignStyle(op,t,$tableTag){


      const fields = t.fields; //欄名

      let aCMD = []; //對齊指令
      let isAuto = op.align === ''; //自動模式

      if(!isAuto) {
        aCMD = op.align.strTrim().split(/\s+/);
        if(aCMD[0]==='auto') {  //自動+手動模式
          aCMD.shift();
          isAuto = true;
        }
      }

      //收集
      const maxIdx = t.fieldsIsNum.length - 1; //最大索引
      let aLRC = new Array(maxIdx+1).fill(''); //即將要放入各欄是 R|L|C

      let colWidth = new Array(maxIdx+1); // 欄寬 [[欄,寬],...]
      let minWidth = new Array(maxIdx+1); // 最小 [[欄,寬],...]
      let maxWidth = new Array(maxIdx+1); // 最大 [[欄,寬],...]

      let classNames = []; //歸納結果
      let fixedIndex = -1; //固定欄

      //自動
      if(isAuto){

        fixedIndex = 0; //固定第1欄

        //依是否數字決定左右
        aLRC = t.fieldsIsNum.map(isNum=>isNum?'R':'L');

        //自動置中 or 自動欄寬
        fields?.forEach((strField,i)=>{
          if(_.#reAutoCenter.test(strField)) aLRC[i] = 'C'; //自動置中
          if(strField in _.#autoWidth) minWidth[i] = _.#autoWidth[strField]; //自動欄寬
          
          if(_.#reAutoFixed.test(strField)) fixedIndex = i; //自動固定
        });

      }

      //手動
      if(aCMD.length > 0) {
        aCMD.sort();
        for (let cmd of aCMD) {

          if(/^([FLRC])(\d+)$/.test(cmd)) {
            let c = v(1);  // F R L C
            let colIdx = v(2)-1; //欄索引
            if(c==='F') fixedIndex = colIdx; else aLRC[colIdx] = c;
          }
          else if(/^([LRC])(\d+)[~_]$/.test(cmd)) {
            let c = v(1);  // R L C
            let colIdx = v(2)-1; //欄索引
            for(let i=colIdx;i<=maxIdx;i++) aLRC[i] = c;
          }
          else if(/^W(\d+)=(\d+)$/.test(cmd)) { //欄寬
            colWidth[v(1)-1] = v(2);
          }
          else if(/^mW(\d+)=(\d+)$/.test(cmd)) { //最小寬
            minWidth[v(1)-1] = v(2);
          }
          else if(/^MW(\d+)=(\d+)$/.test(cmd)) { //最大寬
            maxWidth[v(1)-1] = v(2);
          }
          else {
            console.warn('未知 align 指令:',cmd);
          }



        }

      }


      //歸納結果、連序LR簡化
      if(fixedIndex>-1) classNames.push('F'+(fixedIndex+1));

      //若與上個相同就變底線
      let preC = '';
      aLRC.forEach((c,i)=>{
        if(c===preC) aLRC[i] = '_';
        preC = c;
      });
       //本身: 加上索引數字+1，下個若是底線再加底線在自己
      aLRC.forEach((c,i)=>{
        let nextC = aLRC[i+1] || ''; //下個
        if(/^[LRC]$/.test(c)) {
          aLRC[i] = c + (i+1);
          if(nextC==='_') aLRC[i] += '_';
        }
      });
      //不要底線及空白
      for(let c of aLRC) {
        if(!(c == '_' || c == '')) classNames.push(c);
      }

      let srtClassNames = classNames.join(' ');
      $tableTag.addClass(srtClassNames);

      const cellPadding = op.sortable?1.5:1; //左右留白em數
      //欄寬 //左0.5+右1留白
      colWidth.forEach((w,i)=>{ if(w) $(`>thead th.sort[data-col-index=${i}]`,$tableTag).css('width',w+cellPadding+'em'); });
      minWidth.forEach((w,i)=>{ if(w) $(`>thead th.sort[data-col-index=${i}]`,$tableTag).css('minWidth',w+cellPadding+'em'); });
      maxWidth.forEach((w,i)=>{ if(w) $(`>thead th.sort[data-col-index=${i}]`,$tableTag).css('minWidth',w+cellPadding+'em'); });


      /////////
      function v(n) {
        let v = RegExp['$'+n];
        return isNaN(v)?v:parseInt(v,10);
      }


    }

    //產 <table> html (正常橫式表格)
    function makeTable(fields,data,summary) {

      let tbodyHtml = '';

      if(Array.isArray(data)) {
        tbodyHtml = data.map( tr => '<tr>'+tr.map(td=>`<td>${td?td.toString():''}</td>`).join('')+'</tr>').join('');
      }
      else if(typeof data === 'string') {
        tbodyHtml = data;
      }

      //fields 為字串(表頭html) 或 陣列(欄名)
      let head = (typeof fields === 'string')?`<thead>${fields}</thead>`:`<thead><tr>${fields.map(s=>`<th scope="col">${s.toString()}</th>`).join('')}</tr></thead>`;
      let body = '<tbody>'+tbodyHtml+'</tbody>';
      let foot = '<tfoot>'+summary.map( tr => '<tr>'+tr.map(td=>`<td>${td?td.toString():''}</td>`).join('')+'</tr>').join('')+'</tfoot>';
      return '<table>'+head+body+foot+'</table>';
    }

    //產 <table> html (直式表格: 標題，內容)
    function makeTableVertical(fields,data) {
      let bodys = data.map(row=>{
        let body = '';
        for(let i in fields) body += `<tr><th scope="row">${fields[i]}</th><td>${row[i]}</td></tr>`;
        return '<tbody>'+body+'</body>';
      });
      return '<table>'+bodys.join('')+'</table>';
    }

    //產 <table> html (連結按鈕)
    function makeTableLinkButton(fields,data) {

      let body = data.map(col=>`<a class="btn" href="${col[1]}" target="_blank" title="開啟新視窗，連結至：${col[0]}">${col[0]}</a>`).join('')

      return '<div class="section11 row btnsetblock">'+body+'</div>';

    }

    //在 th 直向最後一格類別加 sortable
    function makeSortableTH(op,$thead) {

      //無論跨欄在thead 加 data-col-index 欄索引值
      $thead.addColRowIndexData();

      let allTH = [... $('th',$thead)];
      let maxColIdx = Math.max(...allTH.map(th=>$(th).data('col-index'))); //最大欄索引

      //在 th 最底欄加 sort (留意可能有跨欄)
      for(let i=0;i<=maxColIdx;i++) {
        let aTH = allTH.filter(th=> $(th).data('col-index') == i );
        let lastTH = aTH[aTH.length-1];
        $(lastTH).addClass('sort');
      }


      if(op.sortable) {

        $thead.closest('.rwd-table').addClass('sortable');

        $('.sort',$thead).on('click',sortClick.bind(_));  //棄用 $.proxy(sortClick, _)


        //排序欄預設樣式
        if(typeof op.sortable === 'number') { //如果是數字就預設排那欄
          // 負值就是 desc
          $('.sort',$thead).eq(Math.abs(op.sortable)-1).addClass(op.sortable<0?'desc':'asc');
        }



      }

      ///////////////////
      //排序
      function sortClick(ev) {


        const $th = $(ev.target); //點擊的TH
        const colIdx = $th.data('col-index'); //要排序的欄索引
        const $thead = $th.closest('thead'); //所在 <thead>
        const $table = $thead.closest('table'); //所在 <table>
        const $wp = $table.closest('.table');
        const $mainContent = $('>.main-content',$wp);
        const $pagination = $('.pagination',$wp); //分頁器外層

        const sortMode    = $th.hasClass('asc')?'desc':'asc';  //即將要做的升降 密
        const tablesIndex = $wp.index(); //第幾個表格索引


        //改變上下箭頭狀態
        $('.sort',$thead).removeClass('asc desc');
        $th.addClass(sortMode);

        //轉轉轉
        $mainContent.addClass('load');


        if(opt.serverPaging) { //後端分頁
          //跳回第一頁 會觸發 renderTBody
          $pagination.pagination('selectPage',1);
        }
        else { //前端分頁
          
          let sortable = colIdx+1;  //第幾欄要排
          
          
          
          if(sortMode==='desc') sortable*=-1; //負值為desc

          
          const tableJson = _.#JsonTables[tablesIndex];

          _.#sortTableJsonArray(tableJson,sortable);
          
          
          

          //重秀表格內容
          if(!$pagination.is(':empty')) { //有分頁時
            //按排序跳回第一頁 會觸發 renderTBody
            $pagination.pagination('selectPage',1);
          }
          else {
            //全部重秀
            $('tbody',$table).html(tableJson.data.map( tr => '<tr>'+tr.map(td=>`<td>${td?td.toString():''}</td>`).join('')+'</tr>').join(''));
            _.#autoChangeColor(); //漲跌顏色
            opt.afterRender(_,tablesIndex,tableJson.data); //分頁/排序器產表完成後
            $mainContent.removeClass('load');
          }

        }




      }
      
      


    }

  }
  
  //對this物件已存之表格陣列排序
  #sortTableJsonArray(t,sortable) {
    // 同等變數 ref
    // 表格JSON物件: t = _.#JsonTables[索引]
    // 要排第幾欄: sortable =  _.#option.tables[索引].sortable、負值表示desc
    
    //true/false/0 不排
    if(typeof sortable !== 'number') return;
    if(sortable === 0) return;

    //排序資料
    const colsIsNum   = t.fieldsIsNum; //各欄位是否為數字
    const colsIsRoc   = t.fieldsIsROC; //各欄位是否為民國日
    const rows        = t.data; //完整的 tbody 資料
    
    const colIdx = Math.abs(sortable)-1;
    const sortMode = sortable<0?'desc':'asc';
    
        
    //console.log(colIdx,sortMode,colsIsNum[colIdx],colsIsRoc[colIdx]);
    
        

    let fnSortByColIdx; //排序規則函式

    if(colsIsNum[colIdx]){ //為數字
      fnSortByColIdx = (a,b)=>{
        const A = num2float(a[colIdx]);
        const B = num2float(b[colIdx]);
        
        return sortMode==='asc'?(A-B):(B-A);
      }
    }
    else if(colsIsRoc[colIdx]) { //為民國日期
      fnSortByColIdx = (a,b)=>{
        const A = roc2number(a[colIdx]);
        const B = roc2number(b[colIdx]);
        return sortMode==='asc'?(A-B):(B-A);
      }
    }
    else { //為文字
      fnSortByColIdx = (a,b)=>{
        const A = a[colIdx];
        const B = b[colIdx];
        return sortMode==='asc'?
          A.localeCompare(B,'zh-Hant-TW'):
          B.localeCompare(A,'zh-Hant-TW');
      }
    }

    rows.sort(fnSortByColIdx); //對資料排序
        
    ///////////////////////

    //民國字串轉 6~7 碼數字方便排序
    function roc2number (str) {
      if(!/^(\d+)\D(\d+)\D(\d+)$/.test(str)) return 0;
      return RegExp.$1 * 10000 + RegExp.$2 * 100 + RegExp.$3;
    }
    
    //任何數字轉成可排序之浮點數
    function num2float(str) {
      if(typeof str !== 'string') return str;
      str = str.replace(/[^\d\.\-]/g,'');
      if(str === '' || /^[\-]+$/.test(str)) return -Number.MAX_VALUE; // 數字欄位中出現 ---，回傳JS最小負數
      return parseFloat(str);
    }
  }


  //漲跌顏色 #reAutoColor
  #autoChangeColor(){
    const _ = this;

    _.#JsonTables.forEach((t,iTable)=>{

      const op = _.#option.tables[iTable];
      const $t = $('>.table',_.#$.content).eq(iTable);

      if(op.type !== 'horizontal') return; //正常橫式表格才需要變色

      if(!('data' in t)) return;
      if(!('fields' in t)) return;
      if(t.data === null || t.data.length===0) return; //空表格

      for(let iField in t.fields) {
        iField = parseInt(iField,10);
        let fieldName = t.fields[iField].strTrim();
        if(_.#reAutoColor.test(fieldName)) { //找出欄名有 "漲跌" 字樣
          $(`tr>td:nth-child(${iField+1})`,$t).each((iTD,td)=>{
            //在 td 上加 class = up或dn 漲跌顏色
            let txt = $(td).text().strTrim().replace(/,/g,'');
            let cls = /^-/.test(txt)?'dn':'up';
            if(txt === '' || isNaN(txt) || parseFloat(txt)==0) cls = ''; //0值不加色
            if(cls) $(td).addClass(cls)
          });
        }
      }
    });
  }

  //前端 取得顯示頁的陣列
  #pageViewOfArray(oTable,per,num) {
    //參數: (全表陣列,每頁筆數,頁碼)。

    const _ = this;

    let aData = oTable.data;
    if(typeof aData === 'string')  return { displayArray: aData, recordInfo: '' };


    let strRecInfo = _.#i18n.pageNumber; // %s - %s 筆，共 %s 筆
    let totalRec = oTable?.totalCount || aData?.length;  //全部筆數


    if(typeof totalRec === 'undefined') return { displayArray: [], recordInfo: '' };


    if(per==0) { //不分頁
      return { displayArray: aData, recordInfo: sprintf(strRecInfo,[1,totalRec,totalRec]) };
    }


    let startIdx = per*(num - 1);
    let endIdx   = startIdx + per;
    if(endIdx>(totalRec-1)) endIdx = totalRec;

    strRecInfo = sprintf(strRecInfo,[startIdx+1,endIdx,totalRec].map(v=>v.toLocaleString('en')));

    //回傳: 要顯示的陣列、「%s - %s 筆，共 %s 筆」

    return { displayArray: aData.slice(startIdx,endIdx), recordInfo: strRecInfo };

  }
  //後端 取得顯示頁的陣列 參數:(哪個表格,每頁筆數,頁碼,callback)。回傳: 要顯示的陣列、「%s - %s 筆，共 %s 筆」
  #pageViewOfServer(tableIndex,pageSize,pageNum,callback) {
    const _ = this; //bxRport

    let oData = Object.assign({},_.#formData); //克隆最近一次查詢
    oData['response'] = 'json';

    oData['paging-table'] = tableIndex;
    oData['paging-size'] = pageSize;
    oData['paging-offset'] = (pageNum-1)*pageSize;


    //#tables-content 找 第 tableIndex 個 .table 即 $wp
    const $wp = $(`.table:eq(${tableIndex})`,_.#$.content);
    const $thead = $('.rwd-table thead',$wp); //所在 <table> thead
    const $th = $('th.asc, th.desc',$thead); //要排序的th: 在 thead 中 找 th.asc 或 th.desc 只會找到1個或無

    if($th.length==0) { //沒有排序
      oData['paging-order'] = 0;
      oData['paging-dir'] = 'asc';
    }
    else {
      oData['paging-order'] = $th.data('col-index')+1; //要排序的欄
      oData['paging-dir'] = $th.hasClass('asc')?'asc':'desc';
    }

    let act = _.apiAction;
    if(/\.json$/.test(act) && ('paging-table' in oData) ) act = act.replace(/\.json$/,'1.json'); //測試用

    $.post(act,oData,(J)=>{

      if(J.stat !== 'ok') {
        alert('系統維護中');
        return;
      }

      const opt = _.#option;
      opt.beforeRender(J); //修飾JSON變數 by reference



      let totalRec = J.totalCount;
      let startIdx = pageSize*(pageNum - 1);
      let endIdx   = startIdx + pageSize;
      if(endIdx>(totalRec-1)) endIdx = totalRec;
      let strRecInfo = _.#i18n.pageNumber; // %s - %s 筆，共 %s 筆
      strRecInfo = sprintf(strRecInfo,[startIdx+1,endIdx,totalRec].map(v=>v.toLocaleString('en')));


      callback(J.data,strRecInfo);


    },'json');

  }



  //擷取要顯示的那頁資料, 因為會有後端分頁所以會有 callback
  #loadTablePageData(tableIndex,pageNum,pageSize,callback) {
    const _ = this; //bxRport
    const opt = _.#option;  //總選項

    //分頁方式
    if(opt.serverPaging) { //後端
      //參數:(哪個表格,每頁筆數,頁碼,callback)
      //callback 傳入 要顯示的表格陣列displayArray, 左下角文字recordInfo
      _.#pageViewOfServer(tableIndex,pageSize,pageNum,callback);
    }
    else { //前端
      // {要顯示的陣列, "%s - %s 筆，共 %s 筆"}
      let {displayArray,recordInfo} =  _.#pageViewOfArray(_.#JsonTables[tableIndex],pageSize,pageNum); //參數:(全表陣列,每頁筆數,頁碼)
      callback(displayArray,recordInfo);
    }

  }



  //分頁器: 翻頁(分頁器,頁碼,事件)
  #changePage($pagination,pageNum,ev) {

    const _ = this; //bxRport
    const $wp = $pagination.closest('.table');
    const tableIndex = $wp.index();
    const $tableTag = $('table',$wp);
    const $mainContent = $('>.main-content',$wp);

    const opt = _.#option;  //總選項
    const op = opt.tables[tableIndex]; //此表選項
    let pageSize = parseInt( Array.isArray(op.pagin)? $('.bottom-hints select',$wp).val(): op.pagin,10);


    //跳到表格開頭 (當表格捲到可視區外才要跳)
    const hH = _.elStickyTitle.clientHeight; //頁眉高度
    const ssH = $('.main-content',$wp)[0].style.getPropertyValue('--ssH').replace('px',''); //影子卷軸高
    const docY = document.documentElement.scrollTop;
    const tY = parseInt($tableTag[0].getBoundingClientRect().top+docY); //表格位置
    const toY = tY-hH-ssH;
    if(docY>tY) window.scroll(0,toY);



    $mainContent.addClass('load');


    //擷取要顯示的那頁資料, 因為會有後端分頁所以會有 callback
    _.#loadTablePageData(tableIndex,pageNum,pageSize,(displayArray, recordInfo)=>{

      //左下文字
      if(recordInfo !== null) $('.bottom-hints>div:first-child',$wp).text(recordInfo);

      //tbody內容
      $('tbody',$wp).html(displayArray.map( tr => '<tr>'+tr.map(td=>`<td>${td?td.toString():''}</td>`).join('')+'</tr>').join(''));


      _.#autoChangeColor(); //漲跌顏色
      opt.afterRender(_,tableIndex,displayArray); //分頁器產表完成後

      $mainContent.removeClass('load');

    });


    return false;
  }



  //垂直方向依資料相同做跨欄，(tbody,依據欄,[要合並哪些欄])
  rowSpan(indexTable, iCol, aCols) {
    const _ = this;
    const $tbody = $('.table',_.#$.content).eq(indexTable).find('tbody');

    if($tbody.length !== 1) return;

    const $trs  = $('tr',$tbody);
    if($trs.length===0) return;

    let preSN = null; //依據值
    let $spanTDs; //開始直向跨欄的格子
    let rowSpan; //跨幾欄

    $trs.each((idxTR,tr)=>{
      const $tds = $('td',tr);
      const sn = $tds.eq(iCol).text();
      if(sn == preSN) {
        $tds.filter(isSpanCol).addClass('hide');
        rowSpan++;
      }
      else {
        if(preSN !== null){
          $spanTDs.filter(isSpanCol).attr('rowspan',rowSpan);
        }
        rowSpan = 1;
        $spanTDs = $('td',tr);
      }
      preSN = sn;
    });
    $spanTDs.filter(isSpanCol).attr('rowspan',rowSpan);


    function isSpanCol(i,td) { return aCols.includes(i); }

  }

  //列印
  doPrintTable($button) {
    const _ = this;
    
    
    let newTab = window.open('','_blank');
    
    
    if (typeof newTab !== 'object') {
      alert("無法開啟新的分頁，請檢查瀏覽器設定。");
      return;
    }
    
    const base = location.origin;
    const doc = newTab.document;
    

    doc.documentElement.lang = document.documentElement.lang;
    doc.title = document.title ;
    
   
    const JsonDate = _.#JsonDate; // 查詢日期
    const JsonTables = _.#JsonTables; // 表格資料
    
        
    //<link href="/rsrc/css/tables.css" rel="stylesheet">
    
   

    $(doc.head).append(`
      <script src="${base + $('script[src*="jquery-3"]').safeAttr('src')}"></script>
      <link href="${base + $('link[href*="tables.css"]').safeAttr('href').replace('tables','print')}" rel="stylesheet">
    `);
 
    
    //頁面最大標題 如果 JSON 有date 回傳則 +資料時間
    let titleH1 = $('section.title>div:first-child').safeText(); 
    if(JsonDate.length) titleH1 += ('\t'+ _.#i18n.date + JsonDate.map(d=>d.format(_.#day.YMD)).join(' ~ ')); //資料日期：
    
    
    
    let body = `<div id="paper"><h1>${titleH1}</h1>`;
    
    //要移除的欄名
    let removes = $button.data('hide')?.toString().split(/,/) || [];
    
    
    _.#JsonTables.forEach((J,i)=>{
      const $t= $('>.table',_.#$.content).eq(i);      //每個 .table
      const $topHints = $('.top-hints>div',$t);       //表上方左右兩個DIV
      const $bottomHints = $('.bottom-hints>div',$t); //表下方左右兩個DIV

      //表格標題
      let title2 = $('h2',$t).text();
      let title3 = $('h3',$t).text();
      if(title3) title2 += ` (${title3})`;
      
      //表格四角落文字
      const hints = [...$('.top-hints>div',$t),...$('.bottom-hints>div',$t)].map(el=>el.innerText);
      hints[2] = hints[2].replace(/^.+筆，/,'').replace(/^\d+-\d+ of /,'');
      hints[3] = hints[3].replace(/^每頁.+/s,'').replace(/^\d records per page/,'');
      
      //說明
      let noteHtml = $('.noteblock',$t)[0].outerHTML;
      let tableClass = $('table',$t).attr('class');
      
      let fields = [...J.fields]; //克隆欄名
      let removeCols = []; //即將移掉的欄位索引
      fields.forEach((v,i)=>{
        for(let rm of removes) if(v==rm) removeCols.unshift(i);
      }); //倒序存入
      for(let rm of removes) {
         if(/^\d+$/.test(rm)) removeCols.unshift(parseInt(rm,10)-1); //第幾欄
      }

      //移除欄名
      for(let idx of removeCols) { fields.splice(idx,1); }
      fields = fields.map(s=>`<th scope="col">${s.toString()}</th>`).join('');
      let thead  = _.#tmpTableHead[i] || `<tr>${fields}</tr>`;
      
      
      //資料
      let tbody = J.data.map(tr=>{
        for(let idx of removeCols) { tr.splice(idx,1); }
        return '<tr>'+tr.map(td=>`<td>${td?td.toString():''}</td>`).join('')+'</tr>';
      }).join('');
      
      //總計
      let tfoot = J.summary.map( tr => {
        for(let idx of removeCols) { tr.splice(idx,1); }
        return '<tr>'+tr.map(td=>`<td>${td?td.toString():''}</td>`).join('')+'</tr>';
      }).join('');

      body += `
        <h2>${title2}</h2>
        <div class="top-hints"><div>${hints[0]}</div><div>${hints[1]}</div></div>
        <table class="${tableClass}"><thead>${thead}</thead><tbody>${tbody}</tbody><tfoot>${tfoot}</tfoot></table>
        <div class="bottom-hints"><div>${hints[2]}</div><div>${hints[3]}</div></div>
        <br><br>
        ${noteHtml}
        <br><br>
      `;


    });
    
    
    const outerNote = $('#tables-notes');
    if(outerNote.length > 0) body += outerNote[0].outerHTML;
    

    body += '</div>';
    
    body += `<script src="${base + $('script[src*="tables.js"]').safeAttr('src').replace('tables','print')}"></script>`;
    
   
    $(doc.body).append(body);

    
  }


}



//內頁套版功能
class bxTemplate {


  //在 constructor() 定值
  #lan; // zh jp en
  $content;


  //在 init() 定值
  #option;
  apiAction = ''; //API路徑: 報表
  JsonData = {};

  constructor() {
    this.#lan = /^zh/i.test(docLang)?'zh':(/jp/i.test(document.documentElement.lang)?'jp':'en');
    this.$content = $('#templates-content');
  }


  //要在 #tables-content 先加
  init(cfg) {



    const _ = this;

    if(_.$content.length===0) console.error('頁面中需要 #templates-content 元素');

    //_.$content.addClass('load');

    const defaultOption = {
      pattern: '/{LANG}/{ACTION}',    //API路徑
      action: '',                     //報表API (必要) 會套入上面 PATTERN
      beforeInit: ()=>{},
      beforeRender: ()=>{},
      afterRender: ()=>{}
    }

    _.#option = Object.assign({},defaultOption,cfg);
    const opt = _.#option;

    //實際API完整路徑
    const langDir = { 'zh': 'zh-tw', 'en': 'en-us', 'jp': 'ja-jp' }
    _.apiAction   = opt.action?opt.pattern.replace(/\{LANG\}/,langDir[_.#lan]).replace(/\{ACTION\}/,opt.action):'';


    //參數轉物件
    const params = Object.fromEntries(new URLSearchParams(window.location.search));

    // 只有1個參數且不是 key=value 時，把它變成 id
    // 避免分享連結被FB等加上 fbclid 等追蹤參數時 (?23020&fbclid=xxx)，id須正確解析
    const bareKey = Object.keys(params).find(key => params[key] === '');
    if(bareKey !== undefined) {
      params['id'] = bareKey;
      delete params[bareKey];
    }


    opt.beforeInit(params);

    
    $.post(_.apiAction,params,(J)=>{
      
      opt.beforeRender(J);

      if(J.stat!=='ok') {
        $('#tables-message').text(J.stat);
        _.$content.removeClass('hide load');
        return;
      }
      
      
      
      

      _.JsonData = J.data; //資料存入公用區


      //HTML
      $('[data-name]',_.$content).each((idx,span)=>{
        const $span = $(span);
        const key = $span.data('name');
        if(key in J.data) $span.safeHtml(J.data[key]);
      });

      opt.afterRender(_);
      _.$content.removeClass('load');
    });








  }



}



//彈跳視窗
class bxPopupWindow {
  $po;
  constructor() {}

  init() {
    const _ = this;
    _.$po = $('<div class="popup-overlay"><div class="win"><button class="close" title="關閉"></button><div class="content"></div></div></div>').appendTo('body');



    _.$po.on('click',(ev)=>{
      const $el = $(ev.target);
      if($el.hasClass('close') || $el.hasClass('popup-overlay')) _.$po.addClass('close');
    });



    _.$po.on('animationend webkitAnimationEnd oAnimationEnd MSAnimationEnd',(ev)=>{
      if(_.$po.is('.active.close')){
        _.$po.removeClass('active'); //關閉動畫完成
        setTimeout(()=>{_.$po.removeClass('close');},300);
      }
    });

  }
  
  //加入視窗 className
  setClass(className) {
    this.$po.find('.win').addClass(className);
  }

  //關閉彈窗
  close() {
    this.$po.addClass('close');
  }

  open(htm) {
    if(typeof htm === 'string') $('>.win>.content',this.$po).safeHtml(htm);
    this.$po.addClass('active');
  }

}

/////////////////////////////////////////////////////////////////


let tables = new bxRport();
let templates = new bxTemplate();
let popupWindow = new bxPopupWindow();
